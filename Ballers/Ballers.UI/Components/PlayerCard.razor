@inject HttpClient Http
<div class="fut-player-card @Position?.ToLower() card-@CardTier @(HasAttributes ? "has-attributes" : "")">
    <div class="player-card-top">
        <div class="player-master-info">
            @* A player with a card shows their overall rating here, the way a FIFA
               card does. Without one there is no rating to show, so the shirt
               number keeps the spot it has always had. *@
            <div class="player-rating"><span>@(HasAttributes ? Attributes!.Overall : Number)</span></div>
            <div class="player-position"><span>@Position</span></div>
        </div>
        <div class="player-picture">
            @if (!string.IsNullOrEmpty(ImageUrl))
            {
                @* A link to the API's photo, or a data URL just cropped on this page. *@
                <img src="@MediaUrls.Absolute(Http, ImageUrl)" alt="@Name" draggable="false" loading="lazy" />
            }
            else
            {
                <svg class="player-silhouette" viewBox="0 0 60 90" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                    <circle cx="30" cy="14" r="12" />
                    <path d="M10 36 L3 55 L15 59 L18 46 L18 78 L42 78 L42 46 L45 59 L57 55 L50 36 C46 31 38 27 30 27 C22 27 14 31 10 36Z" />
                </svg>
            }
        </div>
    </div>
    <div class="player-card-bottom">
        <div class="player-info">
            <div class="player-name">
                <span>
                    @if (HasAttributes)
                    {
                        @* The number is displaced from the rating slot, so it rides
                           alongside the name instead of disappearing. *@
                        <span class="player-shirt">@Number</span>
                    }
                    @Name
                </span>
            </div>
            @if (HasAttributes)
            {
                <div class="player-attributes">
                    @foreach (var (value, label) in AttributeCells)
                    {
                        <div class="player-attribute">
                            <span class="player-attribute-value">@value</span>
                            <span class="player-attribute-label">@label</span>
                        </div>
                    }
                </div>
            }
            else if (Goals.HasValue || Assists.HasValue || Motm.HasValue)
            {
                <div class="player-features">
                    <div class="player-features-col">
                        <span>
                            <div class="player-feature-value">@(Goals ?? 0)</div>
                            <div class="player-feature-title">GOL</div>
                        </span>
                    </div>
                    <div class="player-features-col">
                        <span>
                            <div class="player-feature-value">@(Assists ?? 0)</div>
                            <div class="player-feature-title">AST</div>
                        </span>
                    </div>
                    <div class="player-features-col">
                        <span>
                            <div class="player-feature-value">@(Motm ?? 0)</div>
                            <div class="player-feature-title">MOTM</div>
                        </span>
                    </div>
                    @if (EarnsCleanSheets)
                    {
                        <div class="player-features-col">
                            <span>
                                <div class="player-feature-value">@(CleanSheets ?? 0)</div>
                                <div class="player-feature-title">CS</div>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    @if (OnRemove.HasDelegate)
    {
        <button type="button" class="card-remove-btn" @onclick="OnRemove" title="Remove player">✕</button>
    }
    @if (OnEditPhoto.HasDelegate)
    {
        <button type="button" class="card-edit-photo-btn" @onclick="OnEditPhoto" title="Edit photo">📷</button>
    }
    @if (OnEdit.HasDelegate)
    {
        <button type="button" class="card-edit-btn" @onclick="OnEdit" title="Edit player">✏️</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public int Number { get; set; }
    [Parameter, EditorRequired] public string Position { get; set; } = "";
    [Parameter] public int? Goals { get; set; }
    [Parameter] public int? Assists { get; set; }
    [Parameter] public int? Motm { get; set; }
    /// <summary>Only meaningful for goalkeepers and defenders; ignored for other positions.</summary>
    [Parameter] public int? CleanSheets { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnEditPhoto { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    /// <summary>When set ("gold"/"silver"/"bronze"), overrides the stat-derived tier (used by manager cards).</summary>
    [Parameter] public string? TierOverride { get; set; }

    /// <summary>
    /// The player's six card attributes. Null for a player with no login yet, which
    /// leaves the card rendering exactly as it did before cards had ratings.
    /// </summary>
    [Parameter] public PlayerAttributesDto? Attributes { get; set; }

    /// <summary>
    /// Tier worked out from the overall rating against the league's thresholds.
    /// Only meaningful alongside <see cref="Attributes"/>.
    /// </summary>
    [Parameter] public string? Tier { get; set; }

    private bool HasAttributes => Attributes != null;

    // Laid out down the left column then down the right, so the pairs read
    // FIN/DRI, TAC/PAC, PAS/STR across the card.
    private IEnumerable<(int Value, string Label)> AttributeCells
    {
        get
        {
            var a = Attributes!;
            yield return (a.Finishing, "FIN");
            yield return (a.Dribbling, "DRI");
            yield return (a.Tackling, "TAC");
            yield return (a.Pace, "PAC");
            yield return (a.Passing, "PAS");
            yield return (a.Strength, "STR");
        }
    }

    // Goals and assists are a poor measure of a goalkeeper or defender, so those
    // two positions can also earn their tier through clean sheets.
    private bool EarnsCleanSheets =>
        string.Equals(Position, "GK", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Position, "DEF", StringComparison.OrdinalIgnoreCase);

    // A card with a rating takes its tier from that rating. Everyone else falls
    // back to the goals-and-assists logic below, so squads of players who have not
    // signed up look no different than they did.
    private string CardTier => TierOverride ?? Tier ?? BestTier();

    // Whichever of the two routes to a tier is better — a defender who scores and
    // assists still gets gold without the clean sheets, and vice versa.
    private string BestTier()
    {
        var attacking = AttackingTier();
        if (!EarnsCleanSheets) return attacking;

        var defensive = DefensiveTier();
        return TierRank(defensive) > TierRank(attacking) ? defensive : attacking;
    }

    private string AttackingTier() =>
        (Goals ?? 0) >= 1 && (Assists ?? 0) >= 1 ? "gold" :
        (Goals ?? 0) >= 1 || (Assists ?? 0) >= 1 ? "silver" :
        "bronze";

    private string DefensiveTier() =>
        (CleanSheets ?? 0) >= 5 ? "gold" :
        (CleanSheets ?? 0) >= 3 ? "silver" :
        "bronze";

    private static int TierRank(string tier) => tier switch
    {
        "gold" => 2,
        "silver" => 1,
        _ => 0
    };
}
