@using Ballers.Models

<div class="ts-poster">
    <div class="ts-grain"></div>
    <div class="ts-halftone"></div>
    <div class="ts-slash"></div>
    <span class="ts-watermark">@(Fixture.IsKnockout ? "CUP TIE" : "MATCHDAY")</span>

    <!-- taped corners -->
    <span class="ts-tape ts-tape-tl"></span>
    <span class="ts-tape ts-tape-tr"></span>
    <span class="ts-tape ts-tape-bl"></span>
    <span class="ts-tape ts-tape-br"></span>

    <!-- Masthead -->
    <header class="ts-head">
        <img class="ts-logo" src="/images/BBL-Logo.png" alt="Ballers League" />
        <span class="ts-head-text">Blackpool Ballers League</span>
    </header>
    <div class="ts-occasion">@(Fixture.IsKnockout ? Fixture.KnockoutRound : $"Match Week {Fixture.Week}")</div>

    <!-- Fixture -->
    <div class="ts-fixture">
        <div class="ts-side">
            <div class="ts-badge">
                @if (!string.IsNullOrEmpty(HomeBadge))
                {
                    <img src="@HomeBadge" alt="@Fixture.HomeTeam" />
                }
                else
                {
                    <span class="ts-badge-fallback">@Initials(Fixture.HomeTeam)</span>
                }
            </div>
            <h2 class="ts-club">@Fixture.HomeTeam</h2>
        </div>

        <div class="ts-vs"><span>V</span><span>S</span></div>

        <div class="ts-side">
            <div class="ts-badge">
                @if (!string.IsNullOrEmpty(AwayBadge))
                {
                    <img src="@AwayBadge" alt="@Fixture.AwayTeam" />
                }
                else
                {
                    <span class="ts-badge-fallback">@Initials(Fixture.AwayTeam)</span>
                }
            </div>
            <h2 class="ts-club">@Fixture.AwayTeam</h2>
        </div>
    </div>

    <!-- Ticket band -->
    <div class="ts-band">
        <div class="ts-band-cell">
            <span class="ts-band-label">Venue</span>
            <span class="ts-band-value">@(string.IsNullOrEmpty(Fixture.Location) ? "TBD" : Fixture.Location)</span>
            @if (!string.IsNullOrEmpty(Fixture.Postcode))
            {
                <span class="ts-band-sub">@Fixture.Postcode</span>
            }
        </div>
        <div class="ts-band-cell">
            <span class="ts-band-label">Kickoff</span>
            <span class="ts-band-value">@(Fixture.Kickoff?.ToString("HH:mm") ?? "TBD")</span>
            <span class="ts-band-sub">@(Fixture.Kickoff?.ToString("ddd d MMM").ToUpper() ?? "DATE TBD")</span>
        </div>
    </div>

    <!-- Team sheet -->
    <section class="ts-sheet">
        <div class="ts-sheet-title">
            <span class="ts-sheet-kicker">Team Sheet</span>
            <span class="ts-sheet-club">@SheetTeamName</span>
        </div>

        @if (!Squad.Any())
        {
            <p class="ts-empty">No players registered.</p>
        }
        else
        {
            <ul class="ts-players">
                @foreach (var p in Squad)
                {
                    <li class="ts-player">
                        <span class="ts-num">@p.Number</span>
                        <span class="ts-name">@p.Name</span>
                    </li>
                }
            </ul>
        }
    </section>

    <!-- Sponsor stamp -->
    <footer class="ts-sponsor">
        <span class="ts-sponsor-kicker">backed by</span>
        <div class="ts-sponsor-row">
            <img class="ts-sponsor-logo" src="/images/RimmingtonRoofing.png" alt="Rimmington Roofing" />
            <span class="ts-sponsor-name">Rimmington Roofing</span>
        </div>
    </footer>
</div>

@code {
    [Parameter] public FixtureDetailsDto Fixture { get; set; } = default!;
    [Parameter] public string? HomeBadge { get; set; }
    [Parameter] public string? AwayBadge { get; set; }
    [Parameter] public string SheetTeamName { get; set; } = "";
    [Parameter] public List<PlayerCardDto> Squad { get; set; } = new();

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpper()
            : (parts[0][0].ToString() + parts[^1][0]).ToUpper();
    }
}
