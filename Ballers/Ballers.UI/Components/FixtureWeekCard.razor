@using Ballers.Models
@inject HttpClient Http

<div class="week-card">

    <div class="week-header">
        <span class="week-badge">Week @Week.WeekNumber</span>
        <span class="date-range">@Week.DateRange</span>
    </div>

    <div class="fixtures-grid">
        @foreach (var match in Week.Matches)
        {
            <div class="fixture-card @(match.IsPlayed ? "played" : "")">

                <div class="matchup">
                    <div class="team-side home-team">
                        @TeamCrest(match.HomeLogo, match.Home)
                        <span class="team-name @(match.IsPlayed && match.HomeScore > match.AwayScore ? "winner" : "")">@match.Home</span>
                    </div>
                    @if (match.IsPlayed)
                    {
                        <div class="score-ring">@match.HomeScore – @match.AwayScore</div>
                    }
                    else
                    {
                        <div class="vs-ring">VS</div>
                    }
                    <div class="team-side away-team">
                        @TeamCrest(match.AwayLogo, match.Away)
                        <span class="team-name @(match.IsPlayed && match.AwayScore > match.HomeScore ? "winner" : "")">@match.Away</span>
                    </div>
                </div>

                @if (match.IsPlayed && (match.HomeScorers.Any() || match.AwayScorers.Any()))
                {
                    <div class="scorers">
                        <div class="scorers-col home-scorers">
                            @foreach (var s in match.HomeScorers)
                            {
                                <span class="scorer">⚽ @s.Name@(s.Goals > 1 ? $" ×{s.Goals}" : "")</span>
                            }
                        </div>
                        <div></div>
                        <div class="scorers-col away-scorers">
                            @foreach (var s in match.AwayScorers)
                            {
                                <span class="scorer">⚽ @s.Name@(s.Goals > 1 ? $" ×{s.Goals}" : "")</span>
                            }
                        </div>
                    </div>
                }

                <div class="fixture-meta">
                    @if (!string.IsNullOrEmpty(match.Day) || !string.IsNullOrEmpty(match.Time))
                    {
                        <span class="meta-item meta-date">
                            <span class="meta-icon">🕐</span>
                            <span>@(string.IsNullOrEmpty(match.Day) ? "TBD" : match.Day)@(string.IsNullOrEmpty(match.Time) ? "" : $" · {match.Time}")</span>
                        </span>
                    }
                    else
                    {
                        <span class="meta-item tbd">Date &amp; time TBD</span>
                    }
                    @if (!string.IsNullOrEmpty(match.Location) || !string.IsNullOrEmpty(match.Postcode))
                    {
                        <a class="meta-item meta-link"
                           href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(string.IsNullOrEmpty(match.Postcode) ? match.Location : string.IsNullOrEmpty(match.Location) ? match.Postcode : $"{match.Location} {match.Postcode}")"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="Open in Google Maps">
                            📍
                            <span class="meta-place">
                                @if (!string.IsNullOrEmpty(match.Location))
                                {
                                    <span class="meta-venue">@match.Location</span>
                                }
                                @if (!string.IsNullOrEmpty(match.Postcode))
                                {
                                    <span class="meta-postcode">@match.Postcode</span>
                                }
                            </span>
                        </a>
                    }

                    @if (GalleryIdFor(match.Id) is { } galleryId)
                    {
                        <a class="meta-item meta-gallery" href="/gallery/@galleryId" title="View match photos">
                            📷 <span>Photos</span>
                        </a>
                    }
                </div>

            </div>
        }
    </div>

    @if (Week.Byes.Any())
    {
        <div class="bye-strip">
            <span class="bye-label">BYE</span>
            @foreach (var team in Week.Byes)
            {
                <span class="bye-team">@team</span>
            }
        </div>
    }

</div>

@code {
    [Parameter]
    public FixtureWeekDto Week { get; set; } = new();

    /// <summary>
    /// Fixture id to gallery id, for the fixtures that have photos. Passed in
    /// rather than looked up per card so the schedule makes one call for the
    /// whole season instead of one per match.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<int, int>? GalleriesByFixture { get; set; }

    private int? GalleryIdFor(int fixtureId)
        => GalleriesByFixture is not null && GalleriesByFixture.TryGetValue(fixtureId, out var id)
            ? id
            : null;

    RenderFragment TeamCrest(string? logo, string name) => __builder =>
    {
        if (!string.IsNullOrEmpty(logo))
        {
            <img class="team-crest" src="@(Http.BaseAddress!.ToString().TrimEnd('/') + logo)" alt="@name crest" />
        }
        else
        {
            <div class="team-crest team-crest-placeholder"><span>@Initials(name)</span></div>
        }
    };

    static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }
}
