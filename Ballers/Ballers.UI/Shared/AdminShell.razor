@* The frame round every admin page: a sidebar of sections (a strip of tabs on
   a phone) and the page's title. Styles are in wwwroot/css/admin.css.

   Section is the key of the page's own sidebar entry, so it shows as current.
   Links marked Out leave the admin area for a page that managers or the
   public also use. *@
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject IWebAssemblyHostEnvironment HostEnv
@inject IConfiguration Config
<div class="adm-shell">
    <aside class="adm-side" aria-label="Admin sections">
        <span class="adm-side-brand">League admin</span>
        @foreach (var group in Groups)
        {
            <div class="adm-side-group">
                <span class="adm-side-label">@group.Label</span>
                @foreach (var item in group.Items)
                {
                    <a href="@item.Href" class="@(item.Key == Section ? "is-active" : "")"
                       aria-current="@(item.Key == Section ? "page" : null)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@item.Icon" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        @item.Label
                        @if (item.Out)
                        {
                            <span class="adm-side-out" title="Opens the shared page">↗</span>
                        }
                    </a>
                }
            </div>
        }
    </aside>

    <nav class="adm-tabs" aria-label="Admin sections">
        @foreach (var item in Groups.SelectMany(g => g.Items))
        {
            <a href="@item.Href" class="@(item.Key == Section ? "is-active" : "")"
               aria-current="@(item.Key == Section ? "page" : null)">@item.Label</a>
        }
    </nav>

    <main class="adm-main">
        <header class="adm-head">
            <div>
                <h1>@Title</h1>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p>@Subtitle</p>
                }
            </div>
            @if (Actions != null)
            {
                <div class="adm-head-actions">@Actions</div>
            }
        </header>

        @ChildContent
    </main>
</div>

@code {
    [Parameter, EditorRequired] public string Section { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private record Item(string Key, string Label, string Href, string Icon, bool Out = false);
    private record Group(string Label, Item[] Items);

    // Icon paths are 24×24 line drawings.
    private Group[] Groups => ShowDebug ? AllGroups.Append(DebugGroup).ToArray() : AllGroups;

    // The data seeding tools: never on live, where the API refuses them too.
    private bool ShowDebug => HostEnv.IsDevelopment() || Config.GetValue<bool>("IsUAT");

