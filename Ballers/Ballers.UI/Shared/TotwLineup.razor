@using Ballers.Shared

@if (Totw == null)
{
    <div class="totw-empty">No Team of the Week yet.</div>
}
else
{
    <div class="totw-lineup">
        @if (players.Count > 0)
        {
            <div class="totw-row totw-row-outfield">
                @foreach (var p in players)
                {
                    <TotwCard Player="p" />
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public TeamOfTheWeekDto? Totw { get; set; }

    private List<TotwPlayerDto> players = new();

    protected override void OnParametersSet()
    {
        players = Totw?.Players ?? new();
    }
}
