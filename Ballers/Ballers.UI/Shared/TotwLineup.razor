@using Ballers.Shared

@if (Totw == null)
{
    <div class="totw-empty">No Team of the Week yet.</div>
}
else
{
    <div class="totw-lineup">
        @if (gk != null)
        {
            <div class="totw-row totw-row-gk">
                <TotwCard Player="gk" />
            </div>
        }

        @if (outfield.Count > 0)
        {
            <div class="totw-row totw-row-outfield">
                @foreach (var p in outfield)
                {
                    <TotwCard Player="p" />
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public TeamOfTheWeekDto? Totw { get; set; }

    private TotwPlayerDto? gk;
    private List<TotwPlayerDto> outfield = new();

    protected override void OnParametersSet()
    {
        gk = Totw?.Players.FirstOrDefault(p => p.IsGoalkeeper);
        outfield = Totw?.Players.Where(p => !p.IsGoalkeeper).ToList() ?? new();
    }
}
