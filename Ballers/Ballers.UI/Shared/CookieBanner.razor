@using Ballers.Services
@implements IDisposable
@inject AnalyticsService Analytics

@if (visible)
{
    <div class="cookie-banner" role="region" aria-label="Cookie choices">
        <div class="cookie-banner-inner">
            <p class="cookie-text">
                We use a strictly-necessary cookie to keep you signed in. We'd also like to set
                Google Analytics cookies to understand how the site is used — these are only set
                if you accept. See our <a href="/privacy">privacy notice</a>.
            </p>
            <div class="cookie-actions">
                <button class="cookie-btn cookie-reject" @onclick="Reject">Reject</button>
                <button class="cookie-btn cookie-accept" @onclick="Accept">Accept</button>
            </div>
        </div>
    </div>
}

@code {
    private bool visible = false;

    protected override void OnInitialized()
    {
        Analytics.BannerRequested += Reopen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Analytics.InitialiseAsync();

        visible = !Analytics.HasChoice;
        StateHasChanged();
    }

    private async Task Accept() => await Choose(true);

    private async Task Reject() => await Choose(false);

    private async Task Choose(bool granted)
    {
        await Analytics.SetConsentAsync(granted);
        visible = false;
    }

    private void Reopen()
    {
        visible = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Analytics.BannerRequested -= Reopen;
    }
}
