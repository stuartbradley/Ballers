@using Ballers.Auth
@using Ballers.Client.Auth
@using Ballers.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using Ballers.Services
@inject IWebAssemblyHostEnvironment HostEnv
@inject SeasonService SeasonSvc
@inject IConfiguration Config

@inherits LayoutComponentBase

<header class="main-header">
    <div class="header-inner">

        <div class="logo-area">
            <div class="logo"><img src="/images/BBL-Logo.png" alt="BBL Logo" class="logo-img" /></div>
            <AuthorizeView Context="auth">
                <Authorized>
                    <span class="hello-text">Hello @teamName</span>
                </Authorized>
            </AuthorizeView>
        </div>

        <!-- Desktop nav -->
        <nav class="nav-links">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/fixtures">Fixtures</NavLink>
            @if (knockoutGenerated)
            {
                <NavLink href="/knockout">Knockout</NavLink>
            }
            <NavLink href="/teams">Teams</NavLink>
            <NavLink href="/stats">Stats</NavLink>
            <NavLink href="/totw">TOTW</NavLink>
            <NavLink href="/motd">MOTD</NavLink>
            <NavLink href="/galleries">Galleries</NavLink>
            <NavLink href="/sponsor-us">Sponsor Us</NavLink>
            @if (HostEnv.IsDevelopment() || Config.GetValue<bool>("IsUAT"))
            {
                <NavLink href="/debug" class="debug-nav-link">Debug</NavLink>
            }
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/dashboard">Dashboard</NavLink>
                    <NavLink href="/guide">Guide</NavLink>
                    <NotificationBell />
                    <a class="logout-link" @onclick="Logout" @onclick:preventDefault>Logout</a>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/login">Login</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>

        <!-- Hamburger (mobile only) -->
        <button class="hamburger @(navOpen ? "open" : "")"
                @onclick="ToggleNav"
                aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>
</header>

<!-- Mobile right-slide drawer -->
<div class="nav-backdrop @(navOpen ? "is-visible" : "")" @onclick="CloseNav"></div>
<div class="mobile-overlay @(navOpen ? "is-open" : "")">
    <div class="mobile-panel-header">
        <span class="mobile-panel-logo">Ballers</span>
        <button class="mobile-panel-close" @onclick="CloseNav" aria-label="Close menu">&#x2715;</button>
    </div>
    <AuthorizeView>
        <Authorized>
            <p class="mobile-greeting">Hello, @teamName</p>
        </Authorized>
    </AuthorizeView>

    <nav class="mobile-nav">
        <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseNav">Home</NavLink>
        <NavLink href="/fixtures" @onclick="CloseNav">Fixtures</NavLink>
        @if (knockoutGenerated)
        {
            <NavLink href="/knockout" @onclick="CloseNav">Knockout</NavLink>
        }
        <NavLink href="/teams" @onclick="CloseNav">Teams</NavLink>
        <NavLink href="/stats" @onclick="CloseNav">Stats</NavLink>
        <NavLink href="/totw" @onclick="CloseNav">TOTW</NavLink>
        <NavLink href="/motd" @onclick="CloseNav">MOTD</NavLink>
        <NavLink href="/galleries" @onclick="CloseNav">Galleries</NavLink>
        <NavLink href="/sponsor-us" @onclick="CloseNav">Sponsor Us</NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink href="/dashboard" @onclick="CloseNav">Dashboard</NavLink>
                <NavLink href="/guide" @onclick="CloseNav">Guide</NavLink>
                <NavLink href="/change-password" @onclick="CloseNav">Change Password</NavLink>
                <button class="mobile-logout-btn" @onclick="Logout">Logout</button>
            </Authorized>
            <NotAuthorized>
                <NavLink href="/login" @onclick="CloseNav">Login</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<div class="main-content">
    @Body
</div>

<SiteFooter />
<CookieBanner />

@inject AuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@code {

    private string? teamName;
    private bool navOpen = false;
    private bool knockoutGenerated = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
            teamName = user.FindFirst("TeamName")?.Value
                       ?? (user.IsInRole("Admin") ? "Admin"
                           : user.IsInRole("Referee") ? "Referee"
                           : user.Identity?.Name);

        var season = await SeasonSvc.GetCurrentSeason();
        knockoutGenerated = season?.IsKnockoutGenerated ?? false;

        StateHasChanged();
    }

    private void ToggleNav() => navOpen = !navOpen;
    private void CloseNav() => navOpen = false;

    async Task Logout()
    {
        await Auth.Logout();
        ((AuthStateProvider)AuthProvider).NotifyUserLogout();
        navOpen = false;
        Nav.NavigateTo("/");
        StateHasChanged();
    }
}
