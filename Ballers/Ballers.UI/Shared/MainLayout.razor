@using Ballers.Auth
@using Ballers.Client.Auth
@using Ballers.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using Ballers.Services
@inject IWebAssemblyHostEnvironment HostEnv
@inject SeasonService SeasonSvc
@inject IConfiguration Config

@inherits LayoutComponentBase

@* Dark over the pages that are dark from top to bottom (home, My Card,
   Fixtures, Teams, each team's page, Stats, Team of the Week, the
   galleries, the admin pages and the manager's pages);
   white everywhere else. The layout re-renders on every navigation, so this
   follows the route. *@
<header class="main-header @(IsDarkPage ? "header-dark" : "")">
    <div class="header-inner">

        <div class="logo-area">
            <div class="logo"><img src="/images/BBL-Logo.png" alt="BBL Logo" class="logo-img" /></div>
            <AuthorizeView Context="auth">
                <Authorized>
                    @* A player's nav fills the header, leaving the greeting only
                       enough room to render as "Hello …". Their name is in the
                       mobile drawer instead. *@
                    @if (!auth.User.IsInRole("Player"))
                    {
                        <span class="hello-text">Hello @teamName</span>
                    }
                </Authorized>
            </AuthorizeView>
        </div>

        <!-- Desktop nav -->
        <nav class="nav-links">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/fixtures">Fixtures</NavLink>
            @if (knockoutGenerated)
            {
                <NavLink href="/knockout">Knockout</NavLink>
            }
            <NavLink href="/teams">Teams</NavLink>
            <NavLink href="/stats">Stats</NavLink>
            <NavLink href="/totw">TOTW</NavLink>
            <NavLink href="/motd">MOTD</NavLink>
            <NavLink href="/galleries">Galleries</NavLink>
            <NavLink href="/sponsor-us">Sponsor Us</NavLink>
            @if (HostEnv.IsDevelopment() || Config.GetValue<bool>("IsUAT"))
            {
                <NavLink href="/debug" class="debug-nav-link">Debug</NavLink>
            }
            <AuthorizeView>
                <Authorized>
                    @* A player's card is their home, so it takes the Dashboard's
                       place rather than adding a link. The header is capped at
                       1380px and has no room for another one at this width. *@
                    @if (context.User.IsInRole("Player"))
                    {
                        <NavLink href="/my-card">My Card</NavLink>
                    }
                    else if (context.User.IsInRole("Admin"))
                    {
                        <NavLink href="/admin">Admin</NavLink>
                    }
                    else
                    {
                        @* A manager's dashboard is their HQ; a referee's stays a dashboard. *@
                        <NavLink href="/dashboard">@(context.User.IsInRole("Manager") ? "HQ" : "Dashboard")</NavLink>
                    }
                    @* The guide is reached from the manager's Help tab and the referee dashboard. *@
                    <NotificationBell />
                    <a class="logout-link" @onclick="Logout" @onclick:preventDefault>Logout</a>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/login">Login</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>

        <!-- Hamburger (mobile only) -->
        <button class="hamburger @(navOpen ? "open" : "")"
                @onclick="ToggleNav"
                aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>
</header>

<!-- Mobile right-slide drawer -->
<div class="nav-backdrop @(navOpen ? "is-visible" : "")" @onclick="CloseNav"></div>
<div class="mobile-overlay @(navOpen ? "is-open" : "")">
    <div class="mobile-panel-header">
        <span class="mobile-panel-logo">Ballers</span>
        <button class="mobile-panel-close" @onclick="CloseNav" aria-label="Close menu">&#x2715;</button>
    </div>
    <AuthorizeView>
        <Authorized>
            <p class="mobile-greeting">Hello, @teamName</p>
        </Authorized>
    </AuthorizeView>

    <nav class="mobile-nav">
        <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseNav">Home</NavLink>
        <NavLink href="/fixtures" @onclick="CloseNav">Fixtures</NavLink>
        @if (knockoutGenerated)
        {
            <NavLink href="/knockout" @onclick="CloseNav">Knockout</NavLink>
        }
        <NavLink href="/teams" @onclick="CloseNav">Teams</NavLink>
        <NavLink href="/stats" @onclick="CloseNav">Stats</NavLink>
        <NavLink href="/totw" @onclick="CloseNav">TOTW</NavLink>
        <NavLink href="/motd" @onclick="CloseNav">MOTD</NavLink>
        <NavLink href="/galleries" @onclick="CloseNav">Galleries</NavLink>
        <NavLink href="/sponsor-us" @onclick="CloseNav">Sponsor Us</NavLink>
        <AuthorizeView>
            <Authorized>
                @* A player's card is their home; they have no dashboard. *@
                @if (context.User.IsInRole("Player"))
                {
                    <NavLink href="/my-card" @onclick="CloseNav">My Card</NavLink>
                }
                else if (context.User.IsInRole("Admin"))
                {
                    <NavLink href="/admin" @onclick="CloseNav">Admin</NavLink>
                }
                else
                {
                    <NavLink href="/dashboard" @onclick="CloseNav">@(context.User.IsInRole("Manager") ? "HQ" : "Dashboard")</NavLink>
                }
                <NavLink href="/change-password" @onclick="CloseNav">Change Password</NavLink>
                <button class="mobile-logout-btn" @onclick="Logout">Logout</button>
            </Authorized>
            <NotAuthorized>
                <NavLink href="/login" @onclick="CloseNav">Login</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<div class="main-content">
    @Body
</div>

<SiteFooter />
<CookieBanner />

@inject AuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@code {

    private string? teamName;
    private bool navOpen = false;
    private bool knockoutGenerated = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
            // A player is greeted by their own name rather than their team's, since
            // the team is their manager's, not theirs.
            teamName = (user.IsInRole("Player") ? user.FindFirst("PlayerName")?.Value : null)
                       ?? user.FindFirst("TeamName")?.Value
                       ?? (user.IsInRole("Admin") ? "Admin"
                           : user.IsInRole("Referee") ? "Referee"
                           : user.Identity?.Name);

        var season = await SeasonSvc.GetCurrentSeason();
        knockoutGenerated = season?.IsKnockoutGenerated ?? false;

        StateHasChanged();
    }

    private static readonly HashSet<string> DarkPages = new(StringComparer.OrdinalIgnoreCase) { "", "my-card", "fixtures", "teams", "stats", "totw", "galleries", "admin",
        "dashboard", "manager-fixtures", "my-squad", "my-team", "referees" };

    // Pages under a dark prefix, such as /team/3.
    private static readonly string[] DarkPrefixes = { "team/", "gallery/", "admin/", "fixture/" };

    private bool IsDarkPage
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);
            var end = path.IndexOfAny(new[] { '?', '#' });
            var page = (end >= 0 ? path[..end] : path).Trim('/');
            return DarkPages.Contains(page)
                || DarkPrefixes.Any(p => page.StartsWith(p, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void ToggleNav() => navOpen = !navOpen;
    private void CloseNav() => navOpen = false;

    async Task Logout()
    {
        await Auth.Logout();
        ((AuthStateProvider)AuthProvider).NotifyUserLogout();
        navOpen = false;
        Nav.NavigateTo("/");
        StateHasChanged();
    }
}
