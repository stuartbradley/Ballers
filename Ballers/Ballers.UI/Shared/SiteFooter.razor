@using System.Reflection
@using Ballers.Services
@inject AnalyticsService Analytics

<footer class="site-footer">
    <div class="footer-inner">
        <span class="footer-credit">
            Created by <strong>Stuart Bradley</strong> ·
            <a href="mailto:stuartbradleyDeveloper@gmail.com">stuartbradleyDeveloper@gmail.com</a>
        </span>

        <nav class="footer-links">
            <a href="/privacy">Privacy</a>
            <a href="#" @onclick="ShowCookieBanner" @onclick:preventDefault>Cookie settings</a>
        </nav>

        <span class="footer-version" title="Build version">v@(version)</span>
    </div>
</footer>

@code {
    private string version = "dev";

    private void ShowCookieBanner() => Analytics.RequestBanner();

    protected override void OnInitialized()
    {
        var info = typeof(App).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion;

        if (!string.IsNullOrWhiteSpace(info))
        {
            var plus = info.IndexOf('+');
            version = plus > 0 ? info[..plus] : info;
        }
        else
        {
            version = typeof(App).Assembly.GetName().Version?.ToString(3) ?? "dev";
        }
    }
}
