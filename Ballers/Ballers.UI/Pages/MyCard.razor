@page "/my-card"
@using Ballers.Services
@using Ballers.Shared
@using Ballers.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Player")]
@inject IJSRuntime JS
@inherits ViewModelComponent<MyCardViewModel>

<PageTitle>My Card</PageTitle>

@* The same floodlit night as the home page: a lit header, the card on its own
   pool of light, and dark glass panels for spending points and the history.
   Elements marked data-reveal fade up as they come on screen
   (wwwroot/js/homeReveal.js). *@
<div class="my-card-page" id="my-card-root">

    @if (Vm.Loading)
    {
        <div class="mc-loading"><LoadingSpinner /></div>
    }
    else if (Vm.Card == null)
    {
        <div class="mc-loading">
            <p class="my-card-error">We couldn't load your card. Try reloading the page.</p>
        </div>
    }
    else
    {
        <!-- ── HEADER ── -->
        <header class="mc-hero">
            @* Where the saved overall stands: across the league, and among
               players in the same position. *@
            @if (Vm.Card.OverallOf > 0)
            {
                <div class="mc-ranks" aria-label="Your ranking">
                    <span class="mc-rank">
                        <span class="mc-rank-num">#@Vm.Card.OverallRank</span>
                        <span class="mc-rank-text">of @Vm.Card.OverallOf in the league</span>
                    </span>
                    <span class="mc-rank">
                        <span class="mc-rank-num">#@Vm.Card.PositionRank</span>
                        <span class="mc-rank-text">of @Vm.Card.PositionOf @Vm.PositionPlural</span>
                    </span>
                </div>
            }
            <span class="mc-eyebrow">Your card</span>
            <h1>@Vm.Card.Name</h1>
            <p class="mc-meta">
                @if (!string.IsNullOrEmpty(Vm.Card.TeamName))
                {
                    <span>@Vm.Card.TeamName</span>
                }
                <span>#@Vm.Card.Number</span>
                <span>@Vm.Card.Position</span>
            </p>
            <div class="mc-chips">
                <span class="mc-chip mc-chip-tier tier-@(Vm.DisplayTier ?? "bronze")">@(Vm.DisplayTier ?? "bronze") card</span>
                <span class="mc-chip">Overall <strong>@Vm.PreviewOverall</strong></span>
                <span class="mc-chip">@Vm.Card.TotalPointsEarned points earned</span>
            </div>
        </header>

        <div class="mc-body">
            <div class="mc-layout">

                <!-- ── THE CARD ── -->
                <div class="mc-stage @(Vm.Upgrading ? "is-upgrading" : "") up-@Vm.UpgradeTo" data-reveal>
                    @* The stats preview the spend as you build it. The tier art does
                       not: it stays on the saved tier, so that moving up a tier
                       happens on Save, with its own moment. *@
                    <div class="mc-burst" aria-hidden="true"></div>
                    <div class="mc-card">
                        <PlayerCard Name="@Vm.Card.Name"
                                    Number="@Vm.Card.Number"
                                    Position="@Vm.Card.Position"
                                    ImageUrl="@Vm.Card.ImageUrl"
                                    Attributes="@Vm.PreviewAttributes"
                                    Tier="@Vm.DisplayTier" />
                        <div class="mc-flash" aria-hidden="true"></div>
                    </div>
                    <div class="mc-sparks" aria-hidden="true">
                        @for (var i = 0; i < 14; i++)
                        {
                            <span style="--a:@(i * 360 / 14)deg; --d:@(i % 3 * 0.06)s"></span>
                        }
                    </div>
                    <div class="mc-floor" aria-hidden="true"></div>

                    @if (Vm.ShowBanner && Vm.UpgradeFrom != null && Vm.UpgradeTo != null)
                    {
                        <div class="mc-upgrade-banner" role="status">
                            <span class="tier-word tier-@Vm.UpgradeFrom">@Vm.UpgradeFrom</span>
                            <span class="mc-upgrade-arrow">→</span>
                            <span class="tier-word tier-@Vm.UpgradeTo">@Vm.UpgradeTo</span>
                        </div>
                    }
                    else if (Vm.PreviewIsUpgrade)
                    {
                        <div class="mc-upgrade-hint">Save to go <strong class="tier-word tier-@Vm.PreviewTier">@Vm.PreviewTier</strong></div>
                    }
                </div>

                <!-- ── SPEND POINTS ── -->
                <section class="mc-panel" data-reveal>
                    <div class="points-balance">
                        <span class="points-balance-value">@Vm.Remaining</span>
                        <span class="points-balance-label">point@(Vm.Remaining == 1 ? "" : "s") to spend</span>
                    </div>

                    @if (Vm.Card.UnspentPoints == 0)
                    {
                        <p class="points-note">
                            Nothing to spend right now. You'll earn more after your next game.
                        </p>
                    }
                    else
                    {
                        <p class="points-note">
                            Points go in permanently, so choose carefully — you can't move them
                            later. Nothing is saved until you press Save.
                        </p>
                    }

                    <div class="attribute-rows">
                        @foreach (var row in Vm.Rows)
                        {
                            <div class="attribute-row @(row.Added > 0 ? "is-changed" : "")">
                                <span class="attribute-row-label">@row.Label</span>
                                <span class="attribute-row-value">
                                    <span class="attribute-row-current">@row.Current</span>
                                    @if (row.Added > 0)
                                    {
                                        <span class="attribute-row-arrow">→</span>
                                        <span class="attribute-row-new">@(row.Current + row.Added)</span>
                                    }
                                </span>

                                <div class="attribute-row-controls">
                                    <button type="button"
                                            class="step-btn"
                                            disabled="@(row.Added == 0)"
                                            @onclick="() => Vm.Step(row, -1)"
                                            title="Take one back"
                                            aria-label="@($"Take one point back from {row.Label}")">−</button>
                                    <span class="attribute-row-added">+@row.Added</span>
                                    <button type="button"
                                            class="step-btn"
                                            disabled="@(!Vm.CanAdd(row))"
                                            @onclick="() => Vm.Step(row, 1)"
                                            title="Add one"
                                            aria-label="@($"Add a point to {row.Label}")">+</button>
                                </div>

                                @* How far the stat is towards the league's cap, with
                                   the points being added shown on the end. *@
                                <div class="attribute-row-bar" aria-hidden="true">
                                    <span class="bar-current" style="width:@Vm.Share(row.Current)%"></span>
                                    <span class="bar-added" style="width:@Vm.Share(row.Added)%"></span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="my-card-summary">
                        <span>Overall @Vm.Card.Attributes.Overall</span>
                        @if (Vm.PreviewOverall != Vm.Card.Attributes.Overall)
                        {
                            <span class="my-card-summary-new">→ @Vm.PreviewOverall</span>
                        }
                    </div>

                    @if (Vm.Error != null)
                    {
                        <p class="my-card-error">@Vm.Error</p>
                    }
                    @if (Vm.Saved)
                    {
                        <p class="my-card-saved">Saved.</p>
                    }

                    <div class="my-card-actions">
                        <button type="button"
                                class="btn-gold"
                                disabled="@(Vm.Allocated == 0 || Vm.Saving)"
                                @onclick="Vm.Save">
                            @(Vm.Saving ? "Saving…" : $"Vm.Save {Vm.Allocated} point{(Vm.Allocated == 1 ? "" : "s")}")
                        </button>
                        <button type="button"
                                class="btn-ghost"
                                disabled="@(Vm.Allocated == 0 || Vm.Saving)"
                                @onclick="Vm.Reset">
                            Clear
                        </button>
                    </div>
                </section>
            </div>

            <!-- ── HISTORY ── -->
            @if (Vm.Awards.Count > 0)
            {
                <section class="mc-panel points-history" data-reveal>
                    <div class="section-head">
                        <span class="mc-eyebrow">Points log</span>
                        <h2>How you earned them</h2>
                    </div>
                    <div class="history-scroll">
                        <table>
                            <thead>
                                <tr>
                                    <th>Match</th>
                                    <th>Opponent</th>
                                    <th class="num">Points</th>
                                    <th>MyCardViewModel.Breakdown</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var award in Vm.Awards)
                                {
                                    <tr>
                                        <td>@(award.Kickoff?.ToString("d MMM yyyy") ?? "—")</td>
                                        <td class="opponent">@(award.Opponent ?? "—")</td>
                                        <td class="num">+@award.Points</td>
                                        <td class="breakdown">@MyCardViewModel.Breakdown(award)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    // The card's state and spending rules are in MyCardViewModel.

    private bool revealed;

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Vm.Loading || revealed) return;
        revealed = true;
        try { await JS.InvokeVoidAsync("homeReveal.scan", "my-card-root"); }
        catch (JSException) { /* decoration only; everything is shown without it */ }
    }
}
