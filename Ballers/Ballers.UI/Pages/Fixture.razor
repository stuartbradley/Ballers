@page "/fixture/{Id:int}"
@using Ballers.Client.Auth
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

@inherits ViewModelComponent<FixtureViewModel>

<PageTitle>@(Vm.Fixture != null ? $"{Vm.Fixture.HomeTeam} vs {Vm.Fixture.AwayTeam}" : "Fixture")</PageTitle>

@* A fixture, laid out as the job it is: set it up (when, where, who's
   reffing), pick the squad any time before kickoff, then send the result
   and the penalties after the game. One step on screen at a time, opening on
   the one that's due. Same comic styling as the manager's HQ. *@
<div class="toast-container">
    @if (Vm.ToastVisible)
    {
        <div class="toast @(Vm.ToastSuccess ? "toast-success" : "toast-error")" role="status">@Vm.ToastMessage</div>
    }
</div>

<div class="fx comic">
    <AuthorizeView Roles="Manager"><ManagerNav Current="fixtures" /></AuthorizeView>

    @if (Vm.IsLoading)
    {
        <div class="fx-loading"><LoadingSpinner /></div>
    }
    else if (Vm.Fixture == null)
    {
        <div class="fx-wrap">
            <div class="c-panel fx-notfound">
                <span class="fx-big-emoji" aria-hidden="true">🤷</span>
                <h2>Fixture not found</h2>
                <a class="c-btn is-yellow" href="/manager-fixtures">Back to fixtures</a>
            </div>
        </div>
    }
    else
    {
        var f = Vm.Fixture;
        <div class="fx-wrap">

            <!-- ── Header ── -->
            <header class="fx-head">
                <span class="fx-sticker">@(f.IsKnockout ? $"{f.KnockoutTournament} · {f.KnockoutRound}" : $"Match week {f.Week}")</span>
                <div class="fx-teams">
                    <div class="fx-team @(Vm.ViewingHome ? "is-us" : "")">
                        <span class="fx-crest">@Format.TeamInitials(f.HomeTeam)</span>
                        <span class="fx-team-name">@f.HomeTeam</span>
                        <span class="fx-side">Home</span>
                    </div>
                    @if (Vm.ShowScore)
                    {
                        <span class="fx-score" aria-label="Score">@Vm.PreviewHomeScore<span>–</span>@Vm.PreviewAwayScore</span>
                    }
                    else
                    {
                        <span class="fx-burst" aria-label="versus">VS</span>
                    }
                    <div class="fx-team @(!Vm.ViewingHome ? "is-us" : "")">
                        <span class="fx-crest">@Format.TeamInitials(f.AwayTeam)</span>
                        <span class="fx-team-name">@f.AwayTeam</span>
                        <span class="fx-side">Away</span>
                    </div>
                </div>
                <div class="fx-status">
                    <span class="fx-countdown">@Vm.Countdown</span>
                    <span class="fx-state is-@Vm.StatusTone">@Vm.StatusText</span>
                </div>
            </header>

            @if (Vm.IsOfficial)
            {
                <div class="fx-acting" role="group" aria-label="Which side you're working on">
                    <span>Working on</span>
                    <button type="button" class="fx-chip @(Vm.ViewingHome ? "is-active" : "")" @onclick="() => Vm.SwitchActingTeam(f.HomeTeamId)">@f.HomeTeam</button>
                    <button type="button" class="fx-chip @(!Vm.ViewingHome ? "is-active" : "")" @onclick="() => Vm.SwitchActingTeam(f.AwayTeamId)">@f.AwayTeam</button>
                </div>
            }

            @if (Vm.EditingLocked)
            {
                <p class="fx-note">🔒 The admins have locked fixtures for now, so nothing here can be changed.</p>
            }
            @if (Vm.AwaitingOtherTeamStats)
            {
                <p class="fx-note is-amber">⏳ Waiting on <strong>@Vm.TeamYetToSubmit</strong> to send their stats. The result stays off the table until both teams have.</p>
            }

            <!-- ── Steps ── -->
            <nav class="fx-steps" aria-label="Match steps">
                @foreach (var s in Vm.Steps)
                {
                    <button type="button" class="fx-step @(Vm.Step == s.Key ? "is-current" : "") @(s.Done ? "is-done" : "") @(s.Locked ? "is-locked" : "")"
                            aria-current="@(Vm.Step == s.Key ? "step" : null)"
                            @onclick="() => Vm.GoTo(s.Key)">
                        <span class="fx-step-num" aria-hidden="true">@(s.Done ? "✔" : s.Locked ? "🔒" : s.Number.ToString())</span>
                        <span class="fx-step-text">
                            <strong>@s.Label</strong>
                            <small>@s.Hint</small>
                        </span>
                    </button>
                }
            </nav>

            <div class="fx-layout">
                <div class="fx-main">

                    @* ── 1. Setup ── *@
                    @if (Vm.Step == "setup")
                    {
                        <section class="c-panel" aria-labelledby="setup-title">
                            <h2 id="setup-title"><span aria-hidden="true">📅</span> Setup</h2>
                            @if (Vm.CanEditSetup)
                            {
                                <p class="fx-sub">When and where it's on, and who's reffing. Get this sorted early so everyone knows.</p>
                                <div class="fx-form">
                                    <label class="fx-field">
                                        <span>Date</span>
                                        <input type="date" @bind="Vm.ScheduleDate" disabled="@Vm.ReadOnly" />
                                    </label>
                                    <label class="fx-field">
                                        <span>Kickoff</span>
                                        <input type="time" @bind="Vm.ScheduleTime" disabled="@Vm.ReadOnly" />
                                    </label>
                                    <label class="fx-field is-wide">
                                        <span>Venue</span>
                                        <input type="text" placeholder="e.g. Stanley Park, pitch 3" @bind="Vm.ScheduleLocation" disabled="@Vm.ReadOnly" />
                                    </label>
                                    <label class="fx-field">
                                        <span>Postcode</span>
                                        <input type="text" placeholder="e.g. FY3 9HU" @bind="Vm.SchedulePostcode" disabled="@Vm.ReadOnly" />
                                    </label>
                                    <label class="fx-field is-wide">
                                        <span>Referee</span>
                                        @if (!Vm.AllReferees.Any())
                                        {
                                            <span class="fx-help">No referees registered yet. <a href="/referees">Add one →</a></span>
                                        }
                                        else
                                        {
                                            <select @bind="Vm.SelectedRefereeId" disabled="@Vm.ReadOnly">
                                                <option value="">No referee yet</option>
                                                @foreach (var r in Vm.AllReferees)
                                                {
                                                    <option value="@r.Id">@r.Name@(Vm.IsBooked(r) ? " (booked that week)" : "")</option>
                                                }
                                            </select>
                                        }
                                    </label>
                                </div>
                                <div class="fx-actionbar">
                                    @if (f.Kickoff != null || !string.IsNullOrEmpty(f.Location))
                                    {
                                        <button type="button" class="c-btn" disabled="@(Vm.ReadOnly || Vm.Busy)" @onclick="Vm.ClearSchedule">Clear time &amp; venue</button>
                                    }
                                    <button type="button" class="c-btn is-yellow" disabled="@(Vm.ReadOnly || Vm.Busy)" @onclick="Vm.SaveSetup">
                                        @(Vm.Busy ? "Saving…" : "Save setup")
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="fx-sub">
                                    @(f.IsKnockout ? "The admins set up knockout games." : $"{f.HomeTeam} are at home, so it's theirs to set up.")
                                    Here's what's been set so far.
                                </p>
                                <dl class="fx-facts">
                                    <div><dt>📅 When</dt><dd>@(f.Kickoff?.ToString("ddd d MMM, HH:mm") ?? "Not set yet")</dd></div>
                                    <div><dt>📍 Where</dt><dd>@(string.IsNullOrWhiteSpace(f.Location) ? "Not set yet" : f.Location)</dd></div>
                                    <div><dt>🟨 Ref</dt><dd>@(f.RefereeName ?? "Not assigned yet")</dd></div>
                                </dl>
                                <div class="fx-actionbar">
                                    <button type="button" class="c-btn is-yellow" @onclick='() => Vm.GoTo("squad")'>On to the squad →</button>
                                </div>
                            }

                            @if (Vm.CanSwap)
                            {
                                <div class="fx-swap">
                                    <span class="fx-swap-text">
                                        <strong>🔄 Can't host this one?</strong>
                                        Swap home and away: @f.AwayTeam become the home side and take over the setup.
                                    </span>
                                    <button type="button" class="c-btn is-small" disabled="@Vm.Busy" @onclick="() => Vm.ConfirmingSwap = true">Swap home &amp; away</button>
                                </div>
                            }
                        </section>
                    }

                    @* ── 2. Squad ── *@
                    @if (Vm.Step == "squad")
                    {
                        var picked = Vm.TeamPlayers.Count(p => p.IsSelected);
                        <section class="c-panel" aria-labelledby="squad-title">
                            <div class="fx-panel-head">
                                <h2 id="squad-title"><span aria-hidden="true">👕</span> Squad</h2>
                                <span class="fx-counter @(picked >= FixtureViewModel.SquadMinimum ? "is-ok" : "")">@picked / @FixtureViewModel.SquadMinimum</span>
                            </div>
                            <p class="fx-sub">Tap players to pick them, any time before kickoff. Then tap <strong>C</strong> and <strong>VC</strong> for your captain and vice.</p>
                            <div class="fx-meter" aria-hidden="true"><span style="width:@Math.Min(100, picked * 100 / FixtureViewModel.SquadMinimum)%"></span></div>

                            @if (!Vm.TeamPlayers.Any())
                            {
                                <p class="fx-empty">No players in this squad yet. <a href="/my-squad">Add some in My Squad →</a></p>
                            }

                            @foreach (var group in Vm.PositionGroups)
                            {
                                <h3 class="fx-group">@group.Name <small>@group.Players.Count(p => p.IsSelected) picked</small></h3>
                                <div class="fx-picks">
                                    @foreach (var p in group.Players)
                                    {
                                        var isCap = Vm.CaptainPlayerId == p.PlayerId;
                                        var isVice = Vm.VicePlayerId == p.PlayerId;
                                        <div class="fx-pick @(p.IsSelected ? "is-picked" : "")">
                                            <button type="button" class="fx-pick-main" aria-pressed="@(p.IsSelected ? "true" : "false")"
                                                    disabled="@Vm.ReadOnly" @onclick="() => Vm.TogglePick(p)">
                                                <span class="fx-shirt">@(p.Number > 0 ? p.Number.ToString() : "–")</span>
                                                <span class="fx-pick-name">@p.Name</span>
                                                <span class="fx-tick" aria-hidden="true">@(p.IsSelected ? "✔" : "+")</span>
                                            </button>
                                            @if (p.IsSelected)
                                            {
                                                <span class="fx-armbands">
                                                    <button type="button" class="fx-band @(isCap ? "is-on" : "")" disabled="@Vm.ReadOnly"
                                                            aria-pressed="@(isCap ? "true" : "false")" aria-label="@($"Make {p.Name} captain")"
                                                            @onclick="() => Vm.SetCaptain(p.PlayerId)">C</button>
                                                    <button type="button" class="fx-band is-vice @(isVice ? "is-on" : "")" disabled="@Vm.ReadOnly"
                                                            aria-pressed="@(isVice ? "true" : "false")" aria-label="@($"Make {p.Name} vice-captain")"
                                                            @onclick="() => Vm.SetVice(p.PlayerId)">VC</button>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <div class="fx-actionbar">
                                <span class="fx-actionbar-info">
                                    @(picked >= FixtureViewModel.SquadMinimum ? $"✔ {picked} picked" : $"{FixtureViewModel.SquadMinimum - picked} more to go")
                                    @(Vm.CaptainPlayerId == null ? " · no captain" : "")
                                </span>
                                <a class="c-btn" href="/team-sheet/@f.Id">Team sheet</a>
                                <button type="button" class="c-btn is-yellow" disabled="@(Vm.ReadOnly || Vm.Busy)" @onclick="Vm.SaveSquad">
                                    @(Vm.Busy ? "Saving…" : $"Save squad ({picked})")
                                </button>
                            </div>
                        </section>
                    }

                    @* ── 3. Result ── *@
                    @if (Vm.Step == "result")
                    {
                        <section class="c-panel" aria-labelledby="result-title">
                            <div class="fx-panel-head">
                                <h2 id="result-title"><span aria-hidden="true">📝</span> Result</h2>
                                <div class="fx-toggle" role="group" aria-label="Whose stats">
                                    <button type="button" class="fx-chip @(!Vm.ViewingOpponent ? "is-active" : "")" @onclick="() => Vm.ViewingOpponent = false">@Vm.MyTeamLabel</button>
                                    <button type="button" class="fx-chip @(Vm.ViewingOpponent ? "is-active" : "")" @onclick="Vm.LoadOpponentStats">@Vm.OpponentTeamName</button>
                                </div>
                            </div>

                            @if (Vm.ViewingOpponent)
                            {
                                @if (!Vm.OpponentStats.Any())
                                {
                                    <p class="fx-empty">⏳ @Vm.OpponentTeamName haven't sent their stats yet.</p>
                                }
                                else
                                {
                                    <ul class="fx-their">
                                        @foreach (var p in Vm.OpponentStats)
                                        {
                                            <li>
                                                <span class="fx-their-name">@p.Name @(p.IsMotm ? "⭐" : "")</span>
                                                <span>@StatLine(p.Goals, p.Assists, p.OwnGoals, p.YellowCard, p.RedCard)</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                            else if (!Vm.SquadSelected)
                            {
                                <div class="fx-empty">
                                    <span class="fx-big-emoji" aria-hidden="true">👕</span>
                                    <p>Pick at least @FixtureViewModel.SquadMinimum players first; their stats go here.</p>
                                    <button type="button" class="c-btn is-yellow" @onclick='() => Vm.GoTo("squad")'>Pick the squad</button>
                                </div>
                            }
                            else if (Vm.Reviewing)
                            {
                                <div class="fx-review">
                                    <h3>Check before you send</h3>
                                    <p class="fx-review-score">@Vm.MyTeamLabel <strong>@Vm.MyScore – @Vm.TheirScore</strong> @Vm.OpponentTeamName</p>
                                    @if (!Vm.OpponentStatsSent)
                                    {
                                        <p class="fx-help">Their score counts once @Vm.OpponentTeamName send their stats; your goals are what you're sending now.</p>
                                    }
                                    <dl class="fx-facts">
                                        <div><dt>⚽ Goals</dt><dd>@Join(Vm.Players.Where(p => p.Goals > 0).Select(p => p.Goals > 1 ? $"{p.Name} ×{p.Goals}" : p.Name), "None")</dd></div>
                                        <div><dt>🎯 Assists</dt><dd>@Join(Vm.Players.Where(p => p.Assists > 0).Select(p => p.Assists > 1 ? $"{p.Name} ×{p.Assists}" : p.Name), "None")</dd></div>
                                        <div><dt>⭐ Man of the Match</dt><dd>@(Vm.Players.FirstOrDefault(p => p.IsMotm)?.Name ?? "Not picked")</dd></div>
                                        <div><dt>🟨🟥 Cards</dt><dd>@Join(Vm.Players.Where(p => p.HasYellowCard || p.HasRedCard).Select(p => $"{p.Name} {(p.HasRedCard ? "🟥" : "🟨")}"), "None")</dd></div>
                                        @if (Vm.Players.Any(p => p.OwnGoals > 0))
                                        {
                                            <div><dt>🙈 Own goals</dt><dd>@Join(Vm.Players.Where(p => p.OwnGoals > 0).Select(p => p.Name), "")</dd></div>
                                        }
                                    </dl>
                                    <div class="fx-actionbar">
                                        <button type="button" class="c-btn" @onclick="() => Vm.Reviewing = false">‹ Edit</button>
                                        <button type="button" class="c-btn is-green" disabled="@(Vm.ReadOnly || Vm.Busy)" @onclick="Vm.SubmitStats">
                                            @(Vm.Busy ? "Sending…" : "✔ Send stats")
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="fx-sub">Tap + and − for each player. Pick one Man of the Match. Own goals count for @Vm.OpponentTeamName.</p>
                                <div class="fx-statlist">
                                    @foreach (var p in Vm.Players)
                                    {
                                        <div class="fx-statrow @(p.IsMotm ? "is-motm" : "")">
                                            <span class="fx-stat-name">@p.Name</span>
                                            <div class="fx-steppers">
                                                @Stepper("Goals", p.Goals, d => p.Goals = Math.Max(0, p.Goals + d))
                                                @Stepper("Assists", p.Assists, d => p.Assists = Math.Max(0, p.Assists + d))
                                                @Stepper("Own goals", p.OwnGoals, d => p.OwnGoals = Math.Max(0, p.OwnGoals + d))
                                            </div>
                                            <div class="fx-flags">
                                                <button type="button" class="fx-flag is-motm @(p.IsMotm ? "is-on" : "")" disabled="@Vm.ReadOnly"
                                                        aria-pressed="@(p.IsMotm ? "true" : "false")" @onclick="() => Vm.SelectMotm(p)">
                                                    <span class="fx-flag-mark" aria-hidden="true">★</span> Man of the Match
                                                </button>
                                                <button type="button" class="fx-flag is-yellow @(p.HasYellowCard ? "is-on" : "")" disabled="@Vm.ReadOnly"
                                                        aria-pressed="@(p.HasYellowCard ? "true" : "false")" @onclick="() => p.HasYellowCard = !p.HasYellowCard">
                                                    <span class="fx-card-swatch is-yellow" aria-hidden="true"></span> Yellow card
                                                </button>
                                                <button type="button" class="fx-flag is-red @(p.HasRedCard ? "is-on" : "")" disabled="@Vm.ReadOnly"
                                                        aria-pressed="@(p.HasRedCard ? "true" : "false")" @onclick="() => p.HasRedCard = !p.HasRedCard">
                                                    <span class="fx-card-swatch is-red" aria-hidden="true"></span> Red card
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="fx-actionbar">
                                    <span class="fx-actionbar-info">@Vm.MyTeamLabel @Vm.MyScore – @Vm.TheirScore @Vm.OpponentTeamName</span>
                                    <button type="button" class="c-btn is-yellow" disabled="@Vm.ReadOnly" @onclick="Vm.StartReview">Check &amp; send →</button>
                                </div>
                            }
                        </section>
                    }

                    @* ── 4. Penalties ── *@
                    @if (Vm.Step == "pens")
                    {
                        <section class="c-panel" aria-labelledby="pens-title">
                            <h2 id="pens-title"><span aria-hidden="true">🥅</span> Penalties</h2>
                            @if (!f.IsPlayed)
                            {
                                <div class="fx-empty">
                                    <span class="fx-big-emoji" aria-hidden="true">⏳</span>
                                    <p>Penalties go in once the result's confirmed, which is when both teams have sent their stats.</p>
                                </div>
                            }
                            else
                            {
                                <p class="fx-sub">Your five takers, in order, and whether they scored.</p>
                                <ol class="fx-kicks">
                                    @foreach (var kick in Vm.PenaltyKicks)
                                    {
                                        <li class="@(kick.PlayerId > 0 ? (kick.Scored ? "is-scored" : "is-missed") : "")">
                                            <span class="fx-kick-num">@kick.Order</span>
                                            <select @bind="kick.PlayerId" disabled="@Vm.ReadOnly" aria-label="@($"Taker {kick.Order}")">
                                                <option value="0">Pick a taker…</option>
                                                @foreach (var p in Vm.TeamPlayers)
                                                {
                                                    <option value="@p.PlayerId">@p.Name</option>
                                                }
                                            </select>
                                            <button type="button" class="fx-flag @(kick.Scored ? "is-scored is-on" : "is-missed is-on")" disabled="@Vm.ReadOnly"
                                                    @onclick="() => kick.Scored = !kick.Scored">@(kick.Scored ? "⚽ Scored" : "❌ Missed")</button>
                                        </li>
                                    }
                                </ol>
                                <div class="fx-actionbar">
                                    <button type="button" class="c-btn is-green" disabled="@(Vm.ReadOnly || Vm.Busy)" @onclick="Vm.SubmitPenalties">
                                        @(Vm.Busy ? "Sending…" : "✔ Send penalties")
                                    </button>
                                </div>

                                <h3 class="fx-group">@Vm.OpponentTeamName's penalties</h3>
                                @if (!Vm.OpponentKicks.Any())
                                {
                                    <p class="fx-empty">⏳ Not sent yet.</p>
                                }
                                else
                                {
                                    <ol class="fx-kicks is-theirs">
                                        @foreach (var kick in Vm.OpponentKicks)
                                        {
                                            <li class="@(kick.Scored ? "is-scored" : "is-missed")">
                                                <span class="fx-kick-num">@kick.Order</span>
                                                <span class="fx-kick-name">@kick.PlayerName</span>
                                                <span>@(kick.Scored ? "⚽ Scored" : "❌ Missed")</span>
                                            </li>
                                        }
                                    </ol>
                                }
                            }
                        </section>
                    }
                </div>

                <!-- ── Match info ── -->
                <aside class="fx-side-col" aria-label="Match info">
                    <section class="c-panel is-slim">
                        <h2><span aria-hidden="true">ℹ️</span> Match info</h2>
                        <dl class="fx-facts is-stacked">
                            <div><dt>📅 When</dt><dd>@(f.Kickoff?.ToString("ddd d MMM yyyy, HH:mm") ?? $"Week of {f.WindowStart:d MMM}, time TBC")</dd></div>
                            <div>
                                <dt>📍 Where</dt>
                                <dd>
                                    @(string.IsNullOrWhiteSpace(f.Location) ? "TBC" : f.Location)@(string.IsNullOrWhiteSpace(f.Postcode) ? "" : $", {f.Postcode}")
                                    @if (Vm.MapUrl is { } map)
                                    {
                                        <a class="fx-mini-link" href="@map" target="_blank" rel="noopener noreferrer">Open in maps ↗</a>
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt>🟨 Referee</dt>
                                <dd>
                                    @(f.RefereeName ?? "Not assigned yet")
                                    @if (Vm.CurrentReferee is { } cr)
                                    {
                                        <span class="fx-contacts">
                                            @if (!string.IsNullOrEmpty(cr.PhoneNumber))
                                            {
                                                <a class="c-btn is-small" href="tel:@cr.PhoneNumber">📞 Call</a>
                                            }
                                            @if (!string.IsNullOrEmpty(cr.Email))
                                            {
                                                <a class="c-btn is-small" href="mailto:@cr.Email">✉ Email</a>
                                            }
                                        </span>
                                    }
                                </dd>
                            </div>
                            @if (Vm.MyCaptainName != null)
                            {
                                <div><dt>©️ Captain</dt><dd>@Vm.MyCaptainName@(Vm.MyViceName != null ? $" (vice: {Vm.MyViceName})" : "")</dd></div>
                            }
                        </dl>
                        <div class="fx-links">
                            <a class="c-btn is-small" href="/team-sheet/@f.Id">📋 Team sheet</a>
                            @if (Vm.GalleryId is { } gid)
                            {
                                <a class="c-btn is-small" href="/gallery/@gid">📷 Photos</a>
                            }
                        </div>
                    </section>

                    @if (Vm.HeadToHead.Any())
                    {
                        <section class="c-panel is-slim">
                            <h2><span aria-hidden="true">🤜🤛</span> Last meetings</h2>
                            <ul class="fx-h2h">
                                @foreach (var m in Vm.HeadToHead)
                                {
                                    <li>
                                        <span class="@(m.HomeScore > m.AwayScore ? "is-win" : "")">@m.HomeTeam</span>
                                        <strong>@m.HomeScore–@m.AwayScore</strong>
                                        <span class="@(m.AwayScore > m.HomeScore ? "is-win" : "")">@m.AwayTeam</span>
                                        <small>@((m.Kickoff ?? m.WindowEnd).ToString("MMM yy"))</small>
                                    </li>
                                }
                            </ul>
                        </section>
                    }

                    @if (Vm.IsOfficial)
                    {
                        <details class="c-panel is-slim fx-admin">
                            <summary><span aria-hidden="true">🛠️</span> @(Vm.IsSiteAdmin ? "Admin" : "Referee") tools</summary>

                            @if (f.HomeCaptainName != null || f.AwayCaptainName != null)
                            {
                                <h3 class="fx-group">Captains</h3>
                                <p class="fx-help">
                                    @f.HomeTeam: @(f.HomeCaptainName ?? "–")@(f.HomeViceCaptainName != null ? $" (VC {f.HomeViceCaptainName})" : "")<br />
                                    @f.AwayTeam: @(f.AwayCaptainName ?? "–")@(f.AwayViceCaptainName != null ? $" (VC {f.AwayViceCaptainName})" : "")
                                </p>
                            }

                            @if (!f.IsKnockout)
                            {
                                <h3 class="fx-group">Fairplay (1–10)</h3>
                                <div class="fx-form is-tight">
                                    <label class="fx-field"><span>@f.HomeTeam</span><input type="number" min="1" max="10" @bind="Vm.FairplayHomeRating" /></label>
                                    <label class="fx-field"><span>@f.AwayTeam</span><input type="number" min="1" max="10" @bind="Vm.FairplayAwayRating" /></label>
                                </div>
                                <button type="button" class="c-btn is-small" @onclick="Vm.SaveFairplay" disabled="@Vm.EditingLocked">Save ratings</button>
                            }

                            @if (Vm.IsSiteAdmin)
                            {
                                <h3 class="fx-group">True Man of the Match</h3>
                                <p class="fx-help">Admins only. Not shown to players, managers or referees.</p>
                                @if (Vm.TrueMotm == null || Vm.TrueMotm.Candidates.Count == 0)
                                {
                                    <p class="fx-help">Once each team has picked a Man of the Match, choose the real one here.</p>
                                }
                                else
                                {
                                    <div class="fx-motm-pick">
                                        @foreach (var c in Vm.TrueMotm.Candidates)
                                        {
                                            <button type="button" class="fx-chip @(Vm.TrueMotmSelection == c.PlayerId ? "is-active" : "")"
                                                    @onclick="() => Vm.TrueMotmSelection = c.PlayerId">@c.PlayerName <small>@c.TeamName</small></button>
                                        }
                                    </div>
                                    <div class="fx-links">
                                        <button type="button" class="c-btn is-small is-yellow" @onclick="Vm.SaveTrueMotm">Save winner</button>
                                        @if (Vm.TrueMotmSelection.HasValue)
                                        {
                                            <button type="button" class="c-btn is-small" @onclick="Vm.ClearTrueMotm">Clear</button>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Vm.TrueMotmMessage))
                                {
                                    <p class="fx-help">@Vm.TrueMotmMessage</p>
                                }
                            }
                        </details>
                    }
                </aside>
            </div>
        </div>

        @if (Vm.ConfirmingSwap)
        {
            <div class="fx-dialog-back" @onclick="() => Vm.ConfirmingSwap = false">
                <div class="fx-dialog" role="alertdialog" aria-modal="true" aria-labelledby="swap-title" @onclick:stopPropagation>
                    <h2 id="swap-title">🔄 Swap home and away?</h2>
                    <p class="fx-dialog-swap">
                        <span>@f.HomeTeam v @f.AwayTeam</span>
                        <span aria-hidden="true">⬇</span>
                        <strong>@f.AwayTeam v @f.HomeTeam</strong>
                    </p>
                    <ul>
                        <li><strong>@f.AwayTeam</strong> take over the setup: time, venue and referee. @f.HomeTeam can't change them any more.</li>
                        <li>The kickoff, venue and referee stay as they are until @f.AwayTeam change them.</li>
                        <li>Squads and captains stay with their own team.</li>
                        <li>@f.AwayTeam get a notification about it.</li>
                    </ul>
                    <div class="fx-dialog-foot">
                        <button type="button" class="c-btn" @onclick="() => Vm.ConfirmingSwap = false">Cancel</button>
                        <button type="button" class="c-btn is-yellow" disabled="@Vm.Busy" @onclick="Vm.SwapHomeAway">
                            @(Vm.Busy ? "Swapping…" : "Yes, swap them")
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    // The page's state and behaviour are in FixtureViewModel; only the
    // parameters and view helpers live here.

    [Parameter] public int Id { get; set; }

    // Lets a link open straight on a step: ?tab=setup, squad, stats (the
    // result) or pens. The manager's HQ uses squad and stats.
    [Parameter, SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    protected override Task OnInitializedAsync() => Vm.InitializeAsync(Id, Tab);

    private static string Join(IEnumerable<string> items, string none)
    {
        var list = items.ToList();
        return list.Count == 0 ? none : string.Join(", ", list);
    }

    private static string StatLine(int goals, int assists, int ownGoals, bool yellow, bool red)
    {
        var bits = new List<string>();
        if (goals > 0) bits.Add($"⚽{(goals > 1 ? $"×{goals}" : "")}");
        if (assists > 0) bits.Add($"🎯{(assists > 1 ? $"×{assists}" : "")}");
        if (ownGoals > 0) bits.Add("🙈");
        if (yellow) bits.Add("🟨");
        if (red) bits.Add("🟥");
        return bits.Count == 0 ? "–" : string.Join(" ", bits);
    }

    // A counter with its name written above it, so there's no guessing what it counts.
    private RenderFragment Stepper(string label, int value, Action<int> change) =>
        @<div class="fx-stepper-wrap @(value > 0 ? "has-value" : "")" role="group" aria-label="@label">
            <span class="fx-stepper-label">@label</span>
            <div class="fx-stepper">
                <button type="button" disabled="@(Vm.ReadOnly || value == 0)" aria-label="@($"One fewer {label.ToLower()}")" @onclick="() => change(-1)">−</button>
                <span class="fx-stepper-value" aria-live="polite">@value</span>
                <button type="button" disabled="@Vm.ReadOnly" aria-label="@($"One more {label.ToLower()}")" @onclick="() => change(1)">+</button>
            </div>
        </div>;
}
