@page "/admin/cards"
@using Ballers.Services
@using Ballers.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inherits ViewModelComponent<AdminCardsViewModel>


<PageTitle>Admin · Player cards</PageTitle>

@* How players earn card points, where the tiers start, sign-ups, and the
   payout. *@
<AdminShell Section="cards" Title="Player cards" Subtitle="How players earn points, where the tiers start, and the weekly payout.">
    <ChildContent>
        @if (Vm.Settings == null)
        {
            <LoadingSpinner />
        }
        else
        {
            <section class="adm-card">
                <div class="adm-rows">
                    <div class="adm-row">
                        <span class="adm-row-main">
                            <span class="adm-row-title">Player sign-up</span>
                            <span class="adm-row-sub">When closed, players can't create their own accounts. Existing ones are unaffected.</span>
                        </span>
                        <label class="adm-switch">
                            <input type="checkbox" role="switch" checked="@Vm.Settings.PlayerSignupEnabled" aria-label="Player sign-up"
                                   @onchange="e => { Vm.Settings.PlayerSignupEnabled = (bool)e.Value!; Vm.Dirty = true; }" />
                            <span></span>
                            <em>@(Vm.Settings.PlayerSignupEnabled ? "Open" : "Closed")</em>
                        </label>
                    </div>
                    <div class="adm-row">
                        <span class="adm-row-main">
                            <span class="adm-row-title">Payout</span>
                            <span class="adm-row-sub">
                                Runs weekly by itself. Running it now pays any played fixture not yet credited; it never pays twice.
                                @(Vm.Settings.LastPointsRunAt is { } last ? $"Last run {last.ToLocalTime():ddd d MMM, HH:mm}." : "It hasn't run yet.")
                            </span>
                        </span>
                        <button type="button" class="adm-btn" disabled="@Vm.Running" @onclick="Vm.RunPayout">@(Vm.Running ? "Running…" : "Run payout now")</button>
                    </div>
                </div>
            </section>

            <div class="adm-grid" style="margin-top:18px">
                <section class="adm-card">
                    <div class="adm-card-head">
                        <div>
                            <h2>Points per…</h2>
                            <p class="adm-card-sub">Paid to each player after every played fixture.</p>
                        </div>
                    </div>
                    @foreach (var f in Vm.EarnFields)
                    {
                        @Field(f)
                    }
                </section>

                <section class="adm-card">
                    <div class="adm-card-head">
                        <div>
                            <h2>Cards and tiers</h2>
                            <p class="adm-card-sub">A card's overall is the average of its six attributes.</p>
                        </div>
                    </div>
                    @foreach (var f in Vm.CardFields)
                    {
                        @Field(f)
                    }

                    @* A new card's overall is about the grant spread over six
                       attributes, so show where that lands against the tiers. *@
                    @{ var startOverall = Vm.Settings.SignupPointsGrant / 6; }
                    <div class="adm-msg @(startOverall >= Vm.Settings.SilverOverallThreshold ? "is-error" : "is-info")" style="margin-top:4px">
                        A new player starts around <strong>@startOverall</strong> overall:
                        @(startOverall >= Vm.Settings.GoldOverallThreshold ? "already gold."
                          : startOverall >= Vm.Settings.SilverOverallThreshold ? "already silver, so new cards skip bronze."
                          : $"bronze, {Vm.Settings.SilverOverallThreshold - startOverall} short of silver.")
                    </div>
                </section>
            </div>

            <div class="adm-toolbar" style="margin-top:18px;justify-content:flex-end">
                @if (Vm.Dirty)
                {
                    <span class="adm-muted" style="font-size:.85rem">Unsaved changes</span>
                }
                <button type="button" class="adm-btn is-primary" disabled="@(Vm.Saving || !Vm.Dirty)" @onclick="Vm.Save">
                    @(Vm.Saving ? "Saving…" : "Save changes")
                </button>
            </div>

            @if (Vm.Message != null)
            {
                <div class="adm-msg @(Vm.IsError ? "is-error" : "is-ok")">@Vm.Message</div>
            }
        }
    </ChildContent>
</AdminShell>

@code {
    // The settings and the payout are in AdminCardsViewModel.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    private RenderFragment Field(AdminCardsViewModel.NumberField f) =>
        @<div class="adm-row">
            <span class="adm-row-main">
                <span class="adm-row-title">@f.Label</span>
                <span class="adm-row-sub">@f.Hint</span>
            </span>
            <input class="adm-input" type="number" min="0" style="width:90px;text-align:right"
                   aria-label="@f.Label" value="@f.Get()"
                   @onchange="e => Vm.SetField(f, e.Value?.ToString())" />
        </div>;
}
