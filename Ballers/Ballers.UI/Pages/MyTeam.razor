@page "/my-team"
@attribute [Authorize(Roles = "Manager,Admin")]
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inherits ViewModelComponent<MyTeamViewModel>

<PageTitle>My Team</PageTitle>

<div class="my-team-page">
    @* The manager's own menu; admins and referees use this page too. *@
    <AuthorizeView Roles="Manager"><ManagerNav Current="team" /></AuthorizeView>


    @if (Vm.IsLoading)
    {
        <div class="my-team-loading"><LoadingSpinner /></div>
    }
    else if (Vm.TeamId == null)
    {
        <div class="my-team-error">
            <h2>No team assigned</h2>
            <p>Your account is not linked to a team. Contact an admin.</p>
        </div>
    }
    else
    {
        <div class="my-team-hero">
            <div class="my-team-hero-inner">
                <p class="my-team-eyebrow">Team Settings</p>
                <h1 class="my-team-title">@(Vm.Form.Name.Length > 0 ? Vm.Form.Name : "My Team")</h1>
            </div>
        </div>

        <div class="my-team-body">

            <!-- Profile image -->
            <div class="mt-card image-card">
                <h3>Club Crest / Photo</h3>
                <div class="image-section">
                    <div class="current-image-wrap">
                        @if (!string.IsNullOrEmpty(Vm.CurrentImageUrl))
                        {
                            <img class="current-image"
                                 src="@(Http.BaseAddress!.ToString().TrimEnd('/') + Vm.CurrentImageUrl)"
                                 alt="Club image" />
                        }
                        else
                        {
                            <div class="image-placeholder">
                                <span>@Format.TeamInitials(Vm.Form.Name)</span>
                            </div>
                        }
                    </div>
                    <div class="image-upload-area">
                        <p class="upload-hint">JPEG, PNG or WebP · Max 5 MB<br />Images are checked for inappropriate content before saving.</p>
                        <InputFile OnChange="OnImageSelected" accept="image/jpeg,image/png,image/webp" class="file-input" id="imageInput" />
                        <label for="imageInput" class="upload-btn @(Vm.IsUploadingImage ? "uploading" : "")">
                            @(Vm.IsUploadingImage ? "Uploading…" : "Choose image")
                        </label>
                        @if (!string.IsNullOrEmpty(Vm.ImageError))
                        {
                            <p class="field-error">@Vm.ImageError</p>
                        }
                        @if (Vm.ImageSuccess)
                        {
                            <p class="field-success">Image updated.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Profile form -->
            <div class="mt-card">
                <h3>Club Details</h3>
                <div class="mt-form">

                    <div class="field-group">
                        <label>Team Name</label>
                        <input type="text" @bind="Vm.Form.Name" @bind:event="oninput" placeholder="e.g. Riverside FC" maxlength="80" />
                    </div>

                    <div class="field-group">
                        <label>Manager Name</label>
                        <input type="text" @bind="Vm.Form.ManagerName" placeholder="e.g. John Smith" maxlength="80" />
                    </div>

                    <div class="field-row">
                        <div class="field-group">
                            <label>Year Founded</label>
                            <input type="number" @bind="Vm.Form.YearFormed" placeholder="e.g. 2018" min="1800" max="2100" />
                        </div>
                        <div class="field-group">
                            <label>Contact Number</label>
                            <input type="tel" @bind="Vm.Form.PhoneNumber" placeholder="e.g. 07700 900000" maxlength="20" />
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field-group">
                            <label>Home Kit Colour</label>
                            <div class="kit-colour-input">
                                <input type="color" @bind="Vm.Form.HomeKitColour" />
                                <span class="kit-colour-hex">@(Vm.Form.HomeKitColour ?? "—")</span>
                                @if (!string.IsNullOrEmpty(Vm.Form.HomeKitColour))
                                {
                                    <button type="button" class="kit-colour-clear" @onclick="() => Vm.Form.HomeKitColour = null" title="Clear home kit colour">✕</button>
                                }
                            </div>
                        </div>
                        <div class="field-group">
                            <label>Away Kit Colour</label>
                            <div class="kit-colour-input">
                                <input type="color" @bind="Vm.Form.AwayKitColour" />
                                <span class="kit-colour-hex">@(Vm.Form.AwayKitColour ?? "—")</span>
                                @if (!string.IsNullOrEmpty(Vm.Form.AwayKitColour))
                                {
                                    <button type="button" class="kit-colour-clear" @onclick="() => Vm.Form.AwayKitColour = null" title="Clear away kit colour">✕</button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="field-group">
                        <label>About the Club</label>
                        <textarea @bind="Vm.Form.Bio" placeholder="Tell people about your team — how you formed, your ambitions, who can join…" rows="5" maxlength="1000"></textarea>
                        <span class="char-count">@((Vm.Form.Bio?.Length ?? 0)) / 1000</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Vm.SaveError))
                    {
                        <p class="field-error">@Vm.SaveError</p>
                    }
                    @if (Vm.SaveSuccess)
                    {
                        <p class="field-success">Profile saved.</p>
                    }

                    <button class="save-btn @(Vm.IsSaving ? "saving" : "")" @onclick="Vm.Save" disabled="@Vm.IsSaving">
                        @(Vm.IsSaving ? "Saving…" : "Vm.Save Profile")
                    </button>
                </div>
            </div>

            <!-- Manager photo -->
            <div class="mt-card image-card">
                <h3>Manager Photo</h3>
                <p class="upload-hint">Shown on the manager card on your team page. The card upgrades bronze → silver (3 wins) → gold (6 wins) automatically. Leave the manager name blank to hide the card entirely.</p>
                <div class="image-section">
                    <div class="current-image-wrap">
                        @if (!string.IsNullOrEmpty(Vm.ManagerImageBase64))
                        {
                            <img class="current-image" src="@Vm.ManagerImageBase64" alt="Manager photo" />
                        }
                        else
                        {
                            <div class="image-placeholder">
                                <span>@Format.TeamInitials(Vm.Form.ManagerName ?? "")</span>
                            </div>
                        }
                    </div>
                    <div class="image-upload-area">
                        <p class="upload-hint">Crop, position and remove the background — same as player photos.</p>
                        <button type="button" class="upload-btn" @onclick="() => Vm.ShowManagerCrop = true">
                            @(string.IsNullOrEmpty(Vm.ManagerImageBase64) ? "Choose image" : "Change photo")
                        </button>
                        @if (Vm.ManagerImageSuccess)
                        {
                            <p class="field-success">Manager photo updated.</p>
                        }
                    </div>
                </div>
            </div>

        </div>

        <ImageCropModal IsVisible="Vm.ShowManagerCrop"
                        Name="@(Vm.Form.ManagerName ?? "Manager")"
                        Number="Vm.ManagerWins"
                        Position="MGR"
                        SaveOverride="Vm.SaveManagerImage"
                        OnClose="@(() => Vm.ShowManagerCrop = false)"
                        OnSaved="@(() => { Vm.ManagerImageSuccess = true; Vm.ShowManagerCrop = false; })" />
    }

</div>

@code {
    // The profile and its uploads are in MyTeamViewModel.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    private Task OnImageSelected(InputFileChangeEventArgs e) => Vm.UploadCrest(e.File);
}
