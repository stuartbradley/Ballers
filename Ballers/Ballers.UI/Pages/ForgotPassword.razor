@page "/forgot-password"
@using Ballers.Client.Auth
@using Ballers.Client.Models
@inject AuthService Auth

<PageTitle>Forgot Password</PageTitle>

<div class="login-page">

    <div class="login-left">
        <div class="login-card">

            <h1>Forgot Password</h1>
            <p class="subtitle">Enter your email and we'll send a reset link</p>

            @if (sent)
            {
                <div class="login-error" style="background:#d4edda;color:#155724;border-color:#c3e6cb;">
                    If that email is registered, a reset link has been sent.
                </div>
                <div style="margin-top:1rem;text-align:center;">
                    <a href="/login">Back to Login</a>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" @bind="email" @onkeydown="OnKeyDown" placeholder="manager@team.com" />
                </div>

                <button class="login-btn" @onclick="HandleSubmit" disabled="@busy">
                    @(busy ? "Sending..." : "Send Reset Link")
                </button>

                <div style="margin-top:1rem;text-align:center;">
                    <a href="/login">Back to Login</a>
                </div>
            }

        </div>
    </div>

    <div class="login-right">
        <div class="login-right-bg"></div>
        <div class="branding">
            <div class="brand-wordmark">
                <span class="brand-the">Blackpool</span>
                <span class="brand-name">Ballers</span>
                <span class="brand-league">League</span>
            </div>
            <p class="brand-tagline">Blackpool's Premier 11-a-Side Competition</p>
        </div>
    </div>

</div>

@code {
    string? email;
    bool busy;
    bool sent;

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSubmit();
    }

    async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(email)) return;
        busy = true;
        await Auth.ForgotPassword(new ForgotPasswordRequest { Email = email });
        busy = false;
        sent = true;
    }
}
