@page "/gallery/{Id:int}"
@using Ballers.Shared
@using Ballers.Services
@using Ballers.UI.Infrastructure
@implements IAsyncDisposable

@inject GalleryService GalleryService
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>@(gallery?.Title ?? (gallery != null ? $"{gallery.HomeTeam} v {gallery.AwayTeam} photos" : "Gallery"))</PageTitle>

<div class="gal-page">

    @if (isLoading)
    {
        <div class="gal-loading"><LoadingSpinner /></div>
    }
    else if (gallery == null)
    {
        <div class="gal-error">
            <p>That gallery doesn't exist, or isn't published yet.</p>
            <a href="/galleries" class="gal-back-link">← All galleries</a>
        </div>
    }
    else
    {
        <!-- ── Fixture header, over the gallery's cover photo ── -->
        <header class="gal-hero">
            @if (CoverUrl is { } cover)
            {
                <img class="gal-hero-bg" src="@cover" alt="" aria-hidden="true" decoding="async" />
            }
            <span class="gal-hero-shade" aria-hidden="true"></span>

            <div class="gal-hero-inner">
                <div class="gal-hero-top">
                    <a href="/galleries" class="gal-back-link">← All galleries</a>
                    <button type="button" class="gal-share" @onclick="Share">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm12 7a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                        @(shareLabel ?? "Share")
                    </button>
                </div>

                <span class="gal-week">Match Week @gallery.Week</span>

                <h1 class="gal-fixture">
                    <span class="gal-team">@gallery.HomeTeam</span>
                    @if (gallery.IsPlayed)
                    {
                        <span class="gal-score">@gallery.HomeScore<span class="gal-score-sep">–</span>@gallery.AwayScore</span>
                    }
                    else
                    {
                        <span class="gal-vs">v</span>
                    }
                    <span class="gal-team">@gallery.AwayTeam</span>
                </h1>

                <div class="gal-meta">
                    @if (gallery.Kickoff.HasValue)
                    {
                        <span>@gallery.Kickoff.Value.ToString("dddd d MMMM yyyy")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(gallery.Location))
                    {
                        <span>@gallery.Location</span>
                    }
                    <span>@gallery.PhotoCount photos</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(gallery.Description))
                {
                    <p class="gal-description">@gallery.Description</p>
                }
            </div>
        </header>

        <!-- ── Photographer credit ── -->
        @if (gallery.Photographer is { } photographer)
        {
            <section class="gal-credit">
                <div class="gal-credit-inner">
                    @if (!string.IsNullOrWhiteSpace(photographer.LogoUrl))
                    {
                        <img class="gal-credit-logo" src="@Abs(photographer.LogoUrl)" alt="@photographer.Name" />
                    }

                    <div class="gal-credit-text">
                        <p class="gal-credit-label">Photos by</p>
                        <h2 class="gal-credit-name">@photographer.Name</h2>

                        @if (!string.IsNullOrWhiteSpace(photographer.Bio))
                        {
                            <p class="gal-credit-bio">@photographer.Bio</p>
                        }
                    </div>

                    <div class="gal-credit-links">
                        @if (!string.IsNullOrWhiteSpace(photographer.Website))
                        {
                            <a href="@Href(photographer.Website)" target="_blank" rel="noopener noreferrer">Website</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(photographer.Instagram))
                        {
                            <a href="@Href(photographer.Instagram)" target="_blank" rel="noopener noreferrer">Instagram</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(photographer.Facebook))
                        {
                            <a href="@Href(photographer.Facebook)" target="_blank" rel="noopener noreferrer">Facebook</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(photographer.Email))
                        {
                            <a href="mailto:@photographer.Email">Email</a>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- ── Photos ── -->
        <div class="gal-body">
            @if (!photos.Any() && !isLoadingMore)
            {
                <p class="gal-empty">No photos in this gallery yet.</p>
            }

            @* Justified rows: every photo keeps its own shape, and each row
               stretches to the full width (see .gal-rows). *@
            <div class="gal-rows">
                @foreach (var (photo, index) in photos.Select((p, i) => (p, i)))
                {
                    var ratio = Ratio(photo);
                    <button class="gal-tile"
                            style="--r: @ratio.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                            @onclick="() => OpenLightbox(index)"
                            aria-label="Open photo @(index + 1)">
                        <img src="@Abs(photo.ThumbnailUrl)"
                             srcset="@MediaUrls.SrcSet(Http, photo.ThumbnailUrl, photo.ImageUrl)"
                             sizes="@TileSizes(ratio)"
                             width="@photo.Width" height="@photo.Height"
                             alt="Match photo @(index + 1)"
                             loading="lazy" decoding="async" />
                    </button>
                }
            </div>

            @if (isLoadingMore)
            {
                <div class="gal-loading-more">Loading more photos…</div>
            }

            <!-- Watched by IntersectionObserver to pull the next page. -->
            <div id="@SentinelId" class="gal-sentinel"></div>

            <!-- ── The galleries either side of this one ── -->
            @if (Newer != null || Older != null)
            {
                <nav class="gal-neighbours" aria-label="Other galleries">
                    @foreach (var (g, label, cls) in new[] { (Older, "Previous match", "is-prev"), (Newer, "Next match", "is-next") })
                    {
                        if (g == null)
                        {
                            <span class="gal-neighbour-gap"></span>
                            continue;
                        }
                        <a class="gal-neighbour @cls" href="/gallery/@g.Id">
                            @if (!string.IsNullOrEmpty(g.CoverThumbnailUrl))
                            {
                                <img src="@Abs(g.CoverThumbnailUrl)" alt="" loading="lazy" decoding="async" />
                            }
                            <span class="gal-neighbour-shade" aria-hidden="true"></span>
                            <span class="gal-neighbour-body">
                                <span class="gal-neighbour-label">@(cls == "is-prev" ? "← " : "")@label@(cls == "is-next" ? " →" : "")</span>
                                <span class="gal-neighbour-fixture">@g.HomeTeam @(g.IsPlayed ? $"{g.HomeScore}–{g.AwayScore}" : "v") @g.AwayTeam</span>
                                <span class="gal-neighbour-meta">Match Week @g.Week · @g.PhotoCount photos</span>
                            </span>
                        </a>
                    }
                </nav>
            }
        </div>

        <!-- ── Lightbox ── -->
        @if (lightboxIndex is { } current && current < photos.Count)
        {
            var photo = photos[current];

            <div class="gal-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer"
                 tabindex="-1" @ref="lightboxRef"
                 @onclick="CloseLightbox" @onkeydown="OnLightboxKey"
                 @ontouchstart="OnTouchStart" @ontouchend="OnTouchEnd">

                <div class="gal-lb-bar" @onclick:stopPropagation>
                    <span class="gal-lb-counter">@(current + 1) / @gallery.PhotoCount</span>
                    <div class="gal-lb-tools">
                        <button type="button" class="gal-lb-btn" @onclick="DownloadCurrent" aria-label="Download full-size photo">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M4 19h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            <span>Download</span>
                        </button>
                        <button type="button" class="gal-lb-btn gal-lb-close" @onclick="CloseLightbox" aria-label="Close">✕</button>
                    </div>
                </div>

                <div class="gal-lb-stage">
                    @if (current > 0)
                    {
                        <button class="gal-lightbox-nav prev"
                                @onclick="ShowPrevious" @onclick:stopPropagation
                                aria-label="Previous photo">‹</button>
                    }

                    @* Keyed so each photo fades in rather than swapping in place. *@
                    <img class="gal-lightbox-image" @key="photo.Id"
                         src="@Abs(photo.ImageUrl)"
                         alt="Match photo @(current + 1)"
                         @onclick:stopPropagation />

                    @if (current < photos.Count - 1)
                    {
                        <button class="gal-lightbox-nav next"
                                @onclick="ShowNext" @onclick:stopPropagation
                                aria-label="Next photo">›</button>
                    }
                </div>

                <div class="gal-lb-thumbs" id="gal-thumbs" @onclick:stopPropagation>
                    @foreach (var (p, i) in photos.Select((p, i) => (p, i)))
                    {
                        <button type="button" class="gal-lb-thumb @(i == current ? "is-active" : "")"
                                aria-label="Photo @(i + 1)" aria-current="@(i == current ? "true" : null)"
                                @onclick="() => ShowAt(i)">
                            <img src="@Abs(p.ThumbnailUrl)" alt="" loading="lazy" decoding="async" />
                        </button>
                    }
                </div>

                @* The next photo, loading out of sight, so stepping on is instant. *@
                @if (current + 1 < photos.Count)
                {
                    <img class="gal-preload" src="@Abs(photos[current + 1].ImageUrl)" alt="" aria-hidden="true" />
                }
            </div>
        }
    }

</div>

@code {
    [Parameter] public int Id { get; set; }

    private const int PageSize = 40;

    private GalleryDetailDto? gallery;
    private readonly List<GalleryPhotoDto> photos = new();
    private List<GallerySummaryDto> allGalleries = new();   // newest first

    private bool isLoading = true;
    private bool isLoadingMore;
    private bool hasMore = true;
    private int? lightboxIndex;
    private string? shareLabel;

    private ElementReference lightboxRef;
    private bool focusLightbox;
    private bool centreThumb;

    private DotNetObjectReference<Gallery>? selfRef;
    private bool observerAttached;
    private string? attachedSentinel;

    private string SentinelId => $"gal-sentinel-{Id}";

    private GallerySummaryDto? Summary => allGalleries.FirstOrDefault(g => g.Id == Id);

    private int SummaryIndex => allGalleries.FindIndex(g => g.Id == Id);
    private GallerySummaryDto? Newer => SummaryIndex > 0 ? allGalleries[SummaryIndex - 1] : null;
    private GallerySummaryDto? Older => SummaryIndex >= 0 && SummaryIndex < allGalleries.Count - 1 ? allGalleries[SummaryIndex + 1] : null;

    // The gallery's chosen cover, or its first photo when it has none listed.
    private string? CoverUrl =>
        Abs(Summary?.CoverImageUrl ?? Summary?.CoverThumbnailUrl ?? photos.FirstOrDefault()?.ImageUrl);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        photos.Clear();
        hasMore = true;
        lightboxIndex = null;
        shareLabel = null;

        // A new gallery (the next/previous links) means a new sentinel to
        // watch. Id has already changed, so the old one goes by its saved name.
        if (attachedSentinel != null)
        {
            try { await JS.InvokeVoidAsync("galleryScroll.disconnect", attachedSentinel); } catch (JSException) { }
            attachedSentinel = null;
            observerAttached = false;
        }

        var galleryTask = GalleryService.GetGallery(Id);
        var listTask = allGalleries.Any() ? Task.FromResult(allGalleries) : GalleryService.GetGalleries();
        await Task.WhenAll(galleryTask, listTask);

        gallery = galleryTask.Result;
        allGalleries = listTask.Result;

        if (gallery != null)
        {
            await LoadNextPageAsync();
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusLightbox)
        {
            focusLightbox = false;
            try { await lightboxRef.FocusAsync(); } catch (JSException) { } catch (InvalidOperationException) { }
        }

        if (centreThumb)
        {
            centreThumb = false;
            try { await JS.InvokeVoidAsync("galleryScroll.centreThumb", "gal-thumbs"); } catch (JSException) { }
        }

        // The sentinel only exists once the gallery has rendered.
        if (gallery == null || observerAttached) return;

        selfRef ??= DotNetObjectReference.Create(this);

        try
        {
            var attached = await JS.InvokeAsync<bool>("galleryScroll.observe", SentinelId, selfRef);
            observerAttached = attached;
            if (attached) attachedSentinel = SentinelId;
        }
        catch (JSException)
        {
            // Without the observer the gallery still works, it just stops after
            // the first page rather than loading on scroll.
        }
    }

    [JSInvokable]
    public async Task LoadMoreAsync()
    {
        if (!hasMore || isLoadingMore) return;

        await LoadNextPageAsync();
        StateHasChanged();
    }

    private async Task LoadNextPageAsync()
    {
        if (!hasMore || isLoadingMore) return;

        isLoadingMore = true;
        StateHasChanged();

        var page = await GalleryService.GetPhotos(Id, photos.Count, PageSize);

        photos.AddRange(page.Photos);
        hasMore = page.HasMore;

        isLoadingMore = false;
    }

    /// <summary>
    /// Width over height. Photos missing their size are drawn as 3:2, the
    /// usual camera shape, and extreme panoramas are capped so a row can hold them.
    /// </summary>
    private static double Ratio(GalleryPhotoDto photo) =>
        photo.Width > 0 && photo.Height > 0
            ? Math.Clamp((double)photo.Width / photo.Height, 0.4, 3.5)
            : 1.5;

    /// <summary>
    /// Roughly how wide a tile is drawn: its shape times the row height, plus
    /// some for the stretch that fills each row. The browser uses it to choose
    /// between the thumbnail and the full-size image.
    /// </summary>
    private static string TileSizes(double ratio) =>
        $"(max-width: 640px) {Math.Round(ratio * 190)}px, {Math.Round(ratio * 320)}px";

    // ── Lightbox ──

    private void OpenLightbox(int index)
    {
        lightboxIndex = index;
        focusLightbox = true;
        centreThumb = true;
    }

    private void CloseLightbox() => lightboxIndex = null;

    private void ShowAt(int index)
    {
        if (index < 0 || index >= photos.Count) return;
        lightboxIndex = index;
        centreThumb = true;
    }

    private void ShowPrevious()
    {
        if (lightboxIndex is > 0) ShowAt(lightboxIndex.Value - 1);
    }

    private async Task ShowNext()
    {
        if (lightboxIndex is not { } current) return;

        // Stepping onto the last loaded photo pulls the next page in, so paging
        // through the lightbox keeps working past the first chunk.
        if (current >= photos.Count - 2 && hasMore) await LoadNextPageAsync();

        if (current < photos.Count - 1) ShowAt(current + 1);
    }

    private Task OnLightboxKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowLeft": ShowPrevious(); break;
            case "ArrowRight": return ShowNext();
            case "Escape": CloseLightbox(); break;
        }
        return Task.CompletedTask;
    }

    // A sideways swipe steps through the photos; mostly-vertical movement is
    // left alone.
    private double touchX, touchY;

    private void OnTouchStart(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return;
        touchX = e.ChangedTouches[0].ClientX;
        touchY = e.ChangedTouches[0].ClientY;
    }

    private Task OnTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return Task.CompletedTask;
        var dx = e.ChangedTouches[0].ClientX - touchX;
        var dy = e.ChangedTouches[0].ClientY - touchY;
        if (Math.Abs(dx) < 50 || Math.Abs(dx) < Math.Abs(dy) * 1.5) return Task.CompletedTask;
        if (dx > 0) { ShowPrevious(); return Task.CompletedTask; }
        return ShowNext();
    }

    private async Task DownloadCurrent()
    {
        if (gallery == null || lightboxIndex is not { } i || i >= photos.Count) return;
        var name = $"ballers-mw{gallery.Week}-{Slug(gallery.HomeTeam)}-v-{Slug(gallery.AwayTeam)}-{i + 1}.jpg";
        try { await JS.InvokeVoidAsync("galleryScroll.download", Abs(photos[i].ImageUrl), name); }
        catch (JSException) { }
    }

    private static string Slug(string s) =>
        new string(s.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');

    private async Task Share()
    {
        if (gallery == null) return;
        var title = $"{gallery.HomeTeam} v {gallery.AwayTeam} — Match Week {gallery.Week} photos";
        string result;
        try { result = await JS.InvokeAsync<string>("galleryScroll.share", title, Nav.Uri); }
        catch (JSException) { result = "failed"; }

        shareLabel = result switch
        {
            "copied" => "Link copied",
            "failed" => "Couldn't share",
            _ => null
        };
        if (shareLabel == null) return;

        StateHasChanged();
        await Task.Delay(2500);
        shareLabel = null;
    }

    private string? Abs(string? url) => MediaUrls.Absolute(Http, url);

    /// <summary>Photographers rarely type the scheme, and a bare domain would resolve relative to this site.</summary>
    private static string Href(string url)
        => url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
           url.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? url
            : $"https://{url}";

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("galleryScroll.disconnect", attachedSentinel ?? SentinelId);
        }
        catch (JSException) { }
        catch (TaskCanceledException) { }

        selfRef?.Dispose();
    }
}
