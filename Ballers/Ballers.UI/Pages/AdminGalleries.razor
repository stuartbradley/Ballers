@page "/admin/galleries"
@using Ballers.Models
@using Ballers.Shared
@using Ballers.Services
@using Ballers.UI.Infrastructure
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Admin")]

@inject GalleryService GalleryService
@inject FixtureService FixtureService
@inject HttpClient Http

<PageTitle>Galleries — Admin</PageTitle>

<div class="ag-page">

    <div class="ag-hero">
        <div class="ag-hero-inner">
            <div class="hero-top">
                <p class="ag-eyebrow">Admin</p>
                <a href="/admin" class="back-link">← Back to Admin</a>
            </div>
            <h1>Match Galleries</h1>
        </div>
    </div>

    <div class="ag-body">

        @if (isLoading)
        {
            <LoadingSpinner />
        }
        else
        {
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="ag-message @(messageIsError ? "error" : "")">@message</div>
            }

            <!-- ── Photographers ── -->
            <section class="ag-card">
                <h2>Photographers</h2>
                <p class="ag-hint">
                    Created once and reused. Updating a link here updates every gallery that credits them.
                </p>

                <div class="ag-form-grid">
                    <label>Name<input @bind="photographerForm.Name" placeholder="Paul Keeling Photography" /></label>
                    <label>Website<input @bind="photographerForm.Website" placeholder="paulkeelingphotography.com" /></label>
                    <label>Instagram<input @bind="photographerForm.Instagram" placeholder="instagram.com/…" /></label>
                    <label>Facebook<input @bind="photographerForm.Facebook" placeholder="facebook.com/…" /></label>
                    <label>Email<input @bind="photographerForm.Email" placeholder="hello@example.com" /></label>
                    <label>Logo URL<input @bind="photographerForm.LogoUrl" placeholder="/uploads/…" /></label>
                    <label class="ag-span-2">Bio<textarea @bind="photographerForm.Bio" rows="2"></textarea></label>
                </div>

                <div class="ag-actions">
                    <button class="ag-btn primary" @onclick="SavePhotographer">
                        @(editingPhotographerId is null ? "Add photographer" : "Save changes")
                    </button>
                    @if (editingPhotographerId is not null)
                    {
                        <button class="ag-btn" @onclick="CancelPhotographerEdit">Cancel</button>
                    }
                </div>

                @if (photographers.Any())
                {
                    <ul class="ag-list">
                        @foreach (var p in photographers)
                        {
                            <li>
                                <span class="ag-list-name">@p.Name</span>
                                <span class="ag-list-meta">@p.Website</span>
                                <span class="ag-list-actions">
                                    <button class="ag-link" @onclick="() => EditPhotographer(p)">Edit</button>
                                    <button class="ag-link danger" @onclick="() => DeletePhotographer(p)">Delete</button>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <!-- ── Create a gallery ── -->
            <section class="ag-card">
                <h2>New gallery</h2>
                <p class="ag-hint">One gallery per fixture. Fixtures that already have one aren't listed.</p>

                @if (!availableFixtures.Any())
                {
                    <p class="ag-empty">Every fixture already has a gallery.</p>
                }
                else
                {
                    <div class="ag-form-grid">
                        <label class="ag-span-2">
                            Fixture
                            <select @bind="newGalleryFixtureId">
                                <option value="0">— choose a fixture —</option>
                                @foreach (var f in availableFixtures)
                                {
                                    <option value="@f.Id">@FixtureLabel(f)</option>
                                }
                            </select>
                        </label>

                        <label>
                            Photographer
                            <select @bind="newGalleryPhotographerId">
                                <option value="0">— none —</option>
                                @foreach (var p in photographers)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </label>

                        <label>Title (optional)<input @bind="newGalleryTitle" placeholder="Opening day" /></label>
                        <label class="ag-span-2">Description (optional)<textarea @bind="newGalleryDescription" rows="2"></textarea></label>
                    </div>

                    <div class="ag-actions">
                        <button class="ag-btn primary" @onclick="CreateGallery">Create gallery</button>
                    </div>
                }
            </section>

            <!-- ── Existing galleries ── -->
            <section class="ag-card">
                <h2>Galleries</h2>

                @if (!galleries.Any())
                {
                    <p class="ag-empty">No galleries yet.</p>
                }
                else
                {
                    @foreach (var g in galleries)
                    {
                        <div class="ag-gallery">
                            <div class="ag-gallery-head">
                                @if (!string.IsNullOrEmpty(g.CoverThumbnailUrl))
                                {
                                    <img class="ag-gallery-cover" src="@Abs(g.CoverThumbnailUrl)" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <div class="ag-gallery-cover empty">No photos</div>
                                }

                                <div class="ag-gallery-info">
                                    <div class="ag-gallery-title">
                                        @g.HomeTeam v @g.AwayTeam
                                        @if (!g.IsPublished)
                                        {
                                            <span class="ag-badge">Hidden</span>
                                        }
                                    </div>
                                    <div class="ag-gallery-meta">
                                        Week @g.Week ·
                                        @(g.Kickoff?.ToString("d MMM yyyy") ?? "no date") ·
                                        @g.PhotoCount photos
                                        @if (!string.IsNullOrEmpty(g.PhotographerName))
                                        {
                                            <text> · @g.PhotographerName</text>
                                        }
                                    </div>
                                </div>

                                <div class="ag-gallery-actions">
                                    <a class="ag-link" href="/gallery/@g.Id">View</a>
                                    @* Which fixture a gallery is attached to decides where the
                                       "View match photos" button shows up, so link straight to it. *@
                                    <a class="ag-link" href="/fixture/@g.FixtureId">Fixture</a>
                                    <button class="ag-link" @onclick="() => TogglePublished(g)">
                                        @(g.IsPublished ? "Hide" : "Publish")
                                    </button>
                                    @* Uploads sort themselves, but this fixes galleries
                                       added before that, without re-uploading. *@
                                    <button class="ag-link" @onclick="() => Resort(g)">Sort by filename</button>
                                    <button class="ag-link danger" @onclick="() => DeleteGallery(g)">Delete</button>
                                </div>
                            </div>

                            <div class="ag-upload">
                                <InputFile OnChange="e => OnFilesSelected(e, g.Id)" multiple accept="image/*" />

                                @if (uploadingGalleryId == g.Id)
                                {
                                    <span class="ag-upload-status">
                                        Uploading @uploadedCount of @uploadTotal…
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
            </section>
        }

    </div>

</div>

@code {
    private bool isLoading = true;
    private string? message;
    private bool messageIsError;

    private List<GallerySummaryDto> galleries = new();
    private List<PhotographerDto> photographers = new();
    private List<FixtureDto> allFixtures = new();

    private PhotographerDto photographerForm = new();
    private int? editingPhotographerId;

    private int newGalleryFixtureId;
    private int newGalleryPhotographerId;
    private string? newGalleryTitle;
    private string? newGalleryDescription;

    private int? uploadingGalleryId;
    private int uploadedCount;
    private int uploadTotal;

    // Photos go up in small batches. Sending a whole 200-photo gallery in one
    // request would blow past the server's request size limit and give no
    // feedback until it finished.
    private const int UploadBatchSize = 5;
    private const long MaxFileBytes = 15 * 1024 * 1024;

    private List<FixtureDto> availableFixtures =>
        allFixtures.Where(f => galleries.All(g => g.FixtureId != f.Id)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        allFixtures = await FixtureService.GetFixtures();
        isLoading = false;
    }

    private async Task ReloadAsync()
    {
        galleries = await GalleryService.GetGalleries();
        photographers = await GalleryService.GetPhotographers();
    }

    private static string FixtureLabel(FixtureDto f)
        => $"Week {f.Week} — {f.HomeTeam} v {f.AwayTeam}" +
           (f.KickOff.HasValue ? $" ({f.KickOff.Value:d MMM yyyy})" : "");

    // ── Photographers ──

    private async Task SavePhotographer()
    {
        if (string.IsNullOrWhiteSpace(photographerForm.Name))
        {
            Show("A photographer needs a name.", error: true);
            return;
        }

        var ok = editingPhotographerId is { } id
            ? await GalleryService.UpdatePhotographer(id, photographerForm)
            : await GalleryService.CreatePhotographer(photographerForm) is not null;

        if (!ok)
        {
            Show("Could not save that photographer.", error: true);
            return;
        }

        photographerForm = new PhotographerDto();
        editingPhotographerId = null;
        await ReloadAsync();
        Show("Photographer saved.");
    }

    private void EditPhotographer(PhotographerDto p)
    {
        editingPhotographerId = p.Id;
        photographerForm = new PhotographerDto
        {
            Name = p.Name,
            Website = p.Website,
            Instagram = p.Instagram,
            Facebook = p.Facebook,
            Email = p.Email,
            Bio = p.Bio,
            LogoUrl = p.LogoUrl
        };
    }

    private void CancelPhotographerEdit()
    {
        editingPhotographerId = null;
        photographerForm = new PhotographerDto();
    }

    private async Task DeletePhotographer(PhotographerDto p)
    {
        if (!await GalleryService.DeletePhotographer(p.Id))
        {
            Show("Could not delete that photographer.", error: true);
            return;
        }

        await ReloadAsync();
        Show($"{p.Name} removed. Their galleries are still there, just uncredited.");
    }

    // ── Galleries ──

    private async Task CreateGallery()
    {
        if (newGalleryFixtureId == 0)
        {
            Show("Choose a fixture first.", error: true);
            return;
        }

        var request = new SaveGalleryRequest
        {
            FixtureId = newGalleryFixtureId,
            PhotographerId = newGalleryPhotographerId == 0 ? null : newGalleryPhotographerId,
            Title = string.IsNullOrWhiteSpace(newGalleryTitle) ? null : newGalleryTitle,
            Description = string.IsNullOrWhiteSpace(newGalleryDescription) ? null : newGalleryDescription,
            IsPublished = true
        };

        if (await GalleryService.CreateGallery(request) is null)
        {
            Show("Could not create that gallery.", error: true);
            return;
        }

        newGalleryFixtureId = 0;
        newGalleryPhotographerId = 0;
        newGalleryTitle = null;
        newGalleryDescription = null;

        await ReloadAsync();
        Show("Gallery created — add photos to it below.");
    }

    private async Task TogglePublished(GallerySummaryDto g)
    {
        var request = new SaveGalleryRequest
        {
            FixtureId = g.FixtureId,
            Title = g.Title,
            IsPublished = !g.IsPublished
        };

        if (!await GalleryService.UpdateGallery(g.Id, request))
        {
            Show("Could not change that gallery.", error: true);
            return;
        }

        await ReloadAsync();
    }

    private async Task Resort(GallerySummaryDto g)
    {
        if (!await GalleryService.ResortGallery(g.Id))
        {
            Show("Could not reorder that gallery.", error: true);
            return;
        }

        await ReloadAsync();
        Show($"{g.HomeTeam} v {g.AwayTeam} is back in filename order.");
    }

    private async Task DeleteGallery(GallerySummaryDto g)
    {
        if (!await GalleryService.DeleteGallery(g.Id))
        {
            Show("Could not delete that gallery.", error: true);
            return;
        }

        await ReloadAsync();
        Show("Gallery deleted.");
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e, int galleryId)
    {
        var files = e.GetMultipleFiles(1000);
        if (files.Count == 0) return;

        uploadingGalleryId = galleryId;
        uploadedCount = 0;
        uploadTotal = files.Count;
        var problems = new List<string>();

        foreach (var batch in files.Chunk(UploadBatchSize))
        {
            using var content = new MultipartFormDataContent();

            foreach (var file in batch)
            {
                if (file.Size > MaxFileBytes)
                {
                    problems.Add($"{file.Name} is over 15 MB");
                    continue;
                }

                var stream = file.OpenReadStream(MaxFileBytes);
                var streamContent = new StreamContent(stream);
                streamContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "files", file.Name);
            }

            var result = await GalleryService.UploadPhotos(galleryId, content);
            problems.AddRange(result.Rejected);

            uploadedCount += batch.Length;
            StateHasChanged();
        }

        uploadingGalleryId = null;
        await ReloadAsync();

        Show(problems.Count == 0
            ? $"Uploaded {uploadTotal} photos."
            : $"Uploaded with {problems.Count} problem(s): {string.Join("; ", problems.Take(3))}",
            error: problems.Count > 0);
    }

    private void Show(string text, bool error = false)
    {
        message = text;
        messageIsError = error;
    }

    private string? Abs(string? url) => MediaUrls.Absolute(Http, url);
}
