@page "/admin/galleries"
@using Ballers.Models
@using Ballers.Shared
@using Ballers.Services
@using Ballers.UI.Infrastructure
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Admin")]

@inject HttpClient Http
@inherits ViewModelComponent<AdminGalleriesViewModel>

<PageTitle>Galleries — Admin</PageTitle>

<AdminShell Section="galleries" Title="Galleries" Subtitle="Match photo galleries: create one for a fixture, upload photos, publish or hide it.">
    <ChildContent>
<div class="ag-page">

    <div class="ag-body">

        @if (Vm.IsLoading)
        {
            <LoadingSpinner />
        }
        else
        {
            @if (!string.IsNullOrEmpty(Vm.Message))
            {
                <div class="ag-message @(Vm.MessageIsError ? "error" : "")">@Vm.Message</div>
            }

            <!-- ── Photographers ── -->
            <section class="ag-card">
                <h2>Photographers</h2>
                <p class="ag-hint">
                    Created once and reused. Updating a link here updates every gallery that credits them.
                </p>

                <div class="ag-form-grid">
                    <label>Name<input @bind="Vm.PhotographerForm.Name" placeholder="Paul Keeling Photography" /></label>
                    <label>Website<input @bind="Vm.PhotographerForm.Website" placeholder="paulkeelingphotography.com" /></label>
                    <label>Instagram<input @bind="Vm.PhotographerForm.Instagram" placeholder="instagram.com/…" /></label>
                    <label>Facebook<input @bind="Vm.PhotographerForm.Facebook" placeholder="facebook.com/…" /></label>
                    <label>Email<input @bind="Vm.PhotographerForm.Email" placeholder="hello@example.com" /></label>
                    <label>Logo URL<input @bind="Vm.PhotographerForm.LogoUrl" placeholder="/uploads/…" /></label>
                    <label class="ag-span-2">Bio<textarea @bind="Vm.PhotographerForm.Bio" rows="2"></textarea></label>
                </div>

                <div class="ag-actions">
                    <button class="ag-btn primary" @onclick="Vm.SavePhotographer">
                        @(Vm.EditingPhotographerId is null ? "Add photographer" : "Save changes")
                    </button>
                    @if (Vm.EditingPhotographerId is not null)
                    {
                        <button class="ag-btn" @onclick="Vm.CancelPhotographerEdit">Cancel</button>
                    }
                </div>

                @if (Vm.Photographers.Any())
                {
                    <ul class="ag-list">
                        @foreach (var p in Vm.Photographers)
                        {
                            <li>
                                <span class="ag-list-name">@p.Name</span>
                                <span class="ag-list-meta">@p.Website</span>
                                <span class="ag-list-actions">
                                    <button class="ag-link" @onclick="() => Vm.EditPhotographer(p)">Edit</button>
                                    <button class="ag-link danger" @onclick="() => Vm.DeletePhotographer(p)">Delete</button>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <!-- ── Create a gallery ── -->
            <section class="ag-card">
                <h2>New gallery</h2>
                <p class="ag-hint">One gallery per fixture. Fixtures that already have one aren't listed.</p>

                @if (!Vm.AvailableFixtures.Any())
                {
                    <p class="ag-empty">Every fixture already has a gallery.</p>
                }
                else
                {
                    <div class="ag-form-grid">
                        <label class="ag-span-2">
                            Fixture
                            <select @bind="Vm.NewGalleryFixtureId">
                                <option value="0">— choose a fixture —</option>
                                @foreach (var f in Vm.AvailableFixtures)
                                {
                                    <option value="@f.Id">@AdminGalleriesViewModel.FixtureLabel(f)</option>
                                }
                            </select>
                        </label>

                        <label>
                            Photographer
                            <select @bind="Vm.NewGalleryPhotographerId">
                                <option value="0">— none —</option>
                                @foreach (var p in Vm.Photographers)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </label>

                        <label>Title (optional)<input @bind="Vm.NewGalleryTitle" placeholder="Opening day" /></label>
                        <label class="ag-span-2">Description (optional)<textarea @bind="Vm.NewGalleryDescription" rows="2"></textarea></label>
                    </div>

                    <div class="ag-actions">
                        <button class="ag-btn primary" @onclick="Vm.CreateGallery">Create gallery</button>
                    </div>
                }
            </section>

            <!-- ── Existing galleries ── -->
            <section class="ag-card">
                <h2>Galleries</h2>

                @if (!Vm.Galleries.Any())
                {
                    <p class="ag-empty">No galleries yet.</p>
                }
                else
                {
                    @foreach (var g in Vm.Galleries)
                    {
                        <div class="ag-gallery">
                            <div class="ag-gallery-head">
                                @if (!string.IsNullOrEmpty(g.CoverThumbnailUrl))
                                {
                                    <img class="ag-gallery-cover" src="@Abs(g.CoverThumbnailUrl)" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <div class="ag-gallery-cover empty">No photos</div>
                                }

                                <div class="ag-gallery-info">
                                    <div class="ag-gallery-title">
                                        @g.HomeTeam v @g.AwayTeam
                                        @if (!g.IsPublished)
                                        {
                                            <span class="ag-badge">Hidden</span>
                                        }
                                    </div>
                                    <div class="ag-gallery-meta">
                                        Week @g.Week ·
                                        @(g.Kickoff?.ToString("d MMM yyyy") ?? "no date") ·
                                        @g.PhotoCount photos
                                        @if (!string.IsNullOrEmpty(g.PhotographerName))
                                        {
                                            <text> · @g.PhotographerName</text>
                                        }
                                    </div>
                                </div>

                                <div class="ag-gallery-actions">
                                    <a class="ag-link" href="/gallery/@g.Id">View</a>
                                    @* Which fixture a gallery is attached to decides where the
                                       "View match photos" button shows up, so link straight to it. *@
                                    <a class="ag-link" href="/fixture/@g.FixtureId">Fixture</a>
                                    <button class="ag-link" @onclick="() => Vm.TogglePublished(g)">
                                        @(g.IsPublished ? "Hide" : "Publish")
                                    </button>
                                    @* Uploads sort themselves, but this fixes galleries
                                       added before that, without re-uploading. *@
                                    <button class="ag-link" @onclick="() => Vm.Resort(g)">Sort by filename</button>
                                    <button class="ag-link danger" @onclick="() => Vm.DeleteGallery(g)">Delete</button>
                                </div>
                            </div>

                            <div class="ag-upload">
                                <InputFile OnChange="e => OnFilesSelected(e, g.Id)" multiple accept="image/*" />

                                @if (Vm.UploadingGalleryId == g.Id)
                                {
                                    <span class="ag-upload-status">
                                        Uploading @Vm.UploadedCount of @Vm.UploadTotal…
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
            </section>
        }

    </div>

</div>
    </ChildContent>
</AdminShell>

@code {
    // The page's state and actions are in AdminGalleriesViewModel.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    private Task OnFilesSelected(InputFileChangeEventArgs e, int galleryId)
        => Vm.UploadFiles(galleryId, e.GetMultipleFiles(1000));

    private string? Abs(string? url) => MediaUrls.Absolute(Http, url);
}
