@page "/dashboard"
@attribute [Authorize]

@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject AuthenticationStateProvider AuthProvider
@inject PlayerAccountService AccountService
@inject IWebAssemblyHostEnvironment HostEnv
@inject IConfiguration Config
@inject NavigationManager Nav
<PageTitle>Dashboard</PageTitle>

@* Who lands here: managers get their HQ, referees their tiles, and a player
   still waiting for approval is told so. Players and admins are sent to their
   own home pages instead. *@
<div class="dashboard-container">

    <AuthorizeView Context="auth">

        <Authorized>

            @if (isLoading)
            {
                <LoadingSpinner />
            }
            else if (isPendingPlayer)
            {
                @* Signed up but not yet approved. There is nothing this account can
                   do until a manager lets them in, so say that plainly instead of
                   showing an empty manager dashboard. *@
                <div class="dashboard-hero">
                    <div class="dashboard-hero-inner">
                        <div class="dash-greeting-block">
                            <p class="dash-eyebrow">Waiting for approval</p>
                            <h1 class="dash-greeting">
                                Nearly there,
                                <span class="dash-team">@(accountStatus?.RequestedName ?? "baller")</span>
                            </h1>
                        </div>
                    </div>
                </div>
                <div class="dashboard-body">
                    <p>
                        Your sign-up has gone to
                        @(accountStatus?.TeamName is { } team ? $"{team}'s manager" : "your manager")
                        @if (accountStatus?.WasRejected == true)
                        {
                            <text>
                                and wasn't approved. Have a word with them, then sign up again
                                if you need to.
                            </text>
                        }
                        else
                        {
                            <text>
                                for approval. Once they've approved it, your card and 80 points
                                will be waiting here.
                            </text>
                        }
                    </p>
                </div>
            }
            else if (!isReferee)
            {
                @* Managers get Gaffer's HQ. *@
                <ManagerHq />
            }
            else
            {
                <div class="dashboard-hero">
                    <div class="dashboard-hero-inner">
                        <div class="dash-greeting-block">
                            <p class="dash-eyebrow">Referee Dashboard</p>
                            <h1 class="dash-greeting">
                                Welcome back,
                                <span class="dash-team">Referee</span>
                            </h1>
                        </div>
                    </div>
                </div>

                <div class="dashboard-grid">
                    <div class="action-tiles-row">

                        <NavLink class="dashboard-card action-card fixtures-action" href="/manager-fixtures">
                            <div class="action-body">
                                <h3>Fixtures</h3>
                                <p>View and update all fixtures</p>
                            </div>
                            <span class="action-arrow">›</span>
                        </NavLink>

                        <NavLink class="dashboard-card action-card referees-action" href="/referees">
                            <div class="action-body">
                                <h3>Referees</h3>
                                <p>Manage referee contacts and availability</p>
                            </div>
                            <span class="action-arrow">›</span>
                        </NavLink>

                        <NavLink class="dashboard-card action-card guide-action" href="/guide">
                            <div class="action-body">
                                <h3>How-To Guide</h3>
                                <p>Learn how the app works</p>
                            </div>
                            <span class="action-arrow">›</span>
                        </NavLink>

                        <NavLink class="dashboard-card action-card password-action" href="/change-password">
                            <div class="action-body">
                                <h3>Change Password</h3>
                                <p>Update your account password</p>
                            </div>
                            <span class="action-arrow">›</span>
                        </NavLink>

                        @if (HostEnv.IsDevelopment() || Config.GetValue<bool>("IsUAT"))
                        {
                            <NavLink class="dashboard-card action-card debug-action" href="/debug">
                                <div class="action-body">
                                    <h3>Debug Setup</h3>
                                    <p>Seed and reset data for development</p>
                                </div>
                                <span class="action-arrow">›</span>
                            </NavLink>
                        }

                    </div>
                </div>
            }

        </Authorized>

    </AuthorizeView>

</div>

@code {
    private bool isLoading = true;
    private bool isReferee;
    private bool isPendingPlayer;
    private Ballers.Shared.PlayerAccountStatusDto? accountStatus;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();

        // Players have no dashboard: their card is their home page. Admins
        // have the admin overview instead.
        if (authState.User.IsInRole("Player"))
        {
            Nav.NavigateTo("/my-card", replace: true);
            return;
        }
        if (authState.User.IsInRole("Admin"))
        {
            Nav.NavigateTo("/admin", replace: true);
            return;
        }

        isReferee = authState.User.IsInRole("Referee");

        // An account with no role at all is a player waiting on their manager.
        isPendingPlayer = authState.User.FindFirst("PendingPlayer")?.Value == "true";
        if (isPendingPlayer)
            accountStatus = await AccountService.GetMyStatus();

        isLoading = false;
    }
}
