@page "/manager-fixtures"
@using Ballers.Client.Auth
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

@inject FixtureService FixtureService
@inject AuthService AuthService
@inject LeagueSettingsService LeagueSettingsSvc
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>My Fixtures</PageTitle>

<div class="mgr-page">

    <div class="mgr-hero">
        <div class="mgr-hero-inner">
            <p class="mgr-eyebrow">Manager View</p>
            <h1>My Fixtures</h1>
        </div>
    </div>

    <div class="mgr-body">

        @if (fixtures == null)
        {
            <LoadingSpinner />
        }
        else if (!fixtures.Any())
        {
            <div class="empty-fixtures">
                <p>No fixtures have been scheduled yet.</p>
            </div>
        }
        else
        {
            <div class="fixtures-table">

                <div class="fixtures-header">
                    <span>Wk</span>
                    <span>Match</span>
                    <span>Kickoff</span>
                    <span>Location</span>
                    <span>Status</span>
                    <span></span>
                </div>

                @foreach (var fixture in fixtures)
                {
                    <div class="fixture-row @(fixture.IsKnockout ? "knockout-row" : "")">

                        <span class="match-number">
                            @if (fixture.IsKnockout)
                            {
                                <span class="knockout-label">@fixture.KnockoutTournament</span>
                            }
                            else
                            {
                                @fixture.Week
                            }
                        </span>

                        <span class="fixture-teams">
                            @if (fixture.IsKnockout)
                            {
                                <span class="knockout-round-badge">@fixture.KnockoutRound</span>
                            }
                            <strong>@fixture.HomeTeam</strong>
                            <span class="vs">vs</span>
                            <strong>@fixture.AwayTeam</strong>
                        </span>

                        <span class="fixture-detail">
                            @(fixture.KickOff == null
                                ? "Not set"
                                : fixture.KickOff.Value.ToString("dd MMM HH:mm"))
                        </span>

                        <span class="fixture-detail">
                            @(string.IsNullOrEmpty(fixture.Location)
                                ? "Not set"
                                : fixture.Location)
                        </span>

                        <span class="status-cell">
                            @if (fixture.IsPlayed)
                            {
                                <span class="status played">Played</span>
                            }
                            else if (fixture.KickOff != null && !string.IsNullOrEmpty(fixture.Location))
                            {
                                <span class="status scheduled">Scheduled</span>
                                @if (!fixture.IsKnockout && !fixture.ManagerSquadSubmitted)
                                {
                                    <span class="status awaiting-squad">Awaiting Team Selection</span>
                                }
                            }
                            else
                            {
                                <span class="status awaiting">Awaiting</span>
                                @if (!fixture.IsKnockout && !fixture.ManagerSquadSubmitted)
                                {
                                    <span class="status awaiting-squad">Awaiting Team Selection</span>
                                }
                            }
                        </span>

                        <span class="fixture-actions">
                            @if (lockedForMe)
                            {
                                <button class="view-btn" @onclick="() => OpenFixture(fixture.Id)">View</button>
                            }
                            else
                            {
                                <button class="@(fixture.ManagerStatsSubmitted || (fixture.IsKnockout && fixture.IsPlayed) ? "view-btn" : "edit-btn")"
                                        @onclick="() => OpenFixture(fixture.Id)">
                                    @if (fixture.IsKnockout)
                                    {
                                        @(fixture.IsPlayed ? "View" : "Enter Stats")
                                    }
                                    else
                                    {
                                        @(fixture.ManagerStatsSubmitted ? "View" : fixture.IsPlayed ? "Submit Stats" : "Edit")
                                    }
                                </button>
                            }
                            <button class="sheet-btn" @onclick="() => OpenTeamSheet(fixture.Id)">Team Sheet</button>
                        </span>

                    </div>
                }

            </div>
        }

    </div>

</div>

@code {

    private List<FixtureDto>? fixtures;
    private bool lockedForMe;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var isAdmin = authState.User.IsInRole("Admin");

        var fixturesTask = FixtureService.GetFixtures();
        var settingsTask = LeagueSettingsSvc.Get();
        await Task.WhenAll(fixturesTask, settingsTask);

        fixtures = fixturesTask.Result;
        lockedForMe = settingsTask.Result.FixturesLocked && !isAdmin;
    }

    void OpenFixture(int id)
    {
        Nav.NavigateTo($"/fixture/{id}");
    }

    void OpenTeamSheet(int id)
    {
        Nav.NavigateTo($"/team-sheet/{id}");
    }

}
