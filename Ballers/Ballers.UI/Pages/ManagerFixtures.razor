@page "/manager-fixtures"
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inherits ViewModelComponent<ManagerFixturesViewModel>


<PageTitle>Fixtures</PageTitle>

@* A manager's season, one card per game: the next one big at the top, then
   anything that needs sorting, then what's coming up and what's been played.
   Each card says how far along that game is and offers the one job that's
   due. Admins and referees see every game, from the home side's view. *@
<div class="mf comic">
    <AuthorizeView Roles="Manager"><ManagerNav Current="fixtures" /></AuthorizeView>

    <div class="mf-wrap">
        <header class="mf-head">
            <span class="mf-sticker">@(Vm.IsStaff ? "All fixtures" : "Your fixtures")</span>
            <h1>@(Vm.IsStaff ? "Every game" : "Fixtures")</h1>

            @if (Vm.Fixtures != null && (Vm.Fixtures.Any() || Vm.Seasons.Count > 1))
            {
                <div class="mf-filters">
                    @if (Vm.Seasons.Count > 1)
                    {
                        <label class="mf-season">
                            <span>Season</span>
                            <select @bind="Vm.SeasonId" @bind:after="Vm.LoadSeason">
                                @foreach (var s in Vm.Seasons)
                                {
                                    <option value="@s.Id">Season @s.Number@(s.Active ? " (now)" : "")</option>
                                }
                            </select>
                        </label>
                    }
                    @if (!Vm.IsStaff)
                    {
                        <div class="mf-chips" role="group" aria-label="Home or away">
                            @foreach (var v in new[] { "All", "Home", "Away" })
                            {
                                <button type="button" class="mf-chip @(Vm.Venue == v ? "is-active" : "")"
                                        aria-pressed="@(Vm.Venue == v ? "true" : "false")" @onclick="() => Vm.Venue = v">@v</button>
                            }
                        </div>
                    }
                </div>
            }
        </header>

        @if (Vm.LockedForMe)
        {
            <p class="mf-note">🔒 The admins have locked fixtures for now. You can look, but not change anything.</p>
        }

        @if (Vm.Fixtures == null)
        {
            <div class="mf-loading"><LoadingSpinner /></div>
        }
        else if (!Vm.Fixtures.Any())
        {
            <div class="c-panel mf-empty">
                <span class="mf-big-emoji" aria-hidden="true">📭</span>
                <h2>No fixtures yet</h2>
                <p>Once the admins draw up the season, your games appear here. Meanwhile, get your squad ready!</p>
                <a class="c-btn is-yellow" href="/my-squad">Go to my squad</a>
            </div>
        }
        else
        {
            var list = Vm.Visible.ToList();
            var next = list.Where(Vm.IsUpcoming).OrderBy(ManagerFixturesViewModel.SortKey).FirstOrDefault();
            var sorting = list.Where(Vm.NeedsSorting).OrderBy(ManagerFixturesViewModel.SortKey).ToList();
            var upcoming = list.Where(f => Vm.IsUpcoming(f) && f != next).OrderBy(ManagerFixturesViewModel.SortKey).ToList();
            var played = list.Where(f => !Vm.IsUpcoming(f) && !Vm.NeedsSorting(f)).OrderByDescending(ManagerFixturesViewModel.SortKey).ToList();

            @if (next != null)
            {
                var a = Vm.ActionFor(next);
                <section class="mf-next" aria-labelledby="mf-next-title">
                    <span class="mf-next-tag" id="mf-next-title">Next up</span>
                    <div class="mf-next-teams">
                        <span class="mf-crest @(Vm.Ours(next, true) ? "is-us" : "")">@Format.TeamInitials(next.HomeTeam)</span>
                        <span class="mf-next-name is-home">@next.HomeTeam</span>
                        <span class="mf-burst" aria-label="versus">VS</span>
                        <span class="mf-next-name is-away">@next.AwayTeam</span>
                        <span class="mf-crest @(Vm.Ours(next, false) ? "is-us" : "")">@Format.TeamInitials(next.AwayTeam)</span>
                    </div>
                    <p class="mf-next-when">@ManagerFixturesViewModel.When(next) · @ManagerFixturesViewModel.Countdown(next)</p>
                    @Progress(next)
                    <div class="mf-next-foot">
                        @Facts(next)
                        <a class="c-btn is-big @a.Tone" href="@a.Link">@a.Label →</a>
                    </div>
                </section>
            }

            @if (sorting.Any())
            {
                <section class="mf-section" aria-labelledby="mf-sort-title">
                    <h2 id="mf-sort-title" class="mf-section-title is-red">🚨 Needs sorting <small>@sorting.Count</small></h2>
                    <div class="mf-grid">
                        @foreach (var f in sorting) { @Card(f) }
                    </div>
                </section>
            }

            <div class="mf-columns">
                <section class="mf-section" aria-labelledby="mf-up-title">
                    <h2 id="mf-up-title" class="mf-section-title">📅 Coming up <small>@upcoming.Count</small></h2>
                    @if (!upcoming.Any())
                    {
                        <p class="mf-none">@(next == null ? "No more games this season." : "That's the lot after the next one.")</p>
                    }
                    else
                    {
                        <div class="mf-stack">
                            @foreach (var f in upcoming) { @Card(f) }
                        </div>
                    }
                </section>

                <section class="mf-section" aria-labelledby="mf-played-title">
                    <h2 id="mf-played-title" class="mf-section-title">🏁 Played <small>@played.Count</small></h2>
                    @if (!played.Any())
                    {
                        <p class="mf-none">No games played yet.</p>
                    }
                    else
                    {
                        <div class="mf-stack">
                            @foreach (var f in played) { @Card(f) }
                        </div>
                    }
                </section>
            </div>
        }
    </div>
</div>

@code {
    // The fixtures and the rules for what each one needs are in
    // ManagerFixturesViewModel; the card fragments are drawn here.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    // ── Bits of a card ──

    private RenderFragment Card(FixtureListItemDto f)
    {
        var a = Vm.ActionFor(f);
        var isHome = Vm.IsStaff || f.IsHomeTeamManager;
        var opponent = Vm.IsStaff ? $"{f.HomeTeam} v {f.AwayTeam}" : $"{(f.IsHomeTeamManager ? "v" : "at")} {(f.IsHomeTeamManager ? f.AwayTeam : f.HomeTeam)}";
        var (us, them) = isHome ? (f.HomeScore, f.AwayScore) : (f.AwayScore, f.HomeScore);
        var res = !f.IsPlayed ? null : us > them ? "W" : us == them ? "D" : "L";
        return @<article class="mf-card @(a.Tone == "is-red" ? "is-urgent" : "")">
            <div class="mf-card-top">
                <span class="mf-week">@(f.IsKnockout ? $"{f.KnockoutTournament} {f.KnockoutRound}" : $"MW{f.Week}")</span>
                @if (!Vm.IsStaff)
                {
                    <span class="mf-ha @(f.IsHomeTeamManager ? "is-home" : "")">@(f.IsHomeTeamManager ? "Home" : "Away")</span>
                }
                @if (res != null)
                {
                    <span class="mf-res is-@(Vm.IsStaff ? "d" : res.ToLower())">@(Vm.IsStaff ? "FT" : res)</span>
                }
            </div>
            <h3 class="mf-card-title">
                @opponent
                @if (f.IsPlayed)
                {
                    <strong>@(Vm.IsStaff ? $"{f.HomeScore}–{f.AwayScore}" : $"{us}–{them}")</strong>
                }
            </h3>
            <p class="mf-card-when">@ManagerFixturesViewModel.When(f)</p>
            @if (!f.IsPlayed && ManagerFixturesViewModel.Past(f) && f.ManagerStatsSubmitted && !Vm.IsStaff)
            {
                <p class="mf-wait">⏳ Waiting for @(f.IsHomeTeamManager ? f.AwayTeam : f.HomeTeam)'s stats</p>
            }
            @Progress(f)
            @Facts(f)
            <div class="mf-card-foot">
                <a class="c-btn is-small" href="/team-sheet/@f.Id">Team sheet</a>
                <a class="c-btn @a.Tone" href="@a.Link">@a.Label →</a>
            </div>
        </article>;
    }

    // Setup / Squad / Result / Pens, as on the fixture page.
    private RenderFragment Progress(FixtureListItemDto f)
    {
        var squad = f.ManagerSquadCount;
        var resultDone = Vm.IsStaff ? f.IsPlayed : f.ManagerStatsSubmitted;
        return @<ul class="mf-progress" aria-label="Progress">
            <li class="@(ManagerFixturesViewModel.SetupDone(f) ? "is-done" : "")">@(ManagerFixturesViewModel.SetupDone(f) ? "✔" : "○") Setup</li>
            @if (!Vm.IsStaff)
            {
                <li class="@(squad >= ManagerFixturesViewModel.SquadMinimum ? "is-done" : squad > 0 ? "is-part" : "")">
                    @(squad >= ManagerFixturesViewModel.SquadMinimum ? "✔" : "○") Squad @(squad >= ManagerFixturesViewModel.SquadMinimum ? "" : $"{squad}/{ManagerFixturesViewModel.SquadMinimum}")
                </li>
            }
            <li class="@(resultDone ? "is-done" : "")">@(resultDone ? "✔" : "○") Result</li>
            @if (!Vm.IsStaff)
            {
                <li class="@(f.ManagerPensSubmitted ? "is-done" : "")">@(f.ManagerPensSubmitted ? "✔" : "○") Pens</li>
            }
        </ul>;
    }

    private RenderFragment Facts(FixtureListItemDto f) => @<dl class="mf-facts">
        <div>
            <dt>📍</dt>
            <dd>
                @(string.IsNullOrWhiteSpace(f.Location) ? "Venue TBC" : f.Location)
                @if (ManagerFixturesViewModel.MapUrl(f) is { } map)
                {
                    <a href="@map" target="_blank" rel="noopener noreferrer" aria-label="@($"Open {f.Location} in maps")">map ↗</a>
                }
            </dd>
        </div>
        <div><dt>🟨</dt><dd>@(f.RefereeName ?? "No ref yet")</dd></div>
    </dl>;

}
