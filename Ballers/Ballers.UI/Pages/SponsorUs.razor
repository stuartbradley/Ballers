@page "/sponsor-us"

<PageTitle>Sponsor Us — Blackpool Ballers League</PageTitle>

<div class="sponsor-page">

    <!-- Hero -->
    <section class="su-hero">
        <div class="su-hero-inner">
            <span class="su-eyebrow">Elite Sponsorship &amp; Media Package &middot; Season 2026–2027</span>
            <h1>Sponsor the <span class="accent">Ballers</span> League</h1>
            <p class="su-sub">A fast-growing football platform built around competition, content &amp; community.</p>
        </div>
    </section>

    <div class="su-body">

        <!-- Opportunity -->
        <section class="su-block">
            <h2>The Opportunity</h2>
            <p>
                We're excited to present the official sponsorship opportunities within The Ballers League.
                This partnership is designed to deliver consistent exposure, strong brand recognition, and
                real return on investment across a full competitive season.
            </p>
            <p>
                The official league launch will generate thousands of social media interactions, with all
                <strong>250+ members</strong> liking, sharing and commenting to enter a high-profile giveaway
                before the season begins. Sponsors receive headline branding throughout this campaign,
                reaching thousands of engaged viewers.
            </p>
        </section>

        <!-- Headline package -->
        <section id="packages" class="su-block">
            <p class="su-availability">
                Our <strong>£1000 Main League Sponsor</strong> package has now been taken — thank you to our
                headline partner! All other sponsorship packages below are still available.
            </p>
            <div class="su-headline-card is-taken">
                <span class="su-sold-badge">Now Taken</span>
                <div class="su-sold-stamp"><span>Sponsor Secured</span></div>
                <div class="su-headline-top">
                    <div>
                        <span class="su-tag">Main League Sponsor</span>
                        <h3>Premium headline partnership</h3>
                        <p>Position your brand at the heart of The Ballers League.</p>
                    </div>
                    <div class="su-price"><s>£1000</s></div>
                </div>

                <div class="su-features">
                    <div class="su-feature">
                        <h4>Prime Website Placement</h4>
                        <ul>
                            <li>Central logo placement on the homepage</li>
                            <li>Used weekly by 250+ league members</li>
                            <li>Estimated 500+ weekly visits (tracked &amp; reported)</li>
                        </ul>
                    </div>
                    <div class="su-feature">
                        <h4>Member Content Integration</h4>
                        <ul>
                            <li>352+ guaranteed posts across the season</li>
                            <li>Organic sharing across player &amp; team networks</li>
                        </ul>
                    </div>
                    <div class="su-feature">
                        <h4>Fixture Graphics Branding</h4>
                        <ul>
                            <li>Logo on 80+ official match graphics</li>
                            <li>Consistent social exposure all season</li>
                        </ul>
                    </div>
                    <div class="su-feature">
                        <h4>Video Content Integration</h4>
                        <ul>
                            <li>Featured in weekly Ref Cam video content</li>
                            <li>Distributed via established football media platforms</li>
                        </ul>
                    </div>
                    <div class="su-feature">
                        <h4>Naming Rights</h4>
                        <ul>
                            <li>League &amp; penalty competition naming rights</li>
                        </ul>
                    </div>
                    <div class="su-feature">
                        <h4>Presentation Night Exposure</h4>
                        <ul>
                            <li>Branding on trophies &amp; presentation screens</li>
                            <li>Featured across all major award moments</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Other packages -->
        <section class="su-block">
            <h2>Other Sponsorship Packages</h2>
            <div class="su-grid">

                <div class="su-pkg">
                    <div class="su-pkg-head">
                        <span class="su-pkg-name">Ballers Cup &amp; Shield</span>
                        <span class="su-pkg-price">£250 <small>each</small></span>
                    </div>
                    <ul>
                        <li>Naming rights for the Cup &amp; Shield competitions</li>
                        <li>Finals hosted at a stadium venue (TBC)</li>
                        <li>Branding across all final-related media</li>
                        <li>Present the awards with your company on the trophies</li>
                    </ul>
                </div>

                <div class="su-pkg">
                    <div class="su-pkg-head">
                        <span class="su-pkg-name">Dream Team of the Month</span>
                        <span class="su-pkg-price">£200 <small>/ season</small></span>
                    </div>
                    <ul>
                        <li>Branding on 250+ player cards</li>
                        <li>Upgrade system: Bronze → Silver → Gold → Icon</li>
                        <li>Continuous player-driven engagement</li>
                    </ul>
                </div>

                <div class="su-pkg">
                    <div class="su-pkg-head">
                        <span class="su-pkg-name">Team of the Week</span>
                        <span class="su-pkg-price">£500 <small>/ season</small></span>
                    </div>
                    <ul>
                        <li>Branding across 1000+ professional images</li>
                        <li>Coverage across 9 league phases &amp; Cup Final Day</li>
                        <li>Distributed across Facebook, Instagram &amp; TikTok</li>
                        <li>Pro sports photographer — your company on every picture</li>
                    </ul>
                </div>

            </div>
        </section>

        <!-- Included in all -->
        <section class="su-block">
            <div class="su-included">
                <h2>Included in <span class="accent">every</span> package</h2>
                <ul>
                    <li>Exclusive Ballers Blackpool memberships for company employees</li>
                    <li>Discounted drinks &amp; access to darts, pool and shuffleboard</li>
                    <li>Website sponsor listing with a direct backlink</li>
                </ul>
            </div>
        </section>

        <!-- Timeline -->
        <section class="su-block">
            <h2>Season Timeline &amp; Growth</h2>
            <div class="su-timeline">
                <div class="su-season">
                    <span class="su-season-label">Season 1</span>
                    <span class="su-season-dates">August 2026 → Early 2027</span>
                </div>
                <div class="su-season">
                    <span class="su-season-label">Season 2</span>
                    <span class="su-season-dates">1 March 2027 → August 2027</span>
                </div>
            </div>
            <p class="su-discount">★ 50% off your second season when you commit to both</p>
            <p>
                Season 2 is projected to be significantly bigger — more teams, more matches, and other
                leagues already expressing interest in joining.
            </p>
        </section>

        <!-- Contact -->
        <section class="su-block">
            <div class="su-contact">
                <span class="su-contact-kicker">Let's work together</span>
                <h2>Get in touch</h2>
                <p>For more information about sponsoring the Blackpool Ballers League:</p>
                <div class="su-contact-row">
                    <a class="su-contact-btn" href="tel:07432717053">📞 Paul Smith — 07432 717053</a>
                    <a class="su-contact-btn ghost" href="https://www.blackpoolballersleague.co.uk" target="_blank" rel="noopener noreferrer">🌐 blackpoolballersleague.co.uk</a>
                </div>
            </div>
        </section>

        <p class="su-quote">"Let's build something exciting, visible and valuable together."</p>

    </div>
</div>
