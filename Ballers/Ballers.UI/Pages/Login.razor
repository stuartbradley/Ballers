@page "/login"
@using Ballers.Auth
@using Ballers.Client.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthService Auth
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Login</PageTitle>

<div class="login-page">

    <!-- LEFT SIDE -->
    <div class="login-left">

        <div class="login-card">

            <h1>Login</h1>
            <p class="subtitle">Managers, referees and players</p>

            <div class="form-group">
                <label>Email</label>
                <input @bind="Email" @bind:event="oninput" placeholder="manager@team.com" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" @bind="Password" @bind:event="oninput" @onkeydown="OnKeyDown" />
            </div>

            @if (!string.IsNullOrEmpty(loginError))
            {
                <div class="login-error">@loginError</div>
            }

            <button class="login-btn" @onclick="HandleLogin">
                Sign In
            </button>

            <div style="margin-top:0.75rem;text-align:center;">
                <a href="/forgot-password">Forgot password?</a>
            </div>

            <div style="margin-top:0.5rem;text-align:center;">
                Are you a player? <a href="/signup">Create an account</a>
            </div>

        </div>

    </div>

    <!-- RIGHT SIDE -->
    <div class="login-right">
        <div class="login-right-bg"></div>
        <div class="branding">
            <div class="brand-wordmark">
                <span class="brand-the">Blackpool</span>
                <span class="brand-name">Ballers</span>
                <span class="brand-league">League</span>
            </div>
            <p class="brand-tagline">Blackpool's Premier 11-a-Side Competition</p>
        </div>
    </div>

</div>

@code {
    string? Email;
    string? Password;
    string? loginError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo(HomeFor(state.User), replace: true);
    }

    // A player's home is their card and an admin's is the admin overview; they
    // have no dashboard. Everyone else, including a player still waiting for
    // approval, starts on the dashboard.
    static string HomeFor(System.Security.Claims.ClaimsPrincipal user)
        => user.IsInRole("Player") ? "/my-card"
         : user.IsInRole("Admin") ? "/admin"
         : "/dashboard";

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }

    async Task HandleLogin()
    {
        loginError = null;
        var success = await Auth.Login(new Client.Models.LoginRequest
        {
            Email = Email!,
            Password = Password!
        });
        if (success)
        {
            ((AuthStateProvider)AuthProvider).NotifyAuthChanged();
            var state = await AuthProvider.GetAuthenticationStateAsync();
            Nav.NavigateTo(HomeFor(state.User));
        }
        else
        {
            loginError = "Invalid email or password.";
        }
    }
}