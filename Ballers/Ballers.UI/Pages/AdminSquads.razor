@page "/admin/squads"
@page "/admin/squads/{TeamId:int}"
@using Ballers.Components
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject HttpClient Http
@inject NavigationManager Nav
@inherits ViewModelComponent<AdminSquadsViewModel>

<PageTitle>Squad Management — Admin</PageTitle>

<AdminShell Section="squads"
            Title="@(TeamId.HasValue ? (Vm.CurrentTeam?.Name ?? "Loading…") : "Squads")"
            Subtitle="@(TeamId.HasValue ? "This team's players. Admins can add players even when registration is locked." : "Pick a team to manage its players.")">
    <Actions>
        @if (TeamId.HasValue)
        {
            <a class="adm-btn" href="/admin/squads">‹ All teams</a>
        }
    </Actions>
    <ChildContent>
<div class="admin-squads-page">

    <div class="admin-squads-body">

        @if (Vm.Loading)
        {
            <LoadingSpinner />
        }
        else if (!TeamId.HasValue)
        {
            <!-- List of all teams -->
            <div class="admin-squads-grid">
                @foreach (var team in Vm.Teams)
                {
                    <a class="team-tile" href="@($"/admin/squads/{team.Id}")">
                        <div class="team-tile-image">
                            @if (!string.IsNullOrEmpty(team.ProfileImageUrl))
                            {
                                <img src="@Abs(team.ProfileImageUrl)" alt="@team.Name" />
                            }
                            else
                            {
                                <div class="team-tile-fallback">@AdminSquadsViewModel.TeamInitials(team.Name)</div>
                            }
                        </div>
                        <div class="team-tile-name">@team.Name</div>
                    </a>
                }
            </div>
        }
        else
        {
            <!-- Players for selected team -->

            <div class="admin-add-card">
                <p class="admin-add-label">Add Player</p>
                <form @onsubmit="Vm.AddPlayer" @onsubmit:preventDefault>
                    <div class="position-toggle">
                        <button type="button" class="pos-btn @(Vm.NewPosition == "GK"  ? "active GK"  : "")" @onclick='() => Vm.NewPosition = "GK"'>GK</button>
                        <button type="button" class="pos-btn @(Vm.NewPosition == "DEF" ? "active DEF" : "")" @onclick='() => Vm.NewPosition = "DEF"'>DEF</button>
                        <button type="button" class="pos-btn @(Vm.NewPosition == "MID" ? "active MID" : "")" @onclick='() => Vm.NewPosition = "MID"'>MID</button>
                        <button type="button" class="pos-btn @(Vm.NewPosition == "FWD" ? "active FWD" : "")" @onclick='() => Vm.NewPosition = "FWD"'>FWD</button>
                    </div>
                    <div class="add-player-row">
                        <input class="form-input name-input" placeholder="Player name" @bind="Vm.NewName" autocomplete="off" />
                        <input class="form-input number-input" type="number" placeholder="No." min="1" @bind="Vm.NewNumber" />
                        <button class="add-btn" type="submit">Add Player</button>
                    </div>
                    @if (!string.IsNullOrEmpty(Vm.FormError))
                    {
                        <div class="form-error">@Vm.FormError</div>
                    }
                </form>
            </div>

            @if (Vm.EditPlayer != null)
            {
                <div class="edit-player-overlay" @onclick="Vm.CloseEditModal">
                    <div class="edit-player-modal" @onclick:stopPropagation>
                        <h3>Edit Player</h3>
                        <div class="position-toggle">
                            <button type="button" class="pos-btn @(Vm.EditPosition == "GK"  ? "active GK"  : "")" @onclick='() => Vm.EditPosition = "GK"'>GK</button>
                            <button type="button" class="pos-btn @(Vm.EditPosition == "DEF" ? "active DEF" : "")" @onclick='() => Vm.EditPosition = "DEF"'>DEF</button>
                            <button type="button" class="pos-btn @(Vm.EditPosition == "MID" ? "active MID" : "")" @onclick='() => Vm.EditPosition = "MID"'>MID</button>
                            <button type="button" class="pos-btn @(Vm.EditPosition == "FWD" ? "active FWD" : "")" @onclick='() => Vm.EditPosition = "FWD"'>FWD</button>
                        </div>
                        <div class="add-player-row">
                            <input class="form-input name-input" placeholder="Player name" @bind="Vm.EditName" autocomplete="off" />
                            <input class="form-input number-input" type="number" placeholder="No." min="1" @bind="Vm.EditNumber" />
                        </div>
                        @if (!string.IsNullOrEmpty(Vm.EditError))
                        {
                            <div class="form-error">@Vm.EditError</div>
                        }
                        <div class="edit-modal-actions">
                            <button class="add-btn" @onclick="Vm.SaveEdit">Save</button>
                            <button class="remove-btn" @onclick="Vm.CloseEditModal">Cancel</button>
                        </div>
                    </div>
                </div>
            }

            <ImageCropModal IsVisible="Vm.ShowCropModal"
                            PlayerId="Vm.CropPlayer?.Id ?? 0"
                            Name="@(Vm.CropPlayer?.Name ?? "")"
                            Number="@(Vm.CropPlayer?.Number ?? 0)"
                            Position="@(Vm.CropPlayer?.Position ?? "MID")"
                            OnClose="@(() => Vm.ShowCropModal = false)"
                            OnSaved="Vm.OnPhotoSaved" />

            @if (Vm.Players.Count == 0)
            {
                <div class="empty-state">
                    <p>This team has no players.</p>
                </div>
            }
            else
            {
                @foreach (var group in Vm.GroupedPlayers)
                {
                    <div class="position-group">
                        <div class="group-header">
                            <span class="group-badge @group.Key">@group.Key</span>
                            <span class="group-count">@group.Count() player@(group.Count() == 1 ? "" : "s")</span>
                        </div>
                        <div class="squad-grid">
                            @foreach (var p in group.OrderBy(x => x.Number))
                            {
                                <PlayerCard Name="@p.Name"
                                            Number="@p.Number"
                                            Position="@p.Position"
                                            ImageUrl="@p.ImageUrl"
                                            OnEditPhoto="@(() => Vm.OpenCropModal(p))"
                                            OnEdit="@(() => Vm.OpenEditModal(p))" />
                            }
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>
    </ChildContent>
</AdminShell>

@code {
    // The squads and their actions are in AdminSquadsViewModel.

    [Parameter] public int? TeamId { get; set; }

    protected override Task OnParametersSetAsync() => Vm.LoadAsync(TeamId);

    private string? Abs(string? url)
        => string.IsNullOrEmpty(url) ? null : Http.BaseAddress!.ToString().TrimEnd('/') + url;
}
