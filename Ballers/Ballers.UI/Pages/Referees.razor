@page "/referees"
@attribute [Authorize]
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inherits ViewModelComponent<RefereesViewModel>

<PageTitle>Referees</PageTitle>

<div class="referees-page">
    @* The manager's own menu; admins and referees use this page too. *@
    <AuthorizeView Roles="Manager"><ManagerNav Current="referees" /></AuthorizeView>


    <div class="referees-hero">
        <div class="referees-hero-inner">
            <p class="referees-eyebrow">Ballers League</p>
            <h1>Referees</h1>
            <p class="referees-sub">Contact list &amp; availability</p>
        </div>
    </div>

    <div class="referees-body">

        @if (Vm.IsLoading)
        {
            <div class="referees-loading"><LoadingSpinner /></div>
        }
        else
        {
            <!-- ADD / EDIT FORM -->
            <div class="ref-form-card">
                <h3>@(Vm.EditingId.HasValue ? "Edit Referee" : "Add Referee")</h3>
                <div class="ref-form">
                    <div class="ref-field-row">
                        <div class="ref-field">
                            <label>Name <span class="required">*</span></label>
                            <input type="text" @bind="Vm.Form.Name" placeholder="e.g. Mark Hughes" maxlength="80" />
                        </div>
                        <div class="ref-field">
                            <label>Phone</label>
                            <input type="tel" @bind="Vm.Form.PhoneNumber" placeholder="e.g. 07700 900123" maxlength="20" />
                        </div>
                    </div>
                    <div class="ref-field-row">
                        <div class="ref-field">
                            <label>Email</label>
                            <input type="email" @bind="Vm.Form.Email" placeholder="e.g. ref@example.com" maxlength="100" />
                        </div>
                        <div class="ref-field">
                            <label>Notes</label>
                            <input type="text" @bind="Vm.Form.Notes" placeholder="Any extra info…" maxlength="200" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Vm.FormError))
                    {
                        <p class="ref-error">@Vm.FormError</p>
                    }

                    <div class="ref-form-actions">
                        <button class="primary-btn @(Vm.IsSaving ? "saving" : "")" @onclick="Vm.Save" disabled="@Vm.IsSaving">
                            @(Vm.IsSaving ? "Saving…" : Vm.EditingId.HasValue ? "Update" : "Add Referee")
                        </button>
                        @if (Vm.EditingId.HasValue)
                        {
                            <button class="cancel-btn" @onclick="Vm.CancelEdit">Cancel</button>
                        }
                    </div>
                </div>
            </div>

            <!-- REFEREE LIST -->
            @if (!Vm.Referees.Any())
            {
                <div class="referees-empty">No referees added yet.</div>
            }
            else
            {
                <div class="ref-list">
                    @foreach (var referee in Vm.Referees)
                    {
                        <div class="ref-card @(Vm.EditingId == referee.Id ? "editing" : "")">
                            <div class="ref-card-header">
                                <div class="ref-card-name">@referee.Name</div>
                                <div class="ref-card-actions">
                                    <button class="ref-edit-btn" @onclick="() => Vm.StartEdit(referee)">Edit</button>
                                    @if (Vm.IsAdmin)
                                    {
                                        <button class="ref-delete-btn" @onclick="() => Vm.Delete(referee.Id)">Delete</button>
                                    }
                                </div>
                            </div>

                            <div class="ref-card-contacts">
                                @if (!string.IsNullOrEmpty(referee.PhoneNumber))
                                {
                                    <a href="tel:@referee.PhoneNumber" class="ref-contact-chip phone">
                                        <span class="chip-icon">📞</span>@referee.PhoneNumber
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(referee.Email))
                                {
                                    <a href="mailto:@referee.Email" class="ref-contact-chip email">
                                        <span class="chip-icon">✉</span>@referee.Email
                                    </a>
                                }
                                @if (string.IsNullOrEmpty(referee.PhoneNumber) && string.IsNullOrEmpty(referee.Email))
                                {
                                    <span class="ref-no-contact">No contact details</span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(referee.Notes))
                            {
                                <p class="ref-notes">@referee.Notes</p>
                            }

                            @if (referee.UpcomingFixtures.Any())
                            {
                                <div class="ref-fixtures">
                                    <p class="ref-fixtures-label">Upcoming fixtures</p>
                                    @foreach (var f in referee.UpcomingFixtures)
                                    {
                                        <div class="ref-fixture-chip">
                                            <span class="ref-fixture-teams">@f.HomeTeam vs @f.AwayTeam</span>
                                            <div class="ref-fixture-when">
                                                <span class="ref-fixture-date">
                                                    @(f.Kickoff.HasValue
                                                        ? f.Kickoff.Value.ToString("ddd d MMM")
                                                        : $"{f.WindowStart:ddd d MMM} – {f.WindowEnd:ddd d MMM}")
                                                </span>
                                                @if (f.Kickoff.HasValue)
                                                {
                                                    <span class="ref-fixture-ko">@f.Kickoff.Value.ToString("HH:mm")</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="ref-available">Available — no upcoming fixtures assigned</p>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

</div>

@code {
    // The referees and their actions are in RefereesViewModel.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();
}
