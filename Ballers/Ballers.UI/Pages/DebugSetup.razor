@page "/debug"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject HttpClient Http
@inject IWebAssemblyHostEnvironment HostEnv
@inject IConfiguration Config

@if (!HostEnv.IsDevelopment() && !Config.GetValue<bool>("IsUAT"))
{
    <div class="debug-unavailable">
        <h2>Not Available</h2>
        <p>This page is only available in Development and on UAT.</p>
    </div>
}
else
{
    <div class="debug-page">
        <h1 class="debug-title">Debug Setup</h1>
        <p class="debug-warn">Admins only, in Development and on UAT. Use it to quickly seed different data states.</p>

        <div class="debug-grid">

            <div class="debug-card">
                <h3>Clear Database</h3>
                <p>Drops and recreates the database. Admin user is recreated. No teams or fixtures.</p>
                <button class="debug-btn danger" @onclick='() => RunAction("clear")' disabled="@IsLoading">
                    @(ActiveAction == "clear" ? "Clearing..." : "Clear DB")
                </button>
            </div>

            <div class="debug-card">
                <h3>Setup Teams Only</h3>
                <p>Creates 10 teams with 15 players each and 5 referees. No season or fixtures.</p>
                <button class="debug-btn" @onclick='() => RunAction("setup-teams")' disabled="@IsLoading">
                    @(ActiveAction == "setup-teams" ? "Setting up..." : "Setup Teams")
                </button>
            </div>

            <div class="debug-card">
                <h3>Setup Teams + Fixtures</h3>
                <p>Full squad setup plus a complete fixture schedule. All matches are unplayed.</p>
                <button class="debug-btn" @onclick='() => RunAction("setup-teams-fixtures")' disabled="@IsLoading">
                    @(ActiveAction == "setup-teams-fixtures" ? "Setting up..." : "Setup Teams + Fixtures")
                </button>
            </div>

            <div class="debug-card">
                <h3>Almost Complete Season</h3>
                <p>All fixtures played except the last one. Returns the teams and manager credentials so you can log in and complete it.</p>
                <button class="debug-btn" @onclick='() => RunAction("setup-almost-complete")' disabled="@IsLoading">
                    @(ActiveAction == "setup-almost-complete" ? "Setting up..." : "Almost Complete")
                </button>
            </div>

            <div class="debug-card">
                <h3>Setup Full Season</h3>
                <p>All fixtures played with scores and stats. Knockout bracket fully completed (Cup &amp; Plate semis and finals).</p>
                <button class="debug-btn" @onclick='() => RunAction("setup-full-season")' disabled="@IsLoading">
                    @(ActiveAction == "setup-full-season" ? "Setting up..." : "Setup Full Season")
                </button>
            </div>

            <div class="debug-card">
                <h3>Create Player Accounts</h3>
                <p>Every player in the league gets a login: new approved accounts for those without one, and existing player accounts have their password reset. Anyone without a card gets one, rated across bronze, silver and gold. Keeps all other data. Password for all: <strong>Ballers1!</strong></p>
                <button class="debug-btn" @onclick='() => RunAction("setup-player-accounts")' disabled="@IsLoading">
                    @(ActiveAction == "setup-player-accounts" ? "Creating..." : "Create Player Accounts")
                </button>
            </div>

            <div class="debug-card">
                <h3>Reset Cards to Bronze</h3>
                <p>Every existing card goes back to bronze, with its stats re-spread to a bronze rating, and gets 200 points to spend. For testing upgrades. Run "Create Player Accounts" first.</p>
                <button class="debug-btn" @onclick='() => RunAction("reset-cards-bronze")' disabled="@IsLoading">
                    @(ActiveAction == "reset-cards-bronze" ? "Resetting..." : "Reset to Bronze + 200")
                </button>
            </div>

            <div class="debug-card">
                <h3>Create Next Season</h3>
                <p>Deactivates the current season and creates the next one with a fresh unplayed fixture schedule. Teams and players are kept.</p>
                <button class="debug-btn" @onclick='() => RunAction("setup-next-season")' disabled="@IsLoading">
                    @(ActiveAction == "setup-next-season" ? "Creating..." : "Create Next Season")
                </button>
            </div>

        </div>

        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <div class="debug-status @(IsError ? "error" : "success")">
                @StatusMessage
            </div>
        }

        @if (LastFixture != null)
        {
            <div class="fixture-creds">
                <div class="creds-label">Last Fixture — log in to complete</div>
                <div class="creds-matchup">@LastFixture.HomeTeam <span>vs</span> @LastFixture.AwayTeam</div>
                <div class="creds-grid">
                    <div class="creds-team">
                        <div class="creds-role">Home Manager</div>
                        <div class="creds-email">@LastFixture.HomeManager</div>
                    </div>
                    <div class="creds-team">
                        <div class="creds-role">Away Manager</div>
                        <div class="creds-email">@LastFixture.AwayManager</div>
                    </div>
                </div>
                <div class="creds-password">Password: <strong>@LastFixture.Password</strong></div>
            </div>
        }

        <!-- ── Player accounts ── -->
        <section class="accounts">
            <div class="accounts-head">
                <h2>Player Accounts</h2>
                <button class="debug-btn" @onclick="LoadAccounts" disabled="@accountsLoading">
                    @(accountsLoading ? "Loading..." : accounts == null ? "Show accounts" : "Refresh")
                </button>
            </div>

            @if (accounts != null)
            {
                @if (accounts.Count == 0)
                {
                    <p class="accounts-empty">No player accounts yet. Use "Create Player Accounts" above.</p>
                }
                else
                {
                    <div class="accounts-filters">
                        <select @bind="teamFilter">
                            <option value="">All teams (@accounts.Count)</option>
                            @foreach (var team in accounts.Select(a => a.Team).Distinct().OrderBy(t => t))
                            {
                                <option value="@team">@team (@accounts.Count(a => a.Team == team))</option>
                            }
                        </select>
                        <input type="search" placeholder="Search name or email" @bind="search" @bind:event="oninput" />
                    </div>

                    <div class="accounts-scroll">
                        <table class="accounts-table">
                            <thead>
                                <tr>
                                    <th>Team</th>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Pos</th>
                                    <th>OVR</th>
                                    <th>Tier</th>
                                    <th>Unspent</th>
                                    <th>Email</th>
                                    <th>Password</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in FilteredAccounts)
                                {
                                    <tr>
                                        <td>@a.Team</td>
                                        <td>@a.Number</td>
                                        <td>@a.Name</td>
                                        <td>@a.Position</td>
                                        <td>@(a.Overall?.ToString() ?? "—")</td>
                                        <td>
                                            @if (a.Tier != null)
                                            {
                                                <span class="tier tier-@a.Tier">@a.Tier</span>
                                            }
                                        </td>
                                        <td>@(a.UnspentPoints?.ToString() ?? "—")</td>
                                        <td class="mono">@a.Email</td>
                                        <td class="mono">@(a.Password ?? "(their own)")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>

        <!-- ── Manager accounts ── -->
        <section class="accounts">
            <div class="accounts-head">
                <h2>Manager Accounts</h2>
                <button class="debug-btn" @onclick="LoadManagers" disabled="@managersLoading">
                    @(managersLoading ? "Loading..." : managers == null ? "Show accounts" : "Refresh")
                </button>
            </div>

            @if (managers != null)
            {
                @if (managers.Count == 0)
                {
                    <p class="accounts-empty">No manager accounts yet. Use one of the "Setup Teams" options above.</p>
                }
                else
                {
                    <div class="accounts-filters">
                        <input type="search" placeholder="Search team or email" @bind="managerSearch" @bind:event="oninput" />
                    </div>

                    <div class="accounts-scroll">
                        <table class="accounts-table">
                            <thead>
                                <tr>
                                    <th>Team</th>
                                    <th>Manager</th>
                                    <th>Email</th>
                                    <th>Password</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in FilteredManagers)
                                {
                                    <tr>
                                        <td>@m.Team</td>
                                        <td>@(m.ManagerName ?? "—")</td>
                                        <td class="mono">@m.Email</td>
                                        <td class="mono">@(m.Password ?? "(their own)")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    </div>
}

@code {
    private string? ActiveAction;
    private string StatusMessage = "";
    private bool IsError;
    private bool IsLoading => ActiveAction != null;
    private AlmostCompleteResult? LastFixture;

    private async Task RunAction(string action)
    {
        ActiveAction = action;
        StatusMessage = "";
        IsError = false;
        LastFixture = null;

        var endpoint = action switch
        {
            "clear"                  => "api/debug/clear",
            "setup-teams"            => "api/debug/setup-teams",
            "setup-teams-fixtures"   => "api/debug/setup-teams-fixtures",
            "setup-almost-complete"  => "api/debug/setup-almost-complete",
            "setup-full-season"      => "api/debug/setup-full-season",
            "setup-next-season"      => "api/debug/setup-next-season",
            "setup-player-accounts"  => "api/debug/setup-player-accounts",
            "reset-cards-bronze"     => "api/debug/reset-cards-bronze",
            _                        => throw new ArgumentException($"Unknown action: {action}")
        };

        try
        {
            var response = await Http.PostAsync(endpoint, null);
            var raw = await response.Content.ReadAsStringAsync();
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            IsError = !response.IsSuccessStatusCode;

            if (action == "setup-almost-complete" && response.IsSuccessStatusCode)
            {
                var result = System.Text.Json.JsonSerializer.Deserialize<AlmostCompleteResult>(raw, opts);
                StatusMessage = result?.Message ?? "Done.";
                LastFixture = result;
            }
            else
            {
                string? message = null;
                try { message = System.Text.Json.JsonSerializer.Deserialize<DebugResult>(raw, opts)?.Message; }
                catch { message = raw; }
                StatusMessage = message ?? (response.IsSuccessStatusCode ? "Done." : $"Failed ({(int)response.StatusCode})");
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
            IsError = true;
        }
        finally
        {
            ActiveAction = null;
        }

        // Anything that adds or wipes accounts leaves the lists out of date.
        if (accounts != null) await LoadAccounts();
        if (managers != null) await LoadManagers();
    }

    private List<ManagerAccountRow>? managers;
    private bool managersLoading;
    private string managerSearch = "";

    private IEnumerable<ManagerAccountRow> FilteredManagers => (managers ?? new())
        .Where(m => string.IsNullOrWhiteSpace(managerSearch)
                 || m.Team.Contains(managerSearch, StringComparison.OrdinalIgnoreCase)
                 || (m.Email ?? "").Contains(managerSearch, StringComparison.OrdinalIgnoreCase));

    private async Task LoadManagers()
    {
        managersLoading = true;
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            managers = await Http.GetFromJsonAsync<List<ManagerAccountRow>>("api/debug/manager-accounts", opts) ?? new();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Could not load manager accounts: {ex.Message}";
            IsError = true;
        }
        finally
        {
            managersLoading = false;
        }
    }

    private record ManagerAccountRow(string Team, string? ManagerName, string? Email, string? Password);

    private List<PlayerAccountRow>? accounts;
    private bool accountsLoading;
    private string teamFilter = "";
    private string search = "";

    private IEnumerable<PlayerAccountRow> FilteredAccounts => (accounts ?? new())
        .Where(a => teamFilter == "" || a.Team == teamFilter)
        .Where(a => string.IsNullOrWhiteSpace(search)
                 || a.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                 || (a.Email ?? "").Contains(search, StringComparison.OrdinalIgnoreCase));

    private async Task LoadAccounts()
    {
        accountsLoading = true;
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            accounts = await Http.GetFromJsonAsync<List<PlayerAccountRow>>("api/debug/player-accounts", opts) ?? new();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Could not load accounts: {ex.Message}";
            IsError = true;
        }
        finally
        {
            accountsLoading = false;
        }
    }

    private record PlayerAccountRow(string Name, string Team, int Number, string Position, string? Email,
        string? Password, int? Overall, string? Tier, int? UnspentPoints);

    private record DebugResult(string Message);
    private record AlmostCompleteResult(string Message, string HomeTeam, string AwayTeam, string HomeManager, string AwayManager, string Password);
}
