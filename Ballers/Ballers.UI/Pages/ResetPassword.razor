@page "/reset-password"
@using Ballers.Client.Auth
@using Ballers.Client.Models
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Reset Password</PageTitle>

<div class="login-page">

    <div class="login-left">
        <div class="login-card">

            <h1>Reset Password</h1>
            <p class="subtitle">Choose a new password</p>

            @if (invalidLink)
            {
                <div class="login-error">Invalid or missing reset link. Please request a new one.</div>
                <div style="margin-top:1rem;text-align:center;">
                    <a href="/forgot-password">Request new link</a>
                </div>
            }
            else if (success)
            {
                <div class="login-error" style="background:#d4edda;color:#155724;border-color:#c3e6cb;">
                    Password reset successfully. You can now log in.
                </div>
                <div style="margin-top:1rem;text-align:center;">
                    <a href="/login">Go to Login</a>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" @bind="newPassword" />
                </div>

                <div class="form-group">
                    <label>Confirm New Password</label>
                    <input type="password" @bind="confirmPassword" @onkeydown="OnKeyDown" />
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="login-error">@error</div>
                }

                <button class="login-btn" @onclick="HandleSubmit" disabled="@busy">
                    @(busy ? "Saving..." : "Reset Password")
                </button>
            }

        </div>
    </div>

    <div class="login-right">
        <div class="login-right-bg"></div>
        <div class="branding">
            <div class="brand-wordmark">
                <span class="brand-the">Blackpool</span>
                <span class="brand-name">Ballers</span>
                <span class="brand-league">League</span>
            </div>
            <p class="brand-tagline">Blackpool's Premier 11-a-Side Competition</p>
        </div>
    </div>

</div>

@code {
    [SupplyParameterFromQuery] string? email { get; set; }
    [SupplyParameterFromQuery] string? token { get; set; }

    string? newPassword;
    string? confirmPassword;
    string? error;
    bool busy;
    bool success;
    bool invalidLink;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(token))
            invalidLink = true;
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSubmit();
    }

    async Task HandleSubmit()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            error = "Both fields are required.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            error = "Passwords do not match.";
            return;
        }

        busy = true;
        var (ok, err) = await Auth.ResetPassword(new ResetPasswordRequest
        {
            Email = email!,
            Token = token!,
            NewPassword = newPassword
        });
        busy = false;

        if (ok)
            success = true;
        else
            error = err;
    }
}
