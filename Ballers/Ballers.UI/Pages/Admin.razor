@page "/admin"
@using Ballers.Services
@using Ballers.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject AdminService AdminService
@inject LeagueSettingsService LeagueSettingsSvc

<PageTitle>Admin · Overview</PageTitle>

@* The admin's home: where the season is, what needs sorting, the league's
   switches, and what has happened lately. Everything else is a section in
   the sidebar. *@
<AdminShell Section="overview" Title="Overview" Subtitle="The league at a glance, and anything that needs you.">
    <Actions>
        <button type="button" class="adm-btn" @onclick="Load" disabled="@loading">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Refresh
        </button>
    </Actions>
    <ChildContent>
        @if (overview == null)
        {
            @if (loading)
            {
                <LoadingSpinner />
            }
            else
            {
                <div class="adm-msg is-error">
                    The overview couldn't be loaded. If the API has just been updated it may need restarting.
                </div>
            }
        }
        else
        {
            var o = overview;

            <div class="adm-stats">
                <a class="adm-stat" href="/admin/season">
                    <span class="adm-stat-label">Active season</span>
                    <span class="adm-stat-value">@(o.SeasonNumber is int n ? $"Season {n}" : "None")</span>
                    <span class="adm-stat-foot">
                        @if (o.SeasonStart is { } start && o.SeasonEnd is { } end)
                        {
                            @($"{start:d MMM} – {end:d MMM yyyy}")
                        }
                        else
                        {
                            <text>Set one up in Season &amp; fixtures</text>
                        }
                    </span>
                </a>

                <div class="adm-stat">
                    <span class="adm-stat-label">Match week</span>
                    <span class="adm-stat-value">@o.CurrentWeek <small>of @o.TotalWeeks</small></span>
                    <span class="adm-bar"><span style="width:@Pct(o.CurrentWeek, o.TotalWeeks)"></span></span>
                </div>

                <a class="adm-stat" href="/manager-fixtures">
                    <span class="adm-stat-label">Fixtures played</span>
                    <span class="adm-stat-value">@o.FixturesPlayed <small>of @o.FixturesTotal</small></span>
                    <span class="adm-bar"><span style="width:@Pct(o.FixturesPlayed, o.FixturesTotal)"></span></span>
                </a>

                <a class="adm-stat" href="/admin/squads">
                    <span class="adm-stat-label">Teams · players</span>
                    <span class="adm-stat-value">@o.Teams <small>· @o.Players</small></span>
                    <span class="adm-stat-foot">@o.PlayersWithCards on player cards</span>
                </a>

                <a class="adm-stat" href="/admin/cards">
                    <span class="adm-stat-label">Last points payout</span>
                    <span class="adm-stat-value" style="font-size:1.4rem">@(o.LastPointsRunAt is { } run ? Ago(run) : "Never")</span>
                    <span class="adm-stat-foot">@(o.LastPointsRunAt?.ToLocalTime().ToString("ddd d MMM, HH:mm") ?? "Runs weekly")</span>
                </a>
            </div>

            <div class="adm-grid">
                <section class="adm-card" aria-labelledby="attention-title">
                    <div class="adm-card-head">
                        <h2 id="attention-title">Needs attention</h2>
                        @if (o.Attention.Any())
                        {
                            <span class="adm-badge is-amber">@o.Attention.Count</span>
                        }
                    </div>

                    @if (!o.Attention.Any())
                    {
                        <div class="adm-empty">
                            <span class="adm-badge is-green">All clear</span>
                            <p style="margin:10px 0 0">Nothing waiting on you right now.</p>
                        </div>
                    }
                    else
                    {
                        <div class="adm-rows">
                            @foreach (var a in o.Attention.Take(showAllAttention ? int.MaxValue : 8))
                            {
                                var (icon, tone) = AttentionLook(a.Kind);
                                <a class="adm-row" href="@a.Link">
                                    <span class="adm-dot @tone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@icon" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                                    <span class="adm-row-main">
                                        <span class="adm-row-title">@a.Title</span>
                                        <span class="adm-row-sub">@a.Detail@(a.When is { } w ? $" · {w.ToLocalTime():ddd d MMM}" : "")</span>
                                    </span>
                                    <span class="adm-muted" aria-hidden="true">›</span>
                                </a>
                            }
                        </div>
                        @if (o.Attention.Count > 8)
                        {
                            <button type="button" class="adm-btn is-small" style="margin-top:12px" @onclick="() => showAllAttention = !showAllAttention">
                                @(showAllAttention ? "Show fewer" : $"Show all {o.Attention.Count}")
                            </button>
                        }
                    }
                </section>

                <div>
                    <section class="adm-card" aria-labelledby="switches-title">
                        <div class="adm-card-head">
                            <h2 id="switches-title">League switches</h2>
                        </div>
                        <div class="adm-rows">
                            @Switch("Lock player registration", "Managers can't add players to their squads.",
                                    o.PlayersLocked, "Locked", "Open", v => SetSwitch("players", v))
                            @Switch("Lock fixtures", "Managers and referees can't submit stats or edit fixtures.",
                                    o.FixturesLocked, "Locked", "Open", v => SetSwitch("fixtures", v))
                            @Switch("Hide fixtures from the public", "For uploading a season before revealing it.",
                                    o.FixturesHidden, "Hidden", "Visible", v => SetSwitch("hidden", v))
                        </div>

                        <div class="adm-row" style="border-top:1px solid rgba(255,255,255,.06);margin-top:12px;padding-top:14px">
                            <span class="adm-row-main">
                                <span class="adm-row-title">Player card points</span>
                                <span class="adm-row-sub">Pays out any played fixture not yet credited. Safe to run any time.</span>
                            </span>
                            <button type="button" class="adm-btn is-primary" disabled="@runningPayout" @onclick="RunPayout">
                                @(runningPayout ? "Running…" : "Run payout")
                            </button>
                        </div>

                        @if (switchMessage != null)
                        {
                            <div class="adm-msg @(switchIsError ? "is-error" : "is-ok")">@switchMessage</div>
                        }
                    </section>

                    <section class="adm-card" aria-labelledby="activity-title">
                        <div class="adm-card-head">
                            <h2 id="activity-title">Recent activity</h2>
                            <span class="adm-muted" style="font-size:.8rem">Last 3 weeks</span>
                        </div>
                        @if (!o.Activity.Any())
                        {
                            <p class="adm-empty">Nothing yet.</p>
                        }
                        else
                        {
                            <div class="adm-rows">
                                @foreach (var a in o.Activity)
                                {
                                    var (icon, tone) = ActivityLook(a.Kind);
                                    <a class="adm-row" href="@a.Link">
                                        <span class="adm-dot @tone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@icon" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                                        <span class="adm-row-main">
                                            <span class="adm-row-title" style="font-weight:500">@a.Text</span>
                                            <span class="adm-row-sub">@Ago(a.When)</span>
                                        </span>
                                    </a>
                                }
                            </div>
                        }
                    </section>
                </div>
            </div>
        }
    </ChildContent>
</AdminShell>

@code {
    private AdminOverviewDto? overview;
    private bool loading = true;
    private bool showAllAttention;
    private bool runningPayout;
    private string? switchMessage;
    private bool switchIsError;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        loading = true;
        overview = await AdminService.GetOverview();
        loading = false;
    }

    private RenderFragment Switch(string title, string help, bool on, string onText, string offText, Func<bool, Task> set) =>
        @<div class="adm-row">
            <span class="adm-row-main">
                <span class="adm-row-title">@title</span>
                <span class="adm-row-sub">@help</span>
            </span>
            <label class="adm-switch">
                <input type="checkbox" role="switch" checked="@on" aria-label="@title"
                       @onchange="e => set((bool)e.Value!)" />
                <span></span>
                <em>@(on ? onText : offText)</em>
            </label>
        </div>;

    private async Task SetSwitch(string which, bool value)
    {
        if (overview == null) return;
        switchMessage = null;
        try
        {
            switch (which)
            {
                case "players":
                    await LeagueSettingsSvc.SetPlayersLocked(value);
                    overview.PlayersLocked = value;
                    switchMessage = value ? "Player registration locked." : "Player registration open.";
                    break;
                case "fixtures":
                    await LeagueSettingsSvc.SetFixturesLocked(value);
                    overview.FixturesLocked = value;
                    switchMessage = value ? "Fixtures locked for editing." : "Fixtures open for editing.";
                    break;
                case "hidden":
                    await LeagueSettingsSvc.SetFixturesHidden(value);
                    overview.FixturesHidden = value;
                    switchMessage = value ? "Fixtures hidden from the public." : "Fixtures visible to the public.";
                    break;
            }
            switchIsError = false;
        }
        catch (Exception ex)
        {
            switchIsError = true;
            switchMessage = ex.Message;
        }
    }

    private async Task RunPayout()
    {
        runningPayout = true;
        switchMessage = null;
        try
        {
            var (fixtures, players, points) = await AdminService.RunPlayerPoints();
            switchIsError = false;
            switchMessage = points == 0
                ? "Nothing to pay out: every played fixture is already settled."
                : $"Credited {points} point(s) to {players} player(s) across {fixtures} fixture(s).";
            overview = await AdminService.GetOverview() ?? overview;
        }
        catch (Exception ex)
        {
            switchIsError = true;
            switchMessage = ex.Message;
        }
        finally
        {
            runningPayout = false;
        }
    }

    private static string Pct(int part, int whole) =>
        whole <= 0 ? "0%" : $"{Math.Clamp(100.0 * part / whole, 0, 100):0}%";

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours} hr ago";
        if (span.TotalDays < 2) return "Yesterday";
        if (span.TotalDays < 14) return $"{(int)span.TotalDays} days ago";
        return utc.ToLocalTime().ToString("d MMM");
    }

    private static (string Icon, string Tone) AttentionLook(string kind) => kind switch
    {
        "stats" => ("M5 4h14v16H5zM9 9h6m-6 4h3", "is-amber"),
        "result" => ("M12 8v5m0 3h.01M10.3 3.9 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z", "is-red"),
        "referee" => ("M12 4v16M5 8l7-4 7 4M5 8v4c0 3 3 5 7 6 4-1 7-3 7-6V8", "is-blue"),
        "kickoff" => ("M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z", "is-blue"),
        "signup" => ("M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19 8v6m3-3h-6", "is-violet"),
        _ => ("M12 8v5m0 3h.01", "")
    };

    private static (string Icon, string Tone) ActivityLook(string kind) => kind switch
    {
        "result" => ("M5 12l4 4L19 6", "is-green"),
        "signup" => ("M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z", "is-violet"),
        "gallery" => ("M4 5h16v14H4zm0 10 5-5 4 4 3-3 4 4", "is-blue"),
        "motd" => ("M4 5h16v12H4zM8 21h8", "is-blue"),
        "payout" => ("M12 3v18m4-14H10a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6H8", "is-amber"),
        _ => ("M12 12h.01", "")
    };
}
