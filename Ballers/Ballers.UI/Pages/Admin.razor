@page "/admin"
@using Ballers.Client.Services
@using Ballers.Models
@using Ballers.Services
@using Ballers.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Admin")]

@inject AdminService AdminService
@inject NotificationService NotificationSvc
@inject KnockoutService KnockoutSvc
@inject LeagueSettingsService LeagueSettingsSvc
@inject IJSRuntime JS

<PageTitle>Admin</PageTitle>

<div class="admin-page">

    <div class="admin-hero">
        <div class="admin-hero-inner">
            <p class="admin-eyebrow">Admin Only</p>
            <h1>League Control</h1>
        </div>
    </div>

    <div class="admin-body">

        <!-- Quick links -->
        <div class="admin-links">
            <a href="/admin/fairplay" class="admin-link-card">Fairplay Table</a>
            <a href="/knockout" class="admin-link-card">Knockout Bracket</a>
            <a href="/admin/squads" class="admin-link-card">Squad Management</a>
            <a href="/admin/motd" class="admin-link-card">Match of the Day</a>
            <a href="/admin/true-motm" class="admin-link-card">True Man of the Match</a>
            <a href="/admin/galleries" class="admin-link-card">Match Galleries</a>
        </div>

        <div class="admin-grid">

            <!-- CREATE TEAM -->
            <div class="admin-card">
                <div class="card-header">
                    <span class="card-label">@(createTeamModel.IsReferee ? "Referee" : "Team")</span>
                    <h3>@(createTeamModel.IsReferee ? "Add Referee" : "Add New Team")</h3>
                </div>

                <EditForm EditContext="editContext" OnValidSubmit="CreateTeam">
                    <DataAnnotationsValidator />
                    <div class="form-group">
                        <label class="team-check-label" style="margin-bottom:12px;">
                            <input type="checkbox"
                                   checked="@createTeamModel.IsReferee"
                                   @onchange="(e) => createTeamModel.IsReferee = (bool)e.Value!" />
                            <span>Referee account</span>
                        </label>

                        @if (!createTeamModel.IsReferee)
                        {
                            <InputText class="form-input"
                                       placeholder="Team name"
                                       @bind-Value="createTeamModel.TeamName" />
                            <ValidationMessage For="@(() => createTeamModel.TeamName)" />
                        }

                        <InputText class="form-input"
                                   placeholder="@(createTeamModel.IsReferee ? "Referee email" : "Manager email")"
                                   @bind-Value="createTeamModel.Email" />
                        <ValidationMessage For="@(() => createTeamModel.Email)" />

                        <InputText class="form-input"
                                   type="password"
                                   placeholder="Password"
                                   @bind-Value="createTeamModel.Password" />
                        <div class="validation-wrapper">
                            <ValidationMessage For="@(() => createTeamModel.Password)" />
                        </div>
                    </div>

                    <button type="button" class="primary-btn" @onclick="SubmitForm">
                        @(createTeamModel.IsReferee ? "Create Referee" : "Create Team")
                    </button>
                </EditForm>

                @if (!string.IsNullOrEmpty(teamMessage))
                {
                    <div class="@(teamIsError ? "error-msg" : "success-msg")">@teamMessage</div>
                }
            </div>

            <!-- GENERATE FIXTURES -->
            <div class="admin-card">
                <div class="card-header">
                    <span class="card-label blue-label">Fixtures</span>
                    <h3>Generate Fixtures</h3>
                </div>

                <div class="form-group">
                    <label class="input-label">Season start date</label>
                    <InputDate @bind-Value="seasonStartDate" class="form-input date-input" />

                    <label class="input-label">Select teams</label>
                    <div class="team-grid">
                        @foreach (var t in teams)
                        {
                            <label class="team-check-label">
                                <input type="checkbox"
                                       value="@t.Id"
                                       @onchange="(e) => ToggleTeam(t.Id, e.Value)" />
                                <span>@t.Name</span>
                            </label>
                        }
                    </div>
                </div>

                @if (selectedTeamIds.Count % 2 != 0 && selectedTeamIds.Count >= 3)
                {
                    <div class="info-msg">Odd number of teams — one team per round will have a bye week.</div>
                }

                <button class="primary-btn" @onclick="GenerateFixtures">
                    Generate Fixtures
                </button>

                @if (!string.IsNullOrEmpty(fixtureMessage))
                {
                    <div class="@(fixtureIsError ? "error-msg" : "success-msg")">@fixtureMessage</div>
                }
            </div>

            <!-- IMPORT FIXTURES — full width -->
            <div class="admin-card season-card">
                <div class="card-header">
                    <span class="card-label blue-label">Import</span>
                    <h3>Import Fixtures (CSV)</h3>
                </div>

                <p class="input-label" style="margin-bottom:12px;">
                    Upload a CSV to create a whole season manually.
                    <a href="/fixtures-template.csv" download>Download the template</a>.
                    Columns: <code>MatchNumber, HomeTeam, AwayTeam, Kickoff, Location, Postcode, Referee</code>.
                    Team and referee names must match existing records exactly. Kickoff format <code>yyyy-MM-dd HH:mm</code>.
                </p>

                <div class="form-group">
                    <div style="display:flex;gap:12px;align-items:flex-end;">
                        <div style="flex:1;min-width:0;">
                            <label class="input-label">Season number</label>
                            <input type="number" min="1" class="form-input" style="width:100%;" @bind="importSeasonNumber" />
                        </div>
                        <div style="flex:1;min-width:0;">
                            <label class="input-label">Season start date</label>
                            <InputDate @bind-Value="importStartDate" class="form-input date-input" style="width:100%;" />
                        </div>
                    </div>

                    <label class="team-check-label" style="margin:12px 0;">
                        <input type="checkbox" checked="@importMakeActive"
                               @onchange="(e) => importMakeActive = (bool)e.Value!" />
                        <span>Make this the active season</span>
                    </label>

                    <InputFile id="csvInput" OnChange="OnImportFileSelected" accept=".csv" style="display:none" />
                    <label for="csvInput" class="file-pick-btn">
                        @(importFile?.Name ?? "Choose CSV file")
                    </label>
                </div>

                <button class="primary-btn" @onclick="ImportFixtures" disabled="@(importFile == null || importing)">
                    @(importing ? "Importing…" : "Import Fixtures")
                </button>

                @if (!string.IsNullOrEmpty(importMessage))
                {
                    <div class="@(importIsError ? "error-msg" : "success-msg")">@importMessage</div>
                }
                @if (importErrors.Count > 0)
                {
                    <ul class="error-msg" style="margin-top:8px;">
                        @foreach (var err in importErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                }
            </div>

            <!-- SEASONS — full width -->
            <div class="admin-card season-card">
                <div class="card-header">
                    <span class="card-label green-label">History</span>
                    <h3>Seasons</h3>
                </div>

                @if (!seasons.Any())
                {
                    <p class="empty-seasons">No seasons created yet.</p>
                }
                else
                {
                    <div class="season-list">
                        @foreach (var s in seasons.OrderByDescending(x => x.SeasonNumber))
                        {
                            <div class="season-row">
                                <div class="season-info">
                                    <span class="season-name">Season @s.SeasonNumber</span>
                                    <span class="season-dates">
                                        @s.StartDate.ToString("dd MMM yyyy") — @s.EndDate.ToString("dd MMM yyyy")
                                    </span>
                                </div>
                                <div style="display:flex;gap:8px;align-items:center;flex-shrink:0;">
                                    @if (s.IsActive)
                                    {
                                        <span class="season-badge active">Active</span>
                                    }
                                    else
                                    {
                                        <button class="activate-btn" @onclick="() => ActivateSeason(s.Id)">
                                            Activate
                                        </button>
                                    }
                                    @if (!s.IsKnockoutGenerated)
                                    {
                                        <button class="activate-btn" @onclick="() => GenerateKnockout(s.Id)">
                                            Gen Knockout
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="season-badge" style="background:rgba(96,165,250,0.1);border:1px solid rgba(96,165,250,0.25);color:#60a5fa;">Knockout</span>
                                    }
                                    <button class="activate-btn" style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.4);color:#fca5a5;" @onclick="() => DeleteSeason(s.Id, s.SeasonNumber)">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(seasonMessage))
                {
                    <div class="@(seasonIsError ? "error-msg" : "success-msg")">@seasonMessage</div>
                }
                @if (!string.IsNullOrEmpty(knockoutMessage))
                {
                    <div class="@(knockoutIsError ? "error-msg" : "success-msg")">@knockoutMessage</div>
                }
            </div>

            <!-- PLAYER REGISTRATION — full width -->
            <div class="admin-card season-card">
                <div class="card-header">
                    <span class="card-label" style="background:#dc2626;color:#fff;">Registration</span>
                    <h3>Player Registration</h3>
                </div>

                <div class="season-list">
                    <div class="season-row">
                        <div class="season-info">
                            <span class="season-name">Lock player registration</span>
                            <span class="season-dates">When locked, managers can no longer add new players to their squads. Admins can still add players.</span>
                        </div>
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox"
                                   checked="@playersLocked"
                                   @onchange="(e) => TogglePlayersLocked((bool)e.Value!)" />
                            <span>@(playersLocked ? "Locked" : "Open")</span>
                        </label>
                    </div>

                    <div class="season-row">
                        <div class="season-info">
                            <span class="season-name">Lock all fixtures for editing</span>
                            <span class="season-dates">When locked, managers and referees can no longer submit stats or edit fixtures. The Submit Stats button is removed. Admins can still edit.</span>
                        </div>
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox"
                                   checked="@fixturesLocked"
                                   @onchange="(e) => ToggleFixturesLocked((bool)e.Value!)" />
                            <span>@(fixturesLocked ? "Locked" : "Open")</span>
                        </label>
                    </div>

                    <div class="season-row">
                        <div class="season-info">
                            <span class="season-name">Hide fixtures from the public</span>
                            <span class="season-dates">When hidden, the public Fixtures page and home page show no fixtures — so you can upload a season and reveal it when ready. Admins/referees still see them.</span>
                        </div>
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox"
                                   checked="@fixturesHidden"
                                   @onchange="(e) => ToggleFixturesHidden((bool)e.Value!)" />
                            <span>@(fixturesHidden ? "Hidden" : "Visible")</span>
                        </label>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(playersLockMessage))
                {
                    <div class="@(playersLockIsError ? "error-msg" : "success-msg")">@playersLockMessage</div>
                }
            </div>

            <!-- NOTIFICATION SETTINGS — full width -->
            <div class="admin-card season-card">
                <div class="card-header">
                    <span class="card-label" style="background:#7c3aed;color:#fff;">Alerts</span>
                    <h3>Notification Settings</h3>
                </div>

                @if (notifSettings.Count == 0)
                {
                    <p class="empty-seasons">Loading...</p>
                }
                else
                {
                    <div class="season-list">
                        @foreach (var s in notifSettings)
                        {
                            <div class="season-row">
                                <div class="season-info">
                                    <span class="season-name">@s.DisplayName</span>
                                    <span class="season-dates">@s.Description</span>
                                </div>
                                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                                    <input type="checkbox"
                                           checked="@s.IsEnabled"
                                           @onchange="(e) => ToggleNotification(s, (bool)e.Value!)" />
                                    <span>@(s.IsEnabled ? "On" : "Off")</span>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@code {
    private string teamMessage = "";
    private string fixtureMessage = "";
    private string seasonMessage = "";
    private string knockoutMessage = "";
    private bool teamIsError;
    private bool fixtureIsError;
    private bool seasonIsError;
    private bool knockoutIsError;

    private bool playersLocked;
    private bool fixturesLocked;
    private bool fixturesHidden;
    private string playersLockMessage = "";
    private bool playersLockIsError;

    private int importSeasonNumber = 1;
    private DateTime importStartDate = DateTime.Today;
    private bool importMakeActive;
    private IBrowserFile? importFile;
    private bool importing;
    private string importMessage = "";
    private bool importIsError;
    private List<string> importErrors = new();

    private void OnImportFileSelected(InputFileChangeEventArgs e) => importFile = e.File;

    async Task ImportFixtures()
    {
        importMessage = "";
        importErrors = new();
        if (importFile == null) return;

        importing = true;
        try
        {
            var (created, errors) = await AdminService.ImportFixtures(importFile, importSeasonNumber, importStartDate, importMakeActive);
            if (errors.Count > 0)
            {
                importIsError = true;
                importMessage = "Import failed — fix these rows and try again:";
                importErrors = errors;
            }
            else
            {
                importIsError = false;
                importMessage = $"Imported {created} fixtures into Season {importSeasonNumber}.";
                importFile = null;
                seasons = await AdminService.GetSeasons();
            }
        }
        catch (Exception ex)
        {
            importIsError = true;
            importMessage = ex.Message;
        }
        finally
        {
            importing = false;
        }
    }

    private List<TeamDto> teams = new();
    private List<SeasonDto> seasons = new();
    private List<NotificationSettingDto> notifSettings = new();
    private List<int> selectedTeamIds = new();
    private DateTime seasonStartDate = DateTime.Today;
    private CreateTeamViewModel createTeamModel = new();
    private EditContext editContext = null!;

    private async Task SubmitForm()
    {
        if (editContext.Validate())
        {
            await CreateTeam();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(createTeamModel);
        var teamsTask = AdminService.GetTeams();
        var seasonsTask = AdminService.GetSeasons();
        var notifTask = NotificationSvc.GetSettingsAsync();
        var leagueTask = LeagueSettingsSvc.Get();
        await Task.WhenAll(teamsTask, seasonsTask, notifTask, leagueTask);
        teams = teamsTask.Result;
        seasons = seasonsTask.Result;
        notifSettings = notifTask.Result;
        playersLocked = leagueTask.Result.PlayersLocked;
        fixturesLocked = leagueTask.Result.FixturesLocked;
        fixturesHidden = leagueTask.Result.FixturesHidden;
    }

    async Task TogglePlayersLocked(bool locked)
    {
        playersLockMessage = "";
        try
        {
            await LeagueSettingsSvc.SetPlayersLocked(locked);
            playersLocked = locked;
            playersLockIsError = false;
            playersLockMessage = locked
                ? "Player registration locked."
                : "Player registration open.";
        }
        catch (Exception ex)
        {
            playersLockIsError = true;
            playersLockMessage = ex.Message;
        }
    }

    async Task ToggleFixturesLocked(bool locked)
    {
        playersLockMessage = "";
        try
        {
            await LeagueSettingsSvc.SetFixturesLocked(locked);
            fixturesLocked = locked;
            playersLockIsError = false;
            playersLockMessage = locked
                ? "All fixtures locked for editing."
                : "Fixtures unlocked for editing.";
        }
        catch (Exception ex)
        {
            playersLockIsError = true;
            playersLockMessage = ex.Message;
        }
    }

    async Task ToggleFixturesHidden(bool hidden)
    {
        playersLockMessage = "";
        try
        {
            await LeagueSettingsSvc.SetFixturesHidden(hidden);
            fixturesHidden = hidden;
            playersLockIsError = false;
            playersLockMessage = hidden
                ? "Fixtures hidden from the public."
                : "Fixtures visible to the public.";
        }
        catch (Exception ex)
        {
            playersLockIsError = true;
            playersLockMessage = ex.Message;
        }
    }

    async Task CreateTeam()
    {
        try
        {
            if (createTeamModel.IsReferee)
            {
                await AdminService.CreateReferee(createTeamModel.Email, createTeamModel.Password);
                teamMessage = "Referee created successfully.";
            }
            else
            {
                await AdminService.CreateTeam(createTeamModel.TeamName, createTeamModel.Email, createTeamModel.Password);
                teamMessage = "Team created successfully.";
                teams = await AdminService.GetTeams();
            }
            teamIsError = false;
            createTeamModel = new();
            editContext = new EditContext(createTeamModel);
        }
        catch (Exception ex)
        {
            teamMessage = ex.Message;
            teamIsError = true;
        }
    }

    void ToggleTeam(int id, object? value)
    {
        var isChecked = (bool)value!;
        if (isChecked)
            selectedTeamIds.Add(id);
        else
            selectedTeamIds.Remove(id);
    }

    async Task GenerateFixtures()
    {
        try
        {
            await AdminService.GenerateFixtures(selectedTeamIds, seasonStartDate);
            fixtureMessage = "Fixtures generated.";
            fixtureIsError = false;
            seasons = await AdminService.GetSeasons();
        }
        catch (Exception ex)
        {
            fixtureMessage = ex.Message;
            fixtureIsError = true;
        }
    }

    async Task ToggleNotification(NotificationSettingDto setting, bool isEnabled)
    {
        setting.IsEnabled = isEnabled;
        await NotificationSvc.UpdateSettingAsync(setting.Type, isEnabled);
    }

    async Task GenerateKnockout(int id)
    {
        try
        {
            await KnockoutSvc.GenerateKnockoutAsync(id);
            knockoutMessage = "Knockout bracket generated.";
            knockoutIsError = false;
            seasons = await AdminService.GetSeasons();
        }
        catch (Exception ex)
        {
            knockoutMessage = ex.Message;
            knockoutIsError = true;
        }
    }

    async Task ActivateSeason(int id)
    {
        try
        {
            await AdminService.ActivateSeason(id);
            seasonMessage = "Season activated.";
            seasonIsError = false;
            seasons = await AdminService.GetSeasons();
        }
        catch (Exception ex)
        {
            seasonMessage = ex.Message;
            seasonIsError = true;
        }
    }

    async Task DeleteSeason(int id, int seasonNumber)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Delete Season {seasonNumber}? This permanently removes all its fixtures, stats and results. This cannot be undone.");
        if (!confirmed) return;

        try
        {
            await AdminService.DeleteSeason(id);
            seasonMessage = $"Season {seasonNumber} deleted.";
            seasonIsError = false;
            seasons = await AdminService.GetSeasons();
        }
        catch (Exception ex)
        {
            seasonMessage = ex.Message;
            seasonIsError = true;
        }
    }
}
