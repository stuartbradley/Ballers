@page "/my-squad"
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject PlayerService PlayerService

@if (_editPlayer != null)
{
    <div class="edit-player-overlay" @onclick="CloseEditModal">
        <div class="edit-player-modal" @onclick:stopPropagation>
            <h3>Edit Player</h3>
            <div class="position-toggle">
                <button type="button" class="pos-btn @(_editPosition == "GK"  ? "active GK"  : "")" @onclick='() => _editPosition = "GK"'>GK</button>
                <button type="button" class="pos-btn @(_editPosition == "DEF" ? "active DEF" : "")" @onclick='() => _editPosition = "DEF"'>DEF</button>
                <button type="button" class="pos-btn @(_editPosition == "MID" ? "active MID" : "")" @onclick='() => _editPosition = "MID"'>MID</button>
                <button type="button" class="pos-btn @(_editPosition == "FWD" ? "active FWD" : "")" @onclick='() => _editPosition = "FWD"'>FWD</button>
            </div>
            <div class="add-player-row">
                <input class="form-input name-input" placeholder="Player name" @bind="_editName" autocomplete="off" />
                <input class="form-input number-input" type="number" placeholder="No." min="1" @bind="_editNumber" />
            </div>
            @if (!string.IsNullOrEmpty(_editError))
            {
                <div class="form-error">@_editError</div>
            }
            <div class="edit-modal-actions">
                <button class="add-btn" @onclick="SaveEdit">Save</button>
                <button class="remove-btn" @onclick="CloseEditModal">Cancel</button>
            </div>
        </div>
    </div>
}

<ImageCropModal IsVisible="_showCropModal"
                PlayerId="_cropPlayer?.Id ?? 0"
                Name="@(_cropPlayer?.Name ?? "")"
                Number="@(_cropPlayer?.Number ?? 0)"
                Position="@(_cropPlayer?.Position ?? "MID")"
                OnClose="@(() => _showCropModal = false)"
                OnSaved="OnPhotoSaved" />

<PageTitle>My Squad</PageTitle>

<div class="squad-page">

    <div class="squad-hero">
        <div class="squad-hero-inner">
            <p class="squad-eyebrow">Manager View</p>
            <h1>My Squad</h1>
        </div>
    </div>

    <div class="squad-body">

        @if (noTeamAssigned)
        {
            <div class="empty-state">
                <p>Your account doesn't have a team assigned. Squad management is only available to team managers.</p>
            </div>
        }
        else
        {

        <!-- Add Player Form -->
        <div class="form-card">
            <p class="form-card-label">Add Player</p>
            <form @onsubmit="AddPlayer" @onsubmit:preventDefault>

                <div class="position-toggle">
                    <button type="button" class="pos-btn @(newPosition == "GK"  ? "active GK"  : "")" @onclick='() => newPosition = "GK"'>GK</button>
                    <button type="button" class="pos-btn @(newPosition == "DEF" ? "active DEF" : "")" @onclick='() => newPosition = "DEF"'>DEF</button>
                    <button type="button" class="pos-btn @(newPosition == "MID" ? "active MID" : "")" @onclick='() => newPosition = "MID"'>MID</button>
                    <button type="button" class="pos-btn @(newPosition == "FWD" ? "active FWD" : "")" @onclick='() => newPosition = "FWD"'>FWD</button>
                </div>

                <div class="add-player-row">
                    <input class="form-input name-input"
                           placeholder="Player name"
                           @bind="newName"
                           autocomplete="off" />
                    <input class="form-input number-input"
                           type="number"
                           placeholder="No."
                           min="1"
                           @bind="newNumber" />
                    <button class="add-btn" type="submit">Add Player</button>
                </div>

                @if (!string.IsNullOrEmpty(formError))
                {
                    <div class="form-error">@formError</div>
                }

            </form>
        </div>

        <!-- Summary Strip -->
        <div class="squad-summary">
            <div class="summary-item total">
                <span class="summary-value">@players.Count</span>
                <span class="summary-label">Total</span>
            </div>
            <div class="summary-item GK">
                <span class="summary-value">@players.Count(p => p.Position == "GK")</span>
                <span class="summary-label">GK</span>
            </div>
            <div class="summary-item DEF">
                <span class="summary-value">@players.Count(p => p.Position == "DEF")</span>
                <span class="summary-label">DEF</span>
            </div>
            <div class="summary-item MID">
                <span class="summary-value">@players.Count(p => p.Position == "MID")</span>
                <span class="summary-label">MID</span>
            </div>
            <div class="summary-item FWD">
                <span class="summary-value">@players.Count(p => p.Position == "FWD")</span>
                <span class="summary-label">FWD</span>
            </div>
        </div>

        <!-- Player List -->
        @if (isLoading)
        {
            <LoadingSpinner />
        }
        else if (players.Count == 0)
        {
            <div class="empty-state">
                <p>No players yet. Use the form above to build your squad.</p>
            </div>
        }
        else
        {
            @foreach (var group in GroupedPlayers)
            {
                <div class="position-group">
                    <div class="group-header">
                        <span class="group-badge @group.Key">@group.Key</span>
                        <span class="group-count">@group.Count() player@(group.Count() == 1 ? "" : "s")</span>
                    </div>
                    <div class="squad-grid">
                        @foreach (var p in group.OrderBy(x => x.Number))
                        {
                            <PlayerCard Name="@p.Name"
                                            Number="@p.Number"
                                            Position="@p.Position"
                                            ImageUrl="@p.ImageUrl"
                                            OnRemove="@(() => RemovePlayer(p.Id))"
                                            OnEditPhoto="@(() => OpenCropModal(p))"
                                            OnEdit="@(() => OpenEditModal(p))" />
                        }
                    </div>
                </div>
            }
        }

        }

    </div>

</div>

@code {

    private static readonly string[] PositionOrder = ["GK", "DEF", "MID", "FWD"];

    private List<PlayerDto> players = new();
    private bool isLoading = true;
    private bool noTeamAssigned = false;
    private string newName = "";
    private int newNumber;
    private string newPosition = "MID";
    private string formError = "";

    private bool _showCropModal;
    private PlayerDto? _cropPlayer;

    private PlayerDto? _editPlayer;
    private string _editName = "";
    private int _editNumber;
    private string _editPosition = "MID";
    private string _editError = "";

    private IEnumerable<IGrouping<string, PlayerDto>> GroupedPlayers =>
        players.GroupBy(p => p.Position)
               .OrderBy(g => Array.IndexOf(PositionOrder, g.Key) is int i && i >= 0 ? i : 99);

    protected override async Task OnInitializedAsync()
    {
        await LoadPlayers();
    }

    async Task LoadPlayers()
    {
        try
        {
            players = await PlayerService.GetMyPlayers();
        }
        catch
        {
            noTeamAssigned = true;
        }
        isLoading = false;
    }

    async Task AddPlayer()
    {
        formError = "";
        if (string.IsNullOrWhiteSpace(newName))
        {
            formError = "Please enter a player name.";
            return;
        }
        if (newNumber <= 0)
        {
            formError = "Please enter a valid squad number.";
            return;
        }

        try
        {
            await PlayerService.AddPlayer(newName, newNumber, newPosition);
            newName = "";
            newNumber = 0;
            newPosition = "MID";
            await LoadPlayers();
        }
        catch
        {
            formError = "Failed to add player. Please try again.";
        }
    }

    async Task RemovePlayer(int id)
    {
        formError = "";
        try
        {
            await PlayerService.RemovePlayer(id);
            await LoadPlayers();
        }
        catch
        {
            formError = "Failed to remove player. Please try again.";
        }
    }

    void OpenCropModal(PlayerDto player)
    {
        _cropPlayer = player;
        _showCropModal = true;
    }

    void OpenEditModal(PlayerDto player)
    {
        _editPlayer = player;
        _editName = player.Name;
        _editNumber = player.Number;
        _editPosition = player.Position;
        _editError = "";
    }

    void CloseEditModal()
    {
        _editPlayer = null;
        _editError = "";
    }

    async Task SaveEdit()
    {
        _editError = "";
        if (string.IsNullOrWhiteSpace(_editName)) { _editError = "Name is required."; return; }
        if (_editNumber <= 0) { _editError = "Valid squad number required."; return; }

        try
        {
            await PlayerService.UpdatePlayer(_editPlayer!.Id, _editName, _editNumber, _editPosition);
            _editPlayer = null;
            await LoadPlayers();
        }
        catch
        {
            _editError = "Failed to save. Please try again.";
        }
    }

    async Task OnPhotoSaved()
    {
        _showCropModal = false;
        await LoadPlayers();
    }
}
