@page "/my-squad"
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Manager,Admin")]
@inherits ViewModelComponent<MySquadViewModel>


@if (Vm.EditPlayer != null)
{
    <div class="edit-player-overlay" @onclick="Vm.CloseEditModal">
        <div class="edit-player-modal" @onclick:stopPropagation>
            <h3>Edit Player</h3>
            <div class="position-toggle">
                <button type="button" class="pos-btn @(Vm.EditPosition == "GK"  ? "active GK"  : "")" @onclick='() => Vm.EditPosition = "GK"'>GK</button>
                <button type="button" class="pos-btn @(Vm.EditPosition == "DEF" ? "active DEF" : "")" @onclick='() => Vm.EditPosition = "DEF"'>DEF</button>
                <button type="button" class="pos-btn @(Vm.EditPosition == "MID" ? "active MID" : "")" @onclick='() => Vm.EditPosition = "MID"'>MID</button>
                <button type="button" class="pos-btn @(Vm.EditPosition == "FWD" ? "active FWD" : "")" @onclick='() => Vm.EditPosition = "FWD"'>FWD</button>
            </div>
            <div class="add-player-row">
                <input class="form-input name-input" placeholder="Player name" @bind="Vm.EditName" autocomplete="off" />
                <input class="form-input number-input" type="number" placeholder="No." min="1" @bind="Vm.EditNumber" />
            </div>
            @if (!string.IsNullOrEmpty(Vm.EditError))
            {
                <div class="form-error">@Vm.EditError</div>
            }
            <div class="edit-modal-actions">
                <button class="add-btn" @onclick="Vm.SaveEdit">Save</button>
                <button class="remove-btn" @onclick="Vm.CloseEditModal">Cancel</button>
            </div>
        </div>
    </div>
}

<ImageCropModal IsVisible="Vm.ShowCropModal"
                PlayerId="Vm.CropPlayer?.Id ?? 0"
                Name="@(Vm.CropPlayer?.Name ?? "")"
                Number="@(Vm.CropPlayer?.Number ?? 0)"
                Position="@(Vm.CropPlayer?.Position ?? "MID")"
                OnClose="@(() => Vm.ShowCropModal = false)"
                OnSaved="Vm.OnPhotoSaved" />

<PageTitle>My Squad</PageTitle>

<div class="squad-page">
    @* The manager's own menu; admins and referees use this page too. *@
    <AuthorizeView Roles="Manager"><ManagerNav Current="squad" /></AuthorizeView>


    <div class="squad-hero">
        <div class="squad-hero-inner">
            <p class="squad-eyebrow">Manager View</p>
            <h1>My Squad</h1>
        </div>
    </div>

    <div class="squad-body">

        @if (Vm.NoTeamAssigned)
        {
            <div class="empty-state">
                <p>Your account doesn't have a team assigned. Squad management is only available to team managers.</p>
            </div>
        }
        else
        {

        @if (Vm.AccountRequests.Count > 0)
        {
            <!-- Players waiting to be let in. Until approved their account can do
                 nothing, so this is the only thing standing between them and a card. -->
            <div class="form-card">
                <p class="form-card-label">Player Sign-ups Waiting (@Vm.AccountRequests.Count)</p>

                @if (!string.IsNullOrEmpty(Vm.RequestError))
                {
                    <div class="form-error">@Vm.RequestError</div>
                }

                <div class="account-requests">
                    @foreach (var request in Vm.AccountRequests)
                    {
                        <div class="account-request">
                            <div class="account-request-who">
                                <span class="account-request-name">@request.RequestedName</span>
                                <span class="account-request-email">@request.Email</span>
                                <span class="account-request-claim">
                                    @if (request.PlayerId != null)
                                    {
                                        @($"Claiming {request.PlayerName}")
                                    }
                                    else
                                    {
                                        @("Not on the squad list yet — approving adds them")
                                    }
                                </span>
                            </div>
                            <div class="account-request-actions">
                                <button type="button" class="add-btn"
                                        disabled="@(Vm.ResolvingRequestId == request.Id)"
                                        @onclick="() => Vm.ApproveRequest(request.Id)">Approve</button>
                                <button type="button" class="remove-btn"
                                        disabled="@(Vm.ResolvingRequestId == request.Id)"
                                        @onclick="() => Vm.RejectRequest(request.Id)">Reject</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Vm.PlayersLocked && !Vm.IsAdmin)
        {
            <!-- Registration locked by admin -->
            <div class="form-card">
                <p class="form-card-label">Add Player</p>
                <div class="form-error">Player registration is locked. New players can no longer be added.</div>
            </div>
        }
        else
        {
        <!-- Add Player Form -->
        <div class="form-card">
            <p class="form-card-label">Add Player</p>
            <form @onsubmit="Vm.AddPlayer" @onsubmit:preventDefault>

                <div class="position-toggle">
                    <button type="button" class="pos-btn @(Vm.NewPosition == "GK"  ? "active GK"  : "")" @onclick='() => Vm.NewPosition = "GK"'>GK</button>
                    <button type="button" class="pos-btn @(Vm.NewPosition == "DEF" ? "active DEF" : "")" @onclick='() => Vm.NewPosition = "DEF"'>DEF</button>
                    <button type="button" class="pos-btn @(Vm.NewPosition == "MID" ? "active MID" : "")" @onclick='() => Vm.NewPosition = "MID"'>MID</button>
                    <button type="button" class="pos-btn @(Vm.NewPosition == "FWD" ? "active FWD" : "")" @onclick='() => Vm.NewPosition = "FWD"'>FWD</button>
                </div>

                <div class="add-player-row">
                    <input class="form-input name-input"
                           placeholder="Player name"
                           @bind="Vm.NewName"
                           autocomplete="off" />
                    <input class="form-input number-input"
                           type="number"
                           placeholder="No."
                           min="1"
                           @bind="Vm.NewNumber" />
                    <button class="add-btn" type="submit">Add Player</button>
                </div>

                @if (!string.IsNullOrEmpty(Vm.FormError))
                {
                    <div class="form-error">@Vm.FormError</div>
                }

            </form>
        </div>
        }

        <!-- Summary Strip -->
        <div class="squad-summary">
            <div class="summary-item total">
                <span class="summary-value">@Vm.Players.Count</span>
                <span class="summary-label">Total</span>
            </div>
            <div class="summary-item GK">
                <span class="summary-value">@Vm.Players.Count(p => p.Position == "GK")</span>
                <span class="summary-label">GK</span>
            </div>
            <div class="summary-item DEF">
                <span class="summary-value">@Vm.Players.Count(p => p.Position == "DEF")</span>
                <span class="summary-label">DEF</span>
            </div>
            <div class="summary-item MID">
                <span class="summary-value">@Vm.Players.Count(p => p.Position == "MID")</span>
                <span class="summary-label">MID</span>
            </div>
            <div class="summary-item FWD">
                <span class="summary-value">@Vm.Players.Count(p => p.Position == "FWD")</span>
                <span class="summary-label">FWD</span>
            </div>
        </div>

        <!-- Player List -->
        @if (Vm.IsLoading)
        {
            <LoadingSpinner />
        }
        else if (Vm.Players.Count == 0)
        {
            <div class="empty-state">
                <p>No players yet. Use the form above to build your squad.</p>
            </div>
        }
        else
        {
            @foreach (var group in Vm.GroupedPlayers)
            {
                <div class="position-group">
                    <div class="group-header">
                        <span class="group-badge @group.Key">@group.Key</span>
                        <span class="group-count">@group.Count() player@(group.Count() == 1 ? "" : "s")</span>
                    </div>
                    <div class="squad-grid">
                        @foreach (var p in group.OrderBy(x => x.Number))
                        {
                            <PlayerCard Name="@p.Name"
                                            Number="@p.Number"
                                            Position="@p.Position"
                                            ImageUrl="@p.ImageUrl"
                                            OnRemove="@(() => Vm.RemovePlayer(p.Id))"
                                            OnEditPhoto="@(() => Vm.OpenCropModal(p))"
                                            OnEdit="@(() => Vm.OpenEditModal(p))" />
                        }
                    </div>
                </div>
            }
        }

        }

    </div>

</div>

@code {
    // The squad and its actions are in MySquadViewModel.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();
}
