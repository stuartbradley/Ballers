@page "/stats"
@using Ballers.Models
@using Ballers.Services
@inherits ViewModelComponent<StatsViewModel>
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Player Stats | Ballers</PageTitle>

@* The league's numbers: a strip of season totals, the leaders in each
   category, and a full table of players (or of teams). A player's row opens
   to show their card. *@
<div class="stats-page" id="stats-page">

    <PageHero Eyebrow="Ballers League" Title="Stats" Subtitle="Who's scoring, who's creating and who's keeping them out." />

    <div class="st-body">
        @if (Vm.IsLoading)
        {
            <div class="st-loading"><LoadingSpinner /></div>
        }
        else
        {
            <div class="st-controls">
                <div class="st-tabs" role="tablist" aria-label="Show stats for">
                    <button type="button" role="tab" class="st-tab @(Vm.Tab == "players" ? "is-active" : "")"
                            aria-selected="@(Vm.Tab == "players" ? "true" : "false")"
                            @onclick='() => Vm.Tab = "players"'>Players</button>
                    @if (Vm.TeamStats.Any())
                    {
                        <button type="button" role="tab" class="st-tab @(Vm.Tab == "teams" ? "is-active" : "")"
                                aria-selected="@(Vm.Tab == "teams" ? "true" : "false")"
                                @onclick='() => Vm.Tab = "teams"'>Teams</button>
                    }
                </div>

                <label class="st-season">
                    <span class="st-label">Season</span>
                    <select @bind="Vm.SelectedSeasonId" @bind:after="Vm.LoadSeason">
                        <option value="0">All seasons</option>
                        @foreach (var s in Vm.Seasons)
                        {
                            <option value="@s.Id">Season @s.SeasonNumber</option>
                        }
                    </select>
                </label>
            </div>

            @* Keyed by season so the numbers are rebuilt, and count up again,
               when the season changes. *@
            @if (Vm.GamesPlayed > 0)
            {
                <div class="st-totals" @key="Vm.SelectedSeasonId">
                    <div class="st-total"><strong data-count="@Vm.GamesPlayed">@Vm.GamesPlayed</strong><span>Games played</span></div>
                    <div class="st-total"><strong data-count="@Vm.TotalGoals">@Vm.TotalGoals</strong><span>Goals</span></div>
                    <div class="st-total"><strong>@Vm.GoalsPerGame</strong><span>Goals per game</span></div>
                    <div class="st-total"><strong data-count="@Vm.TotalCleanSheets">@Vm.TotalCleanSheets</strong><span>Clean sheets</span></div>
                    <div class="st-total st-total-yellow"><strong data-count="@Vm.TotalYellows">@Vm.TotalYellows</strong><span>Yellow cards</span></div>
                    <div class="st-total st-total-red"><strong data-count="@Vm.TotalReds">@Vm.TotalReds</strong><span>Red cards</span></div>
                </div>
            }

            @if (Vm.Tab == "teams" && Vm.TeamStats.Any())
            {
                @TeamsView
            }
            else if (!Vm.AllPlayers.Any())
            {
                <div class="st-empty">
                    <p class="st-empty-title">No stats yet</p>
                    <p class="st-empty-sub">Stats will appear here once fixtures have been played and results recorded.</p>
                </div>
            }
            else
            {
                @PlayersView
            }
        }
    </div>
</div>

@code {
    // The page's state and logic are in StatsViewModel; the view fragments and
    // the browser calls (scrolling, the count-up) stay here.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Vm.IsLoading || !Vm.RevealPending) return;
        Vm.RevealPending = false;
        try { await JS.InvokeVoidAsync("homeReveal.scan", "stats-page"); }
        catch (JSException) { /* decoration only */ }
    }

    void OnRowKey(KeyboardEventArgs e, int playerId)
    {
        if (e.Key is "Enter" or " ") Vm.Toggle(playerId);
    }

    // Opens the player's row, then scrolls to it once it's drawn.
    async Task ShowPlayer(int playerId)
    {
        Vm.ShowPlayer(playerId);
        StateHasChanged();
        await Task.Yield();
        try { await JS.InvokeVoidAsync("scrollToId", $"player-{playerId}"); }
        catch (JSException) { /* the row is open either way */ }
    }

    // A tiny card in the player's tier with their rating on it; a plain
    // number badge for players without a card.
    RenderFragment MiniCard(PlayerLeaderboardDto p) => p.Attributes != null && p.Tier != null
        ? @<span class="st-mini st-mini-@p.Tier" title="@($"{p.Tier} card, rated {p.Attributes.Overall}")"><span>@p.Attributes.Overall</span></span>
        : @<span class="st-mini st-mini-none" title="No card yet"><span>#@p.Number</span></span>;

    RenderFragment PlayersView => @<text>
        @if (Vm.Leaders.Any())
        {
            <section class="st-leaders" aria-label="League leaders">
                @foreach (var l in Vm.Leaders)
                {
                    var (first, firstValue) = l.Top[0];
                    <article class="st-leader">
                        <span class="st-leader-title">@l.Title</span>
                        <button type="button" class="st-leader-main" @onclick="() => ShowPlayer(first.PlayerId)">
                            @MiniCard(first)
                            <span class="st-leader-who">
                                <span class="st-leader-name">@first.Name</span>
                                <span class="st-leader-team">@first.Team</span>
                            </span>
                            <span class="st-leader-value">@firstValue</span>
                        </button>
                        @if (l.Top.Count > 1)
                        {
                            <ol class="st-runners" start="2">
                                @foreach (var (p, v) in l.Top.Skip(1))
                                {
                                    <li>
                                        <span class="st-runner-name">@p.Name</span>
                                        <span class="st-runner-value">@v</span>
                                    </li>
                                }
                            </ol>
                        }
                    </article>
                }
            </section>
        }

        <div class="st-filters">
            <div class="st-chips" role="group" aria-label="Position">
                @foreach (var pos in new[] { "All", "GK", "DEF", "MID", "FWD" })
                {
                    <button type="button" class="st-chip @(Vm.SelectedPos == pos ? "is-active" : "")"
                            aria-pressed="@(Vm.SelectedPos == pos ? "true" : "false")"
                            @onclick="() => Vm.SelectedPos = pos">@pos</button>
                }
            </div>
            <input class="st-search" type="search" placeholder="Search player…" aria-label="Search player"
                   @bind="Vm.NameSearch" @bind:event="oninput" />
        </div>

        <div class="st-table-wrap">
            <table class="st-table st-players">
                <thead>
                    <tr>
                        <th class="c-rank">#</th>
                        <th class="c-player @Vm.SortClass("name")" aria-sort="@Vm.AriaSort("name")" @onclick='() => Vm.SortBy("name")'>Player</th>
                        <th class="c-team @Vm.SortClass("team")" aria-sort="@Vm.AriaSort("team")" @onclick='() => Vm.SortBy("team")'>Team</th>
                        <th class="c-num c-apps @Vm.SortClass("apps")" aria-sort="@Vm.AriaSort("apps")" @onclick='() => Vm.SortBy("apps")' title="Appearances">Apps</th>
                        <th class="c-num c-goals @Vm.SortClass("goals")" aria-sort="@Vm.AriaSort("goals")" @onclick='() => Vm.SortBy("goals")' title="Goals">G</th>
                        <th class="c-num c-assists @Vm.SortClass("assists")" aria-sort="@Vm.AriaSort("assists")" @onclick='() => Vm.SortBy("assists")' title="Assists">A</th>
                        <th class="c-num c-gpg @Vm.SortClass("gpg")" aria-sort="@Vm.AriaSort("gpg")" @onclick='() => Vm.SortBy("gpg")' title="Goals per game">G/Gm</th>
                        <th class="c-num c-cs @Vm.SortClass("cs")" aria-sort="@Vm.AriaSort("cs")" @onclick='() => Vm.SortBy("cs")' title="Clean sheets">CS</th>
                        <th class="c-num c-motm @Vm.SortClass("motm")" aria-sort="@Vm.AriaSort("motm")" @onclick='() => Vm.SortBy("motm")' title="Man of the Match">MOTM</th>
                        <th class="c-num c-card @Vm.SortClass("yellow")" aria-sort="@Vm.AriaSort("yellow")" @onclick='() => Vm.SortBy("yellow")' title="Yellow cards"><span class="st-card-icon is-yellow"></span></th>
                        <th class="c-num c-card @Vm.SortClass("red")" aria-sort="@Vm.AriaSort("red")" @onclick='() => Vm.SortBy("red")' title="Red cards"><span class="st-card-icon is-red"></span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Vm.Filtered.Any())
                    {
                        <tr><td colspan="11" class="st-empty-row">No players match.</td></tr>
                    }
                    else
                    {
                        var rank = 1;
                        @foreach (var p in Vm.Sorted)
                        {
                            var open = Vm.ExpandedId == p.PlayerId;
                            var r = rank++;
                            <tr class="st-row @(r <= 3 ? $"is-top{r}" : "") @(open ? "is-open" : "")" id="player-@p.PlayerId"
                                tabindex="0" aria-expanded="@(open ? "true" : "false")"
                                @onclick="() => Vm.Toggle(p.PlayerId)" @onkeydown="e => OnRowKey(e, p.PlayerId)">
                                <td class="c-rank"><span class="st-rank">@r</span></td>
                                <td class="c-player">
                                    <span class="st-player">
                                        @MiniCard(p)
                                        <span class="st-player-text">
                                            <span class="st-player-name">@p.Name</span>
                                            <span class="st-pos st-pos-@p.Position.ToLower()">@p.Position</span>
                                        </span>
                                        <span class="st-chevron" aria-hidden="true"></span>
                                    </span>
                                </td>
                                <td class="c-team">@p.Team</td>
                                <td class="c-num c-apps">@p.Appearances</td>
                                <td class="c-num c-goals">@p.Goals</td>
                                <td class="c-num c-assists">@p.Assists</td>
                                <td class="c-num c-gpg">@(p.Appearances == 0 ? "–" : StatsViewModel.PerGame(p.Goals, p.Appearances).ToString("0.00"))</td>
                                <td class="c-num c-cs">@(StatsViewModel.EarnsCleanSheets(p.Position) ? p.CleanSheets.ToString() : "–")</td>
                                <td class="c-num c-motm">@(p.Motm > 0 ? p.Motm.ToString() : "–")</td>
                                <td class="c-num c-card">@(p.YellowCards > 0 ? p.YellowCards.ToString() : "–")</td>
                                <td class="c-num c-card @(p.RedCards > 0 ? "is-red" : "")">@(p.RedCards > 0 ? p.RedCards.ToString() : "–")</td>
                            </tr>
                            @if (open)
                            {
                                <tr class="st-detail-row">
                                    <td colspan="11">
                                        @PlayerDetail(p)
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </text>;

    RenderFragment PlayerDetail(PlayerLeaderboardDto p) => @<div class="st-detail">
        <div class="st-detail-card">
            <PlayerCard Name="@p.Name" Number="@p.Number" Position="@p.Position"
                        Goals="@p.Goals" Assists="@p.Assists" Motm="@p.Motm" CleanSheets="@p.CleanSheets"
                        Attributes="@p.Attributes" Tier="@p.Tier" />
        </div>
        <div class="st-detail-body">
            <p class="st-detail-head">
                <span class="st-detail-name">@p.Name</span>
                <span class="st-detail-sub">#@p.Number · @p.Position · <a href="/team/@p.TeamId">@p.Team</a></span>
            </p>
            <dl class="st-detail-stats">
                <div><dt>Appearances</dt><dd>@p.Appearances</dd></div>
                <div><dt>Goals</dt><dd>@p.Goals</dd></div>
                <div><dt>Assists</dt><dd>@p.Assists</dd></div>
                <div><dt>Goal involvements</dt><dd>@(p.Goals + p.Assists)</dd></div>
                <div><dt>Goals per game</dt><dd>@StatsViewModel.PerGame(p.Goals, p.Appearances).ToString("0.00")</dd></div>
                <div><dt>Involvements per game</dt><dd>@StatsViewModel.PerGame(p.Goals + p.Assists, p.Appearances).ToString("0.00")</dd></div>
                @if (StatsViewModel.EarnsCleanSheets(p.Position))
                {
                    <div><dt>Clean sheets</dt><dd>@p.CleanSheets</dd></div>
                }
                <div><dt>Man of the Match</dt><dd>@p.Motm</dd></div>
                @if (p.OwnGoals > 0)
                {
                    <div><dt>Own goals</dt><dd>@p.OwnGoals</dd></div>
                }
                <div><dt>Cards</dt><dd><span class="st-card-icon is-yellow"></span>@p.YellowCards <span class="st-card-icon is-red"></span>@p.RedCards</dd></div>
            </dl>
            @if (p.Attributes == null)
            {
                <p class="st-detail-note">No player card yet.</p>
            }
        </div>
    </div>;

    RenderFragment Crest(TeamStatsDto t) => !string.IsNullOrEmpty(t.ProfileImageUrl)
        ? @<img class="st-crest" src="@(Http.BaseAddress!.ToString().TrimEnd('/') + t.ProfileImageUrl)" alt="" />
        : @<span class="st-crest st-crest-none">@Format.TeamInitials(t.Name)</span>;

    RenderFragment TeamsView => @<text>
        <section class="st-highlights" aria-label="Team highlights">
            @foreach (var h in Vm.TeamHighlights)
            {
                <a class="st-highlight" href="/team/@h.Team.TeamId" style="@Format.KitStyle(h.Team.HomeKitColour)">
                    <span class="st-leader-title">@h.Title</span>
                    <span class="st-highlight-team">@Crest(h.Team)<span>@h.Team.Name</span></span>
                    <span class="st-highlight-value">@h.Value</span>
                </a>
            }
        </section>

        <div class="st-table-wrap">
            <table class="st-table st-teams">
                <thead>
                    <tr>
                        <th class="c-rank">#</th>
                        <th class="c-player @Vm.TeamSortClass("name")" aria-sort="@Vm.TeamAriaSort("name")" @onclick='() => Vm.SortTeamsBy("name")'>Team</th>
                        <th class="c-num t-p @Vm.TeamSortClass("p")" aria-sort="@Vm.TeamAriaSort("p")" @onclick='() => Vm.SortTeamsBy("p")' title="Played">P</th>
                        <th class="c-num t-w @Vm.TeamSortClass("w")" aria-sort="@Vm.TeamAriaSort("w")" @onclick='() => Vm.SortTeamsBy("w")' title="Won">W</th>
                        <th class="c-num t-d @Vm.TeamSortClass("d")" aria-sort="@Vm.TeamAriaSort("d")" @onclick='() => Vm.SortTeamsBy("d")' title="Drawn">D</th>
                        <th class="c-num t-l @Vm.TeamSortClass("l")" aria-sort="@Vm.TeamAriaSort("l")" @onclick='() => Vm.SortTeamsBy("l")' title="Lost">L</th>
                        <th class="c-num c-goals @Vm.TeamSortClass("gf")" aria-sort="@Vm.TeamAriaSort("gf")" @onclick='() => Vm.SortTeamsBy("gf")' title="Goals for">GF</th>
                        <th class="c-num t-ga @Vm.TeamSortClass("ga")" aria-sort="@Vm.TeamAriaSort("ga")" @onclick='() => Vm.SortTeamsBy("ga")' title="Goals against">GA</th>
                        <th class="c-num t-gd @Vm.TeamSortClass("gd")" aria-sort="@Vm.TeamAriaSort("gd")" @onclick='() => Vm.SortTeamsBy("gd")' title="Goal difference">GD</th>
                        <th class="c-num c-cs @Vm.TeamSortClass("cs")" aria-sort="@Vm.TeamAriaSort("cs")" @onclick='() => Vm.SortTeamsBy("cs")' title="Clean sheets">CS</th>
                        <th class="c-num c-card @Vm.TeamSortClass("yellow")" aria-sort="@Vm.TeamAriaSort("yellow")" @onclick='() => Vm.SortTeamsBy("yellow")' title="Yellow cards"><span class="st-card-icon is-yellow"></span></th>
                        <th class="c-num c-card @Vm.TeamSortClass("red")" aria-sort="@Vm.TeamAriaSort("red")" @onclick='() => Vm.SortTeamsBy("red")' title="Red cards"><span class="st-card-icon is-red"></span></th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rank = 1; }
                    @foreach (var t in Vm.SortedTeams)
                    {
                        var r = rank++;
                        var gd = t.GoalsFor - t.GoalsAgainst;
                        <tr class="st-row @(r <= 3 ? $"is-top{r}" : "")" style="@Format.KitStyle(t.HomeKitColour)">
                            <td class="c-rank"><span class="st-rank">@r</span></td>
                            <td class="c-player">
                                <a class="st-team-link" href="/team/@t.TeamId">@Crest(t)<span>@t.Name</span></a>
                            </td>
                            <td class="c-num t-p">@t.Played</td>
                            <td class="c-num t-w">@t.Won</td>
                            <td class="c-num t-d">@t.Drawn</td>
                            <td class="c-num t-l">@t.Lost</td>
                            <td class="c-num c-goals">@t.GoalsFor</td>
                            <td class="c-num t-ga">@t.GoalsAgainst</td>
                            <td class="c-num t-gd @(gd > 0 ? "is-pos" : gd < 0 ? "is-neg" : "")">@(gd > 0 ? $"+{gd}" : gd.ToString())</td>
                            <td class="c-num c-cs">@t.CleanSheets</td>
                            <td class="c-num c-card">@t.YellowCards</td>
                            <td class="c-num c-card @(t.RedCards > 0 ? "is-red" : "")">@t.RedCards</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </text>;
}
