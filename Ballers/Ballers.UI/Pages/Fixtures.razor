@page "/fixtures"
@using Ballers.Components
@using Ballers.Models
@using Ballers.Services
@inject IJSRuntime JS
@inherits ViewModelComponent<FixturesViewModel>

<PageTitle>Fixtures</PageTitle>

@* The season in two lists: games still to play, from this week on, and
   results, newest first. A strip of week chips jumps to any week, and a team
   filter narrows both lists to one side. *@
<div class="fixtures-page">

    <!-- ── HEADER ── -->
    <header class="fx-hero">
        <span class="fx-eyebrow">@(Vm.SelectedSeason is { } season ? $"Season {season.SeasonNumber}" : "Ballers League")</span>
        <h1>Fixtures</h1>
        @if (!Vm.IsLoading && Vm.AllWeeks.Any())
        {
            <p class="fx-sub">
                @Vm.PlayedCount of @Vm.TotalCount games played
                @if (Vm.CurrentWeek != null)
                {
                    <span>· Match week @Vm.CurrentWeek.WeekNumber is up next</span>
                }
            </p>
        }
    </header>

    <!-- ── TOOLBAR (stays in view) ── -->
    <div class="fx-toolbar">
        <div class="fx-toolbar-inner">
            <div class="fx-tabs" role="tablist" aria-label="Fixtures or results">
                <button type="button" role="tab" class="fx-tab @(Vm.SelectedTab == FixturesViewModel.Tab.Upcoming ? "is-active" : "")"
                        aria-selected="@(Vm.SelectedTab == FixturesViewModel.Tab.Upcoming ? "true" : "false")"
                        @onclick="() => Vm.SetTab(FixturesViewModel.Tab.Upcoming)">
                    Upcoming <span class="fx-count">@Vm.UpcomingCount</span>
                </button>
                <button type="button" role="tab" class="fx-tab @(Vm.SelectedTab == FixturesViewModel.Tab.Results ? "is-active" : "")"
                        aria-selected="@(Vm.SelectedTab == FixturesViewModel.Tab.Results ? "true" : "false")"
                        @onclick="() => Vm.SetTab(FixturesViewModel.Tab.Results)">
                    Results <span class="fx-count">@Vm.PlayedCount</span>
                </button>
            </div>

            <div class="fx-filters">
                <label class="fx-select">
                    <span class="visually-hidden">Team</span>
                    <select @bind="Vm.TeamFilter">
                        <option value="">All teams</option>
                        @foreach (var team in Vm.Teams)
                        {
                            <option value="@team">@team</option>
                        }
                    </select>
                </label>
                <label class="fx-select">
                    <span class="visually-hidden">Season</span>
                    <select value="@Vm.SelectedSeasonId" @onchange="OnSeasonChanged">
                        @foreach (var s in Vm.Seasons)
                        {
                            <option value="@s.Id">Season @s.SeasonNumber</option>
                        }
                    </select>
                </label>
            </div>
        </div>

        @* One chip per week in the list below. *@
        @if (!Vm.IsLoading && Vm.VisibleWeeks.Any())
        {
            <nav class="fx-weeks" aria-label="Jump to a week">
                @foreach (var week in Vm.VisibleWeeks)
                {
                    var isCurrent = week.WeekNumber == Vm.CurrentWeek?.WeekNumber;
                    <button type="button"
                            class="fx-week-chip @(isCurrent ? "is-current" : "")"
                            aria-current="@(isCurrent ? "true" : null)"
                            title="@week.DateRange"
                            @onclick="() => JumpTo(week.WeekNumber)">
                        W@(week.WeekNumber)
                    </button>
                }
            </nav>
        }
    </div>

    <!-- ── THE LIST ── -->
    <div class="fx-body">
        @if (Vm.IsLoading)
        {
            <LoadingSpinner />
        }
        else if (!Vm.AllWeeks.Any())
        {
            <div class="fx-empty">No fixtures scheduled yet.</div>
        }
        else if (!Vm.VisibleWeeks.Any())
        {
            <div class="fx-empty">
                @(Vm.SelectedTab == FixturesViewModel.Tab.Upcoming ? "No games left to play" : "No results yet")@(string.IsNullOrEmpty(Vm.TeamFilter) ? "." : $" for {Vm.TeamFilter}.")
            </div>
        }
        else if (Vm.SelectedTab == FixturesViewModel.Tab.Upcoming)
        {
            @foreach (var week in Vm.VisibleWeeks)
            {
                <section class="fx-week @(week.WeekNumber == Vm.CurrentWeek?.WeekNumber ? "is-current" : "")" id="week-@week.WeekNumber">
                    @if (week.WeekNumber == Vm.CurrentWeek?.WeekNumber)
                    {
                        <span class="fx-now">This week</span>
                    }
                    <FixtureWeekCard Week="week" GalleriesByFixture="Vm.GalleriesByFixture" />
                </section>
            }
        }
        else
        {
            @foreach (var week in Vm.VisibleWeeks)
            {
                <section class="fx-week fx-results-week" id="week-@week.WeekNumber">
                    <div class="fx-week-head">
                        <span class="fx-week-badge">Week @week.WeekNumber</span>
                        <span class="fx-week-dates">@week.DateRange</span>
                    </div>

                    <div class="fx-results">
                        @foreach (var m in week.Matches)
                        {
                            var homeWon = m.HomeScore > m.AwayScore;
                            var awayWon = m.AwayScore > m.HomeScore;
                            <details class="fx-result">
                                <summary>
                                    <span class="fx-team fx-home @(homeWon ? "is-winner" : "")">@m.Home</span>
                                    <span class="fx-score">
                                        <span class="@(homeWon ? "is-winner" : "")">@m.HomeScore</span>
                                        <span class="fx-dash">–</span>
                                        <span class="@(awayWon ? "is-winner" : "")">@m.AwayScore</span>
                                    </span>
                                    <span class="fx-team fx-away @(awayWon ? "is-winner" : "")">@m.Away</span>
                                    <span class="fx-chevron" aria-hidden="true"></span>
                                </summary>

                                <div class="fx-detail">
                                    @if (m.HomeScorers.Any() || m.AwayScorers.Any())
                                    {
                                        <div class="fx-scorers">
                                            <div class="fx-scorers-col fx-home">
                                                @foreach (var sc in m.HomeScorers)
                                                {
                                                    <span class="@(sc.IsOwnGoal ? "is-og" : "")">@FixturesViewModel.Scorer(sc)</span>
                                                }
                                            </div>
                                            <div class="fx-scorers-col fx-away">
                                                @foreach (var sc in m.AwayScorers)
                                                {
                                                    <span class="@(sc.IsOwnGoal ? "is-og" : "")">@FixturesViewModel.Scorer(sc)</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    <div class="fx-meta">
                                        @if (!string.IsNullOrEmpty(m.Day) || !string.IsNullOrEmpty(m.Time))
                                        {
                                            <span>@m.Day@(string.IsNullOrEmpty(m.Time) ? "" : $" · {m.Time}")</span>
                                        }
                                        @if (!string.IsNullOrEmpty(m.Location))
                                        {
                                            <span>@m.Location</span>
                                        }
                                        @if (Vm.GalleriesByFixture.TryGetValue(m.Id, out var galleryId))
                                        {
                                            <a href="/gallery/@galleryId">Match photos →</a>
                                        }
                                    </div>
                                </div>
                            </details>
                        }
                    </div>
                </section>
            }
        }
    </div>

</div>

@code {
    // The schedule and its filters are in FixturesViewModel; scrolling stays here.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Vm.ScrollToCurrent || Vm.IsLoading) return;
        Vm.ScrollToCurrent = false;

        // Bring the strip's current chip into view, so a long season opens on
        // this week rather than week one.
        try { await JS.InvokeVoidAsync("fixturesPage.revealCurrentChip"); }
        catch (JSException) { /* cosmetic */ }
    }

    private async Task OnSeasonChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id)) await Vm.SelectSeason(id);
    }

    private async Task JumpTo(int weekNumber)
        => await JS.InvokeVoidAsync("scrollToId", $"week-{weekNumber}");
}
