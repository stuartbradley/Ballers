@page "/totw"
@using Ballers.Shared
@using Ballers.Services
@inject IJSRuntime JS
@inherits ViewModelComponent<TeamOfTheWeekViewModel>

<PageTitle>Team of the Week — Blackpool Ballers League</PageTitle>

@* Each week's Man of the Match winners, set out on a pitch by position. A
   strip of weeks along the top jumps to any week; the arrows, the arrow keys
   and a swipe across the pitch step through them. *@
<div class="totw-page">

    <PageHero Eyebrow="Ballers League" Title="Team of the Week" Subtitle="The Man of the Match from every game, together on one pitch." />

    <div class="tw-body">
        @if (Vm.Loading)
        {
            <div class="tw-loading"><LoadingSpinner /></div>
        }
        else if (Vm.Weeks.Count == 0 || Vm.Current == null)
        {
            <p class="tw-empty">No Teams of the Week have been published yet.</p>
        }
        else
        {
            <nav class="tw-weeks" aria-label="Match weeks">
                <button type="button" class="tw-arrow" @onclick="Vm.GoOlder"
                        disabled="@(!Vm.CanGoOlder || Vm.Fetching)" aria-label="Previous week">
                    <span aria-hidden="true">‹</span>
                </button>

                <div class="tw-strip" id="tw-strip" role="tablist" aria-label="Choose a week" @onkeydown="OnStripKey">
                    @foreach (var (w, i) in Vm.Chronological)
                    {
                        var active = i == Vm.CurrentIndex;
                        <button type="button" role="tab" class="tw-chip @(active ? "is-active" : "")"
                                aria-selected="@(active ? "true" : "false")"
                                tabindex="@(active ? 0 : -1)"
                                aria-label="@($"Match week {w.MatchNumber}, {w.Date:d MMMM}")"
                                @onclick="() => Vm.Select(i)">
                            <span class="tw-chip-mw">MW@(w.MatchNumber)</span>
                            <span class="tw-chip-date">@w.Date.ToString("d MMM")</span>
                        </button>
                    }
                </div>

                <button type="button" class="tw-arrow" @onclick="Vm.GoNewer"
                        disabled="@(!Vm.CanGoNewer || Vm.Fetching)" aria-label="Next week">
                    <span aria-hidden="true">›</span>
                </button>
            </nav>

            @if (Vm.Current.Summary is { } s)
            {
                <div class="tw-summary">
                    <div class="tw-stat"><strong>@s.Games</strong><span>@(s.Games == 1 ? "Game" : "Games")</span></div>
                    <div class="tw-stat"><strong>@s.Goals</strong><span>Goals</span></div>
                    <div class="tw-stat"><strong>@(s.Games == 0 ? "–" : ((double)s.Goals / s.Games).ToString("0.0"))</strong><span>Goals per game</span></div>
                    <div class="tw-stat tw-stat-wide">
                        @if (s.TopScorerName != null)
                        {
                            <strong>@s.TopScorerName <em>@s.TopScorerGoals</em></strong>
                            <span>Top scorer · @s.TopScorerTeam</span>
                        }
                        else
                        {
                            <strong>—</strong>
                            <span>Top scorer</span>
                        }
                    </div>
                </div>
            }

            @* What the download captures: the title and the pitch. *@
            <section class="tw-poster @(Vm.Fetching ? "is-fetching" : "")" id="tw-poster" aria-label="Team of the Week lineup"
                     @ontouchstart="OnTouchStart" @ontouchend="OnTouchEnd">
                <div class="tw-poster-head">
                    <span class="tw-poster-brand">Ballers League · Team of the Week</span>
                    <span class="tw-poster-week">Match Week <strong>@Vm.Current.MatchNumber</strong></span>
                    <span class="tw-poster-date">@Vm.Current.WeekStart.ToString("dddd d MMMM yyyy")</span>
                </div>

                <div class="tw-pitch" @key="Vm.Current.MatchNumber">
                    <div class="tw-pitch-lines" aria-hidden="true">
                        <span class="tw-box tw-box-top"></span>
                        <span class="tw-halfway"></span>
                        <span class="tw-circle"></span>
                        <span class="tw-box tw-box-bottom"></span>
                    </div>

                    @foreach (var line in Vm.Lines)
                    {
                        <div class="tw-line" aria-label="@line.Name">
                            @foreach (var p in line.Players)
                            {
                                <div class="tw-slot">
                                    <TotwCard Player="p" />
                                    @if (TeamOfTheWeekViewModel.Caption(p) is { } cap)
                                    {
                                        <span class="tw-caption">
                                            <span class="tw-res is-@cap.Code.ToLower()">@cap.Code</span>
                                            @cap.Text
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>

            <div class="tw-actions">
                <span class="tw-hint">Hover or tap a card to see this week against the season.</span>
                <button type="button" class="tw-download" @onclick="Download" disabled="@downloading">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M4 19h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    @(downloading ? "Saving…" : "Download image")
                </button>
            </div>

            @if (Vm.Appearances.Any())
            {
                <section class="tw-apps" aria-labelledby="tw-apps-title">
                    <div class="tw-apps-head">
                        <span class="tw-eyebrow">This season</span>
                        <h2 id="tw-apps-title">Most Team of the Week appearances</h2>
                    </div>
                    <ol class="tw-apps-list">
                        @foreach (var (a, i) in Vm.Appearances.Take(10).Select((a, i) => (a, i)))
                        {
                            <li class="tw-app @(i < 3 ? $"is-top{i + 1}" : "")">
                                <span class="tw-app-rank">@(i + 1)</span>
                                @if (a.Attributes != null && a.Tier != null)
                                {
                                    <span class="tw-mini tw-mini-@a.Tier" title="@($"{a.Tier} card, rated {a.Attributes.Overall}")"><span>@a.Attributes.Overall</span></span>
                                }
                                else
                                {
                                    <span class="tw-mini tw-mini-none" title="No card yet"></span>
                                }
                                <span class="tw-app-who">
                                    <span class="tw-app-name">@a.Name</span>
                                    <span class="tw-app-team">@a.TeamName · @a.Position</span>
                                </span>
                                <span class="tw-app-bar" aria-hidden="true">
                                    <span style="width:@Vm.BarWidth(a.Count)"></span>
                                </span>
                                <span class="tw-app-count">@a.Count<small>@(a.Count == 1 ? "week" : "weeks")</small></span>
                            </li>
                        }
                    </ol>
                </section>
            }
        }
    </div>
</div>

@code {
    // The weeks and stepping between them are in TeamOfTheWeekViewModel; the
    // browser work (the strip's scroll, the poster download, swipes) stays here.

    private bool downloading;

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Vm.CentrePending || Vm.Loading) return;
        Vm.CentrePending = false;
        try { await JS.InvokeVoidAsync("totwPage.centreChip", "tw-strip"); }
        catch (JSException) { /* cosmetic */ }
    }

    private Task OnStripKey(KeyboardEventArgs e) => e.Key switch
    {
        "ArrowLeft" => Vm.GoOlder(),
        "ArrowRight" => Vm.GoNewer(),
        "Home" => Vm.Select(0),
        "End" => Vm.Select(Vm.Weeks.Count - 1),
        _ => Task.CompletedTask
    };

    // A sideways swipe across the pitch changes week; anything mostly
    // vertical is a scroll and is left alone.
    private double touchX, touchY;

    private void OnTouchStart(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return;
        touchX = e.ChangedTouches[0].ClientX;
        touchY = e.ChangedTouches[0].ClientY;
    }

    private Task OnTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return Task.CompletedTask;
        var dx = e.ChangedTouches[0].ClientX - touchX;
        var dy = e.ChangedTouches[0].ClientY - touchY;
        if (Math.Abs(dx) < 60 || Math.Abs(dx) < Math.Abs(dy) * 1.5) return Task.CompletedTask;
        return dx < 0 ? Vm.GoNewer() : Vm.GoOlder();
    }

    private async Task Download()
    {
        if (Vm.Current == null) return;
        downloading = true;
        StateHasChanged();
        try { await JS.InvokeAsync<bool>("totwPage.download", "tw-poster", $"ballers-totw-mw{Vm.Current.MatchNumber}.png"); }
        catch (JSException) { /* the button just comes back */ }
        downloading = false;
    }

    public override void Dispose()
    {
        Vm.StopPrefetch();
        base.Dispose();
    }
}
