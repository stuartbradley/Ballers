@page "/admin/motd"
@inject HttpClient Http
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Admin")]
@inject IJSRuntime JS
@inherits ViewModelComponent<MotdAdminViewModel>

<PageTitle>Match of the Day · Admin</PageTitle>

<AdminShell Section="motd" Title="Match of the Day" Subtitle="Write up a match, with a cover and photos, for the public MOTD page.">
    <ChildContent>
<div class="motda-page">

    <div class="motda-body">

        <!-- Editor -->
        <div class="motda-card">
            <h3>@(Vm.EditingId == null ? "New Post" : "Edit Post")</h3>

            <div class="motda-form">

                <div class="field-group">
                    <label>Match</label>
                    <select @bind="Vm.SelectedFixtureId">
                        <option value="0">— Select a match —</option>
                        @foreach (var opt in Vm.Options)
                        {
                            <option value="@opt.FixtureId">@opt.Label</option>
                        }
                    </select>
                </div>

                <div class="field-group">
                    <label>Cover Photo</label>
                    <div class="motda-cover-row">
                        @if (!string.IsNullOrEmpty(Vm.CoverBase64))
                        {
                            <img class="motda-cover-preview" src="@Vm.CoverBase64" alt="Cover preview" />
                        }
                        else
                        {
                            <div class="motda-cover-placeholder">No cover</div>
                        }
                        <div>
                            <InputFile OnChange="OnCoverSelected" accept="image/*" class="file-input" id="coverInput" />
                            <label for="coverInput" class="motda-upload-btn">@(string.IsNullOrEmpty(Vm.CoverBase64) ? "Choose cover" : "Replace cover")</label>
                        </div>
                    </div>
                </div>

                <div class="field-group">
                    <label>Gallery Photos</label>
                    <InputFile OnChange="OnGallerySelected" accept="image/*" multiple class="file-input" id="galleryInput" />
                    <label for="galleryInput" class="motda-upload-btn">Add photos</label>
                    @if (Vm.GalleryPhotos.Any())
                    {
                        <div class="motda-gallery-grid">
                            @for (var i = 0; i < Vm.GalleryPhotos.Count; i++)
                            {
                                var idx = i;
                                <div class="motda-gallery-thumb">
                                    <img src="@Vm.GalleryPhotos[idx]" alt="Gallery @idx" />
                                    <button type="button" class="motda-thumb-remove" @onclick="() => Vm.RemovePhoto(idx)" title="Remove">✕</button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="field-group">
                    <label>Blog</label>
                    <textarea @bind="Vm.Body" rows="10" placeholder="Write the match report… Separate paragraphs with a blank line."></textarea>
                </div>

                @if (!string.IsNullOrEmpty(Vm.Error))
                {
                    <p class="motda-error">@Vm.Error</p>
                }
                @if (Vm.SavedOk)
                {
                    <p class="motda-success">Saved.</p>
                }

                <div class="motda-actions">
                    <button class="motda-save-btn @(Vm.Saving ? "saving" : "")" @onclick="Vm.Save" disabled="@Vm.Saving">
                        @(Vm.Saving ? "Saving…" : Vm.EditingId == null ? "Publish Post" : "Vm.Save Changes")
                    </button>
                    @if (Vm.EditingId != null)
                    {
                        <button class="motda-cancel-btn" @onclick="Vm.ResetForm">Cancel</button>
                    }
                </div>
            </div>
        </div>

        <!-- Existing posts -->
        <div class="motda-card">
            <h3>Posts</h3>
            @if (Vm.IsLoading)
            {
                <LoadingSpinner />
            }
            else if (!Vm.Posts.Any())
            {
                <p class="motda-empty">No posts yet.</p>
            }
            else
            {
                <div class="motda-list">
                    @foreach (var p in Vm.Posts)
                    {
                        <div class="motda-list-row">
                            <img class="motda-list-thumb" src="@MediaUrls.Absolute(Http, p.CoverImageUrl)" alt="@p.Caption" />
                            <div class="motda-list-info">
                                <p class="motda-list-title">@p.Caption</p>
                                <p class="motda-list-sub">@(p.Date?.ToString("dd MMM yyyy") ?? "No date")</p>
                            </div>
                            <div class="motda-list-actions">
                                <button class="motda-edit-btn" @onclick="() => Vm.StartEdit(p.Id)">Edit</button>
                                <button class="motda-delete-btn" @onclick="() => Delete(p.Id)">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>

</div>
    </ChildContent>
</AdminShell>

@code {
    // The posts and the form are in MotdAdminViewModel; the page confirms a
    // delete before it goes ahead.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    private Task OnCoverSelected(InputFileChangeEventArgs e) => Vm.SetCover(e.File);

    private Task OnGallerySelected(InputFileChangeEventArgs e)
        => Vm.AddGalleryPhotos(e.GetMultipleFiles(maximumFileCount: 30));

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this post?")) return;
        await Vm.Delete(id);
    }
}
