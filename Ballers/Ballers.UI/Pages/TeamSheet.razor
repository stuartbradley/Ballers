@page "/team-sheet/{Id:int}"
@using Ballers.Models
@using Ballers.Services
@using Ballers.Components
@using Ballers.Client.Auth
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inherits ViewModelComponent<TeamSheetViewModel>

<PageTitle>Team Sheet</PageTitle>

<div class="ts-page">

    <div class="ts-toolbar">
        <button class="ts-back" @onclick="@(() => Nav.NavigateTo("/manager-fixtures"))">← Back</button>

        <div class="ts-variant-select">
            <button class="ts-variant-btn @(Vm.Variant == 1 ? "active" : "")" @onclick="() => Vm.Variant = 1">Street</button>
            <button class="ts-variant-btn @(Vm.Variant == 2 ? "active" : "")" @onclick="() => Vm.Variant = 2">Split</button>
            <button class="ts-variant-btn @(Vm.Variant == 4 ? "active" : "")" @onclick="() => Vm.Variant = 4">Graffiti</button>
            <button class="ts-variant-btn @(Vm.Variant == 5 ? "active" : "")" @onclick="() => Vm.Variant = 5">Community</button>
        </div>

        @if (Vm.Fixture != null)
        {
            <button class="ts-download" @onclick="DownloadImage" disabled="@isDownloading">
                @(isDownloading ? "Saving…" : "⬇ Download")
            </button>
        }
    </div>

    @if (Vm.IsLoading)
    {
        <LoadingSpinner />
    }
    else if (Vm.Fixture == null)
    {
        <div class="ts-error">Fixture not found.</div>
    }
    else
    {
        @if (Vm.SquadIsProvisional)
        {
            <div class="ts-notice">
                No squad picked for this fixture yet — showing the full @Vm.SheetTeamName roster.
            </div>
        }

        <div id="poster-capture" class="ts-capture">
            @if (Vm.Variant == 1)
            {
                <TeamSheetClassic Fixture="Vm.Fixture" HomeBadge="@homeBadge" AwayBadge="@awayBadge"
                                  SheetTeamName="@Vm.SheetTeamName" Squad="Vm.Squad" />
            }
            else if (Vm.Variant == 2)
            {
                <TeamSheetSplit Fixture="Vm.Fixture" HomeBadge="@homeBadge" AwayBadge="@awayBadge"
                                SheetTeamName="@Vm.SheetTeamName" Squad="Vm.Squad" />
            }
            else if (Vm.Variant == 3)
            {
                <TeamSheetVintage Fixture="Vm.Fixture" HomeBadge="@homeBadge" AwayBadge="@awayBadge"
                                  SheetTeamName="@Vm.SheetTeamName" Squad="Vm.Squad" />
            }
            else if (Vm.Variant == 4)
            {
                <TeamSheetGraffiti Fixture="Vm.Fixture" HomeBadge="@homeBadge" AwayBadge="@awayBadge"
                                   SheetTeamName="@Vm.SheetTeamName" Squad="Vm.Squad" />
            }
            else
            {
                <TeamSheetCommunity Fixture="Vm.Fixture" HomeBadge="@homeBadge" AwayBadge="@awayBadge"
                                    SheetTeamName="@Vm.SheetTeamName" Squad="Vm.Squad" />
            }
        </div>
    }

</div>

@code {
    // The sheet's data is in TeamSheetViewModel; fitting the names and the
    // download happen in the browser, here.

    [Parameter] public int Id { get; set; }

    private bool isDownloading;

    private string? homeBadge => Abs(Vm.HomeBadgePath);
    private string? awayBadge => Abs(Vm.AwayBadgePath);

    protected override Task OnInitializedAsync() => Vm.LoadAsync(Id);

    // Names are shrunk to fit their column by measuring the rendered text, which
    // can only happen after the poster is in the DOM. Re-runs on every render so
    // switching variant re-fits against that variant's layout.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Vm.Fixture == null) return;
        try
        {
            await JS.InvokeVoidAsync("teamSheetExport.fitNames", "poster-capture");
        }
        catch (JSException)
        {
            // Fitting is cosmetic — never block the page on it.
        }
    }

    private async Task DownloadImage()
    {
        if (Vm.DownloadFileName is not { } filename) return;
        isDownloading = true;
        try
        {
            await JS.InvokeVoidAsync("teamSheetExport.download", "poster-capture", filename);
        }
        finally
        {
            isDownloading = false;
        }
    }

    private string? Abs(string? url)
        => string.IsNullOrEmpty(url) ? null : Http.BaseAddress!.ToString().TrimEnd('/') + url;
}
