@page "/admin/season"
@using Ballers.Models
@using Ballers.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Admin")]
@inherits ViewModelComponent<AdminSeasonViewModel>


<PageTitle>Admin · Season &amp; fixtures</PageTitle>

<AdminShell Section="season" Title="Season & fixtures" Subtitle="Every season, which one is live, and setting up the next.">
    <Actions>
        @if (!Vm.WizardOpen)
        {
            <button type="button" class="adm-btn is-primary" @onclick="Vm.OpenWizard">+ New season</button>
        }
    </Actions>
    <ChildContent>

        @if (Vm.WizardOpen)
        {
            <section class="adm-card" aria-labelledby="wizard-title">
                <div class="adm-card-head">
                    <h2 id="wizard-title">New season</h2>
                    <button type="button" class="adm-btn is-small" @onclick="Vm.CloseWizard">Cancel</button>
                </div>

                <ol class="adm-steps">
                    @foreach (var (label, i) in AdminSeasonViewModel.StepLabels.Select((l, i) => (l, i)))
                    {
                        <li class="@(i < Vm.Step ? "is-done" : i == Vm.Step ? "is-current" : "")">@label</li>
                    }
                </ol>

                @switch (Vm.Step)
                {
                    case 0:
                        <div class="adm-choices">
                            <button type="button" class="adm-choice @(Vm.Method == "generate" ? "is-active" : "")" @onclick='() => Vm.Method = "generate"'>
                                <strong>Generate</strong>
                                Pick the teams and a start date; the fixtures are drawn up for you, home and away.
                            </button>
                            <button type="button" class="adm-choice @(Vm.Method == "import" ? "is-active" : "")" @onclick='() => Vm.Method = "import"'>
                                <strong>Import a CSV</strong>
                                Upload a fixture list you've drawn up yourself, with dates, venues and referees.
                            </button>
                        </div>
                        break;

                    case 1 when Vm.Method == "generate":
                        <label class="adm-field" style="max-width:260px">
                            <span>First match week starts</span>
                            <InputDate @bind-Value="Vm.GenStart" />
                        </label>

                        <div class="adm-toolbar" style="margin-bottom:8px">
                            <span class="adm-label">Teams (@Vm.GenTeams.Count of @Vm.Teams.Count)</span>
                            <div class="adm-chips">
                                <button type="button" class="adm-chip" @onclick="Vm.SelectAllTeams">Select all</button>
                                <button type="button" class="adm-chip" @onclick="() => Vm.GenTeams.Clear()">Clear</button>
                            </div>
                        </div>
                        <div class="adm-check-grid">
                            @foreach (var t in Vm.Teams.OrderBy(t => t.Name))
                            {
                                <label class="adm-check">
                                    <input type="checkbox" checked="@Vm.GenTeams.Contains(t.Id)"
                                           @onchange="e => Vm.ToggleTeam(t.Id, (bool)e.Value!)" />
                                    @t.Name
                                </label>
                            }
                        </div>
                        @if (Vm.GenTeams.Count >= 3 && Vm.GenTeams.Count % 2 != 0)
                        {
                            <div class="adm-msg is-info">An odd number of teams: one team sits out each round.</div>
                        }
                        break;

                    case 1:
                        <p class="adm-help" style="margin:0 0 14px">
                            Columns: <code>MatchNumber, HomeTeam, AwayTeam, Kickoff, Location, Postcode, Referee</code>.
                            Team and referee names must match exactly; kickoff as <code>yyyy-MM-dd HH:mm</code>.
                            <a href="/fixtures-template.csv" download>Download the template</a>.
                        </p>
                        <div class="adm-field-row">
                            <label class="adm-field">
                                <span>Season number</span>
                                <input type="number" min="1" @bind="Vm.ImportNumber" />
                            </label>
                            <label class="adm-field">
                                <span>Season starts</span>
                                <InputDate @bind-Value="Vm.ImportStart" />
                            </label>
                        </div>
                        <label class="adm-check" style="max-width:320px;margin-bottom:14px">
                            <input type="checkbox" checked="@Vm.ImportActive" @onchange="e => Vm.ImportActive = (bool)e.Value!" />
                            Make it the active season straight away
                        </label>
                        <div class="adm-field">
                            <span>Fixture file</span>
                            <InputFile id="csvInput" OnChange="OnFile" accept=".csv" style="display:none" />
                            <label for="csvInput" class="adm-btn" style="align-self:flex-start">@(Vm.ImportFile?.Name ?? "Choose CSV file…")</label>
                        </div>
                        @if (Vm.ImportPreview != null)
                        {
                            <span class="adm-help">@Vm.ImportRows fixture row(s) found. First lines:</span>
                            <pre class="adm-pre">@Vm.ImportPreview</pre>
                        }
                        break;

                    default:
                        <dl class="adm-review">
                            @if (Vm.Method == "generate")
                            {
                                var n = Vm.GenTeams.Count;
                                var rounds = (n % 2 == 0 ? n - 1 : n) * 2;
                                <dt>Method</dt><dd>Generate, home and away</dd>
                                <dt>Season</dt><dd>Season @Vm.NextSeasonNumber (not active until you activate it)</dd>
                                <dt>Teams</dt><dd>@n: @string.Join(", ", Vm.Teams.Where(t => Vm.GenTeams.Contains(t.Id)).OrderBy(t => t.Name).Select(t => t.Name))</dd>
                                <dt>Rounds</dt><dd>@rounds, one every two weeks</dd>
                                <dt>Runs</dt><dd>@Vm.GenStart.ToString("d MMM yyyy") – @Vm.GenStart.AddDays(rounds * 14).ToString("d MMM yyyy")</dd>
                            }
                            else
                            {
                                <dt>Method</dt><dd>Import a CSV</dd>
                                <dt>Season</dt><dd>Season @Vm.ImportNumber@(Vm.ImportActive ? ", made active" : "")</dd>
                                <dt>Starts</dt><dd>@Vm.ImportStart.ToString("d MMM yyyy")</dd>
                                <dt>File</dt><dd>@Vm.ImportFile?.Name (@Vm.ImportRows rows)</dd>
                            }
                        </dl>
                        break;
                }

                @if (Vm.WizardMessage != null)
                {
                    <div class="adm-msg @(Vm.WizardIsError ? "is-error" : "is-ok")">
                        @Vm.WizardMessage
                        @if (Vm.ImportErrors.Any())
                        {
                            <ul>@foreach (var e in Vm.ImportErrors) { <li>@e</li> }</ul>
                        }
                    </div>
                }

                <div class="adm-wizard-foot">
                    <button type="button" class="adm-btn" disabled="@(Vm.Step == 0 || Vm.Creating)" @onclick="() => Vm.Step--">‹ Back</button>
                    @if (Vm.Step < 2)
                    {
                        <button type="button" class="adm-btn is-primary" disabled="@(!Vm.CanContinue)" @onclick="() => Vm.Step++">Next ›</button>
                    }
                    else
                    {
                        <button type="button" class="adm-btn is-primary" disabled="@Vm.Creating" @onclick="Vm.Create">
                            @(Vm.Creating ? "Creating…" : "Vm.Create season")
                        </button>
                    }
                </div>
            </section>
        }

        <section class="adm-card" aria-labelledby="seasons-title">
            <div class="adm-card-head">
                <h2 id="seasons-title">Seasons</h2>
            </div>

            @if (Vm.Loading)
            {
                <LoadingSpinner />
            }
            else if (!Vm.Seasons.Any())
            {
                <p class="adm-empty">No seasons yet. Start one with <strong>New season</strong>.</p>
            }
            else
            {
                <div class="adm-rows">
                    @foreach (var s in Vm.Seasons.OrderByDescending(x => x.SeasonNumber))
                    {
                        <div class="adm-row">
                            <span class="adm-dot @(s.IsActive ? "is-green" : "")">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v13H4zM8 3v6m8-6v6M4 11h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                            </span>
                            <span class="adm-row-main">
                                <span class="adm-row-title">
                                    Season @s.SeasonNumber
                                    @if (s.IsActive) { <span class="adm-badge is-green">Active</span> }
                                    @if (s.IsKnockoutGenerated) { <span class="adm-badge is-blue">Knockout drawn</span> }
                                </span>
                                <span class="adm-row-sub">@s.StartDate.ToString("d MMM yyyy") – @s.EndDate.ToString("d MMM yyyy")</span>
                            </span>
                            <span class="adm-row-end">
                                @if (!s.IsActive)
                                {
                                    <button type="button" class="adm-btn is-small" @onclick="() => Activate(s)">Make active</button>
                                }
                                @if (s.IsKnockoutGenerated)
                                {
                                    <a class="adm-btn is-small" href="/knockout">View knockout</a>
                                }
                                else
                                {
                                    <button type="button" class="adm-btn is-small" @onclick="() => DrawKnockout(s)">Draw knockout</button>
                                }
                            </span>
                        </div>
                    }
                </div>
            }

            @if (Vm.SeasonMessage != null)
            {
                <div class="adm-msg @(Vm.SeasonIsError ? "is-error" : "is-ok")">@Vm.SeasonMessage</div>
            }
        </section>

        @if (Vm.Seasons.Any())
        {
            <section class="adm-card adm-danger" aria-labelledby="danger-title">
                <div class="adm-card-head">
                    <div>
                        <h2 id="danger-title">Danger zone</h2>
                        <p class="adm-card-sub">Deleting a season removes all its fixtures, results, stats and knockout games for good.</p>
                    </div>
                </div>
                <div class="adm-toolbar" style="margin:0;justify-content:flex-start">
                    <select class="adm-input" style="max-width:200px" @bind="Vm.DeleteId">
                        <option value="0">Choose a season…</option>
                        @foreach (var s in Vm.Seasons.OrderByDescending(x => x.SeasonNumber))
                        {
                            <option value="@s.Id">Season @s.SeasonNumber@(s.IsActive ? " (active)" : "")</option>
                        }
                    </select>
                    <button type="button" class="adm-btn is-danger" disabled="@(Vm.DeleteId == 0)" @onclick="Delete">Delete season</button>
                </div>
            </section>
        }

        <AdminConfirm @ref="confirm" />
    </ChildContent>
</AdminShell>

@code {
    // The wizard and season actions are in AdminSeasonViewModel; the page asks
    // for confirmation before each season action.

    private AdminConfirm confirm = default!;

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    private Task OnFile(InputFileChangeEventArgs e) => Vm.SelectImportFile(e.File);

    private async Task Activate(SeasonDto s)
    {
        var active = Vm.ActiveSeason;
        var ok = await confirm.Ask($"Make Season {s.SeasonNumber} active?",
            active != null
                ? $"Season {active.SeasonNumber} stops being the live season. The public pages, table and stats switch to Season {s.SeasonNumber}."
                : $"The public pages, table and stats will show Season {s.SeasonNumber}.",
            "Make active");
        if (ok) await Vm.ActivateSeason(s);
    }

    private async Task DrawKnockout(SeasonDto s)
    {
        var ok = await confirm.Ask($"Draw the Season {s.SeasonNumber} knockout?",
            "The semi-finals are drawn from the current league table, so it needs at least 8 teams. It can't be redrawn afterwards.",
            "Draw knockout");
        if (ok) await Vm.DrawKnockout(s);
    }

    private async Task Delete()
    {
        if (Vm.SeasonToDelete is not { } s) return;

        var ok = await confirm.Ask($"Delete Season {s.SeasonNumber}?",
            $"This permanently removes every fixture, result, stat and knockout game in Season {s.SeasonNumber}. It can't be undone.",
            "Delete for good", danger: true, typeToConfirm: s.SeasonNumber.ToString());
        if (ok) await Vm.DeleteSeason(s);
    }
}
