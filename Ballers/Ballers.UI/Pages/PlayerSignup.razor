@page "/signup"
@using Ballers.Models
@using Ballers.Services
@using Ballers.Shared
@inject NavigationManager Nav
@inherits ViewModelComponent<PlayerSignupViewModel>

<PageTitle>Player Sign-up</PageTitle>

<div class="signup-page">
    <div class="signup-card">
        @if (Vm.Submitted)
        {
            <h1>Request sent</h1>
            <p class="signup-intro">
                Your account is waiting for @(Vm.TeamName ?? "your team")'s manager to approve it.
                Once they do, log in and you'll have 80 points to put on your card.
            </p>
            <a class="signup-btn" href="/login">Go to login</a>
        }
        else
        {
            <h1>Player Sign-up</h1>
            <p class="signup-intro">
                Create your account, claim your squad place, and build your card.
                Your manager approves it before you get started.
            </p>

            <div class="form-group">
                <label>Your team</label>
                <select @onchange="OnTeamChanged">
                    <option value="">Choose a team…</option>
                    @foreach (var team in Vm.Teams)
                    {
                        <option value="@team.Id" selected="@(team.Id == Vm.TeamId)">@team.Name</option>
                    }
                </select>
            </div>

            @if (Vm.TeamId != null)
            {
                <div class="form-group">
                    <label>Which player are you?</label>
                    @if (Vm.LoadingSquad)
                    {
                        <p class="signup-hint">Loading the squad…</p>
                    }
                    else
                    {
                        <select @onchange="OnPlayerChanged">
                            <option value="">I'm not on the list yet</option>
                            @foreach (var player in Vm.Squad)
                            {
                                <option value="@player.Id" disabled="@(!player.IsClaimable)">
                                    @player.Number. @player.Name @(player.IsClaimable ? "" : "(already claimed)")
                                </option>
                            }
                        </select>
                        <p class="signup-hint">
                            Pick yourself from your manager's squad list. If you're not there
                            yet, leave this as it is and your manager will add you.
                        </p>
                    }
                </div>
            }

            <div class="form-group">
                <label>Your name</label>
                <input @bind="Vm.Name" @bind:event="oninput" placeholder="Alex Smith" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input @bind="Vm.Email" @bind:event="oninput" placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" @bind="Vm.Password" @bind:event="oninput" />
                <p class="signup-hint">
                    At least 6 characters, with an upper and lower case letter, a number
                    and a symbol.
                </p>
            </div>

            <div class="form-group">
                <label>Confirm password</label>
                <input type="password" @bind="Vm.ConfirmPassword" @bind:event="oninput" />
            </div>

            @if (Vm.Error != null)
            {
                <div class="signup-error">@Vm.Error</div>
            }

            <button class="signup-btn" disabled="@Vm.Saving" @onclick="Vm.Submit">
                @(Vm.Saving ? "Sending…" : "Create account")
            </button>

            <div class="signup-footer">
                Already have an account? <a href="/login">Log in</a>
            </div>
        }
    </div>
</div>

@code {
    // The form and its rules are in PlayerSignupViewModel.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    private Task OnTeamChanged(ChangeEventArgs e)
        => Vm.SelectTeam(int.TryParse(e.Value?.ToString(), out var id) ? id : null);

    private void OnPlayerChanged(ChangeEventArgs e)
        => Vm.SelectPlayer(int.TryParse(e.Value?.ToString(), out var id) ? id : null);
}
