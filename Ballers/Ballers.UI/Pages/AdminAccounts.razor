@page "/admin/accounts"
@using Ballers.Models
@using Ballers.Services
@using Ballers.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Admin")]
@inherits ViewModelComponent<AdminAccountsViewModel>


<PageTitle>Admin · Accounts</PageTitle>

@* Every login in the league, by role, with the means to add one, reset a
   password, or remove one. Removing a login never removes a team or player. *@
<AdminShell Section="accounts" Title="Accounts" Subtitle="Every login: managers, referees, admins and players.">
    <Actions>
        <button type="button" class="adm-btn is-primary" @onclick="() => Vm.ShowCreate = !Vm.ShowCreate">
            @(Vm.ShowCreate ? "Close" : "+ New account")
        </button>
    </Actions>
    <ChildContent>

        @if (Vm.ShowCreate)
        {
            <section class="adm-card" aria-labelledby="create-title">
                <div class="adm-card-head"><h2 id="create-title">New account</h2></div>

                <div class="adm-choices">
                    @foreach (var (type, label, help) in AdminAccountsViewModel.AccountTypes)
                    {
                        <button type="button" class="adm-choice @(Vm.Model.AccountType == type ? "is-active" : "")" @onclick="() => Vm.SetType(type)">
                            <strong>@label</strong>
                            @help
                        </button>
                    }
                </div>

                <EditForm EditContext="Vm.EditContext" OnValidSubmit="Vm.Create">
                    <DataAnnotationsValidator />
                    <div class="adm-field-row">
                        @if (Vm.Model.IsTeam)
                        {
                            <label class="adm-field">
                                <span>Team name</span>
                                <InputText @bind-Value="Vm.Model.TeamName" />
                                <ValidationMessage For="() => Vm.Model.TeamName" />
                            </label>
                        }
                        <label class="adm-field">
                            <span>@(Vm.Model.IsTeam ? "Manager's email" : "Email")</span>
                            <InputText type="email" @bind-Value="Vm.Model.Email" autocomplete="off" />
                            <ValidationMessage For="() => Vm.Model.Email" />
                        </label>
                        <label class="adm-field">
                            <span>Starting password</span>
                            <InputText type="text" @bind-Value="Vm.Model.Password" autocomplete="new-password" />
                            <ValidationMessage For="() => Vm.Model.Password" />
                        </label>
                    </div>
                    <p class="adm-help" style="margin:-4px 0 14px">
                        Upper and lower case, a number and a symbol. Send it to them; they can change it from Change Password.
                    </p>
                    @if (Vm.Model.IsAdmin)
                    {
                        <div class="adm-msg is-info" style="margin:0 0 14px">
                            Admins can do everything here, including removing other accounts and deleting seasons. Only for people you trust.
                        </div>
                    }
                    <button type="submit" class="adm-btn is-primary" disabled="@Vm.Creating">
                        @(Vm.Creating ? "Creating…" : $"Vm.Create {AdminAccountsViewModel.TypeLabel(Vm.Model.AccountType).ToLower()}")
                    </button>
                </EditForm>

                @if (Vm.CreateMessage != null)
                {
                    <div class="adm-msg @(Vm.CreateIsError ? "is-error" : "is-ok")">@Vm.CreateMessage</div>
                }
            </section>
        }

        <section class="adm-card" aria-label="All accounts">
            @if (Vm.Accounts == null)
            {
                @if (Vm.Loading)
                {
                    <LoadingSpinner />
                }
                else
                {
                    <div class="adm-msg is-error">The account list couldn't be loaded. If the API has just been updated it may need restarting.</div>
                }
            }
            else
            {
                <div class="adm-toolbar">
                    <div class="adm-chips" role="group" aria-label="Filter by role">
                        @foreach (var r in AdminAccountsViewModel.RoleFilters)
                        {
                            var count = r == "All" ? Vm.Accounts.Count : Vm.Accounts.Count(a => a.Role == r);
                            @if (r == "All" || count > 0)
                            {
                                <button type="button" class="adm-chip @(Vm.Role == r ? "is-active" : "")"
                                        aria-pressed="@(Vm.Role == r ? "true" : "false")" @onclick="() => Vm.Role = r">
                                    @AdminAccountsViewModel.RoleLabel(r)<small>@count</small>
                                </button>
                            }
                        }
                    </div>
                    <input class="adm-input" type="search" placeholder="Search email, team or player…" aria-label="Search accounts"
                           @bind="Vm.Search" @bind:event="oninput" />
                </div>

                @if (!Vm.Filtered.Any())
                {
                    <p class="adm-empty">No accounts match.</p>
                }
                else
                {
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Team / player</th>
                                    <th><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Vm.Filtered)
                                {
                                    <tr>
                                        <td class="adm-strong">
                                            @a.Email
                                            @if (a.IsYou) { <span class="adm-badge">You</span> }
                                            @if (a.LockedOut) { <span class="adm-badge is-red">Locked out</span> }
                                        </td>
                                        <td><span class="adm-badge @AdminAccountsViewModel.RoleTone(a.Role)">@AdminAccountsViewModel.RoleLabel(a.Role)</span></td>
                                        <td>
                                            @if (a.PlayerName != null)
                                            {
                                                @a.PlayerName<span class="adm-muted">@(a.TeamName != null ? $" · {a.TeamName}" : "")</span>
                                            }
                                            else
                                            {
                                                @(a.TeamName ?? "—")
                                            }
                                        </td>
                                        <td class="adm-actions">
                                            <button type="button" class="adm-btn is-small" @onclick="() => Vm.StartReset(a)">Reset password</button>
                                            @if (!a.IsYou)
                                            {
                                                <button type="button" class="adm-btn is-small is-danger" @onclick="() => Remove(a)">Remove</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (Vm.ListMessage != null)
                {
                    <div class="adm-msg @(Vm.ListIsError ? "is-error" : "is-ok")">@Vm.ListMessage</div>
                }
            }
        </section>

        @if (Vm.Resetting != null)
        {
            <div class="adm-dialog-back" @onclick="() => Vm.Resetting = null">
                <div class="adm-dialog" role="dialog" aria-modal="true" aria-labelledby="reset-title" @onclick:stopPropagation>
                    <h2 id="reset-title">Reset password</h2>
                    <p>Set a new password for <strong>@Vm.Resetting.Email</strong>. Their old one stops working straight away, and a lockout is cleared.</p>
                    <label class="adm-field">
                        <span>New password</span>
                        <input class="adm-input" type="text" @bind="Vm.NewPassword" @bind:event="oninput" autocomplete="new-password" />
                    </label>
                    <p class="adm-help" style="margin-top:-6px">At least 6 characters, with upper and lower case, a number and a symbol.</p>
                    @if (Vm.ResetError != null)
                    {
                        <div class="adm-msg is-error" style="margin:0 0 12px">@Vm.ResetError</div>
                    }
                    <div class="adm-dialog-foot">
                        <button type="button" class="adm-btn" @onclick="() => Vm.Resetting = null">Cancel</button>
                        <button type="button" class="adm-btn is-primary" disabled="@(Vm.NewPassword.Length < 6 || Vm.SavingReset)" @onclick="Vm.SaveReset">
                            @(Vm.SavingReset ? "Saving…" : "Set password")
                        </button>
                    </div>
                </div>
            </div>
        }

        <AdminConfirm @ref="confirm" />
    </ChildContent>
</AdminShell>

@code {
    // The accounts and their actions are in AdminAccountsViewModel; the page
    // confirms a removal before it goes ahead.

    [Parameter, SupplyParameterFromQuery(Name = "role")] public string? RoleQuery { get; set; }

    private AdminConfirm confirm = default!;

    protected override Task OnInitializedAsync() => Vm.InitializeAsync(RoleQuery);

    private async Task Remove(AdminAccountDto a)
    {
        var ok = await confirm.Ask($"Remove {a.Email}?",
            $"This deletes the login. {AdminAccountsViewModel.RemovalConsequence(a)}", "Remove", danger: true);
        if (ok) await Vm.RemoveAccount(a);
    }
}
