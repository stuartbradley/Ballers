@page "/admin/settings"
@using Ballers.Client.Services
@using Ballers.Services
@using Ballers.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inherits ViewModelComponent<AdminSettingsViewModel>


<PageTitle>Admin · Settings</PageTitle>

@* The league's on/off switches and which notifications go out. Each switch
   saves as soon as it's flipped. *@
<AdminShell Section="settings" Title="Settings" Subtitle="League switches and notifications. Changes save as soon as you flip them.">
    <ChildContent>
        @if (!Vm.Loaded)
        {
            <LoadingSpinner />
        }
        else
        {
            <div class="adm-grid">
                <section class="adm-card" aria-labelledby="league-title">
                    <div class="adm-card-head"><h2 id="league-title">League</h2></div>
                    <div class="adm-rows">
                        @Switch("Lock player registration",
                                "Managers can no longer add players to their squads. Admins still can.",
                                Vm.PlayersLocked, "Locked", "Open", Vm.SetPlayersLocked)
                        @Switch("Lock fixtures",
                                "Managers and referees can no longer submit stats or edit fixtures. Admins still can.",
                                Vm.FixturesLocked, "Locked", "Open", Vm.SetFixturesLocked)
                        @Switch("Hide fixtures from the public",
                                "The public Fixtures page and home page show none, so a season can be loaded and revealed later. Admins and referees still see them.",
                                Vm.FixturesHidden, "Hidden", "Visible", Vm.SetFixturesHidden)
                    </div>
                    @if (Vm.LeagueMessage != null)
                    {
                        <div class="adm-msg @(Vm.LeagueIsError ? "is-error" : "is-ok")">@Vm.LeagueMessage</div>
                    }
                </section>

                <section class="adm-card" aria-labelledby="notif-title">
                    <div class="adm-card-head">
                        <div>
                            <h2 id="notif-title">Notifications</h2>
                            <p class="adm-card-sub">Alerts in the bell for managers and referees.</p>
                        </div>
                    </div>
                    @if (!Vm.Notifications.Any())
                    {
                        <p class="adm-empty">No notification types found.</p>
                    }
                    else
                    {
                        <div class="adm-rows">
                            @foreach (var n in Vm.Notifications)
                            {
                                @Switch(n.DisplayName, n.Description, n.IsEnabled, "On", "Off", on => Vm.SetNotification(n, on))
                            }
                        </div>
                    }
                    @if (Vm.NotifMessage != null)
                    {
                        <div class="adm-msg is-error">@Vm.NotifMessage</div>
                    }
                </section>
            </div>
        }
    </ChildContent>
</AdminShell>

@code {
    // The settings and their switches are in AdminSettingsViewModel.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    private RenderFragment Switch(string title, string help, bool on, string onText, string offText, Func<bool, Task> set) =>
        @<div class="adm-row">
            <span class="adm-row-main">
                <span class="adm-row-title">@title</span>
                <span class="adm-row-sub">@help</span>
            </span>
            <label class="adm-switch">
                <input type="checkbox" role="switch" checked="@on" aria-label="@title"
                       @onchange="e => set((bool)e.Value!)" />
                <span></span>
                <em>@(on ? onText : offText)</em>
            </label>
        </div>;
}
