@page "/knockout"
@using Ballers.Models
@using Ballers.Services
@using Ballers.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inherits ViewModelComponent<KnockoutViewModel>

<PageTitle>Knockout</PageTitle>

<div class="knockout-page">

    <div class="knockout-hero">
        <div class="knockout-hero-inner">
            <p class="knockout-eyebrow">Ballers League</p>
            <h1>Knockout Stage</h1>
            @if (Vm.Bracket != null && Vm.Bracket.Generated)
            {
                <p class="knockout-sub">Season @Vm.Bracket.SeasonNumber</p>
            }
        </div>
    </div>

    <div class="knockout-body">
        @if (Vm.IsLoading)
        {
            <LoadingSpinner />
        }
        else if (Vm.Bracket == null || !Vm.Bracket.Generated)
        {
            <div class="knockout-pending">
                <div class="pending-icon">&#x1F3C6;</div>
                <h2>Knockout Stage Not Yet Started</h2>
                <p>The bracket will appear once the regular season concludes.</p>

                @if (Vm.IsAdmin)
                {
                    <div class="admin-generate">
                        <p class="generate-hint">Generate the bracket from the current standings.</p>
                        <button class="generate-btn" @onclick="Vm.GenerateKnockout" disabled="@Vm.IsGenerating">
                            @(Vm.IsGenerating ? "Generating..." : "Generate Knockout Bracket")
                        </button>
                        @if (!string.IsNullOrEmpty(Vm.GenerateMessage))
                        {
                            <div class="@(Vm.GenerateIsError ? "ko-error" : "ko-success")">@Vm.GenerateMessage</div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Vm.ResultMessage))
            {
                <div class="@(Vm.ResultIsError ? "ko-error" : "ko-success") result-toast">@Vm.ResultMessage</div>
            }

            <div class="tournaments">

                <div class="tournament-section">
                    <div class="tournament-header">
                        <span class="tournament-badge cup-badge">Cup</span>
                        <div class="tournament-title-block">
                            <h2>Cup</h2>
                            <p>Top 4 teams · 1st plays 4th, 2nd plays 3rd</p>
                        </div>
                    </div>
                    <div class="bracket">
                        <div class="bracket-col semis-col">
                            <span class="round-label">Semi-Finals</span>
                            @foreach (var sf in Vm.GetSemifinals("Cup"))
                            {
                                <KnockoutMatchCard Fixture="sf" IsAdmin="Vm.IsAdmin" UserTeamId="Vm.UserTeamId" OnResultSubmit="Vm.HandleResultSubmit" />
                            }
                        </div>
                        <div class="bracket-arrows">
                            <div class="arrow-line top-arrow"></div>
                            <div class="arrow-line bot-arrow"></div>
                        </div>
                        <div class="bracket-col final-col">
                            <span class="round-label">Final</span>
                            @{ var cupFinal = Vm.GetFinal("Cup"); }
                            @if (cupFinal != null)
                            {
                                <KnockoutMatchCard Fixture="cupFinal" IsAdmin="Vm.IsAdmin" IsFinal="true" UserTeamId="Vm.UserTeamId" OnResultSubmit="Vm.HandleResultSubmit" />
                            }
                        </div>
                    </div>
                    @{ var cupWinner = Vm.GetWinner("Cup"); }
                    @if (cupWinner != null)
                    {
                        <div class="tournament-winner cup-winner">
                            <span class="winner-trophy">&#x1F3C6;</span>
                            <div class="winner-text">
                                <span class="winner-label">Cup Winners</span>
                                <span class="winner-name">@cupWinner</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="tournament-section">
                    <div class="tournament-header">
                        <span class="tournament-badge plate-badge">Plate</span>
                        <div class="tournament-title-block">
                            <h2>Plate</h2>
                            <p>Bottom 4 teams · 5th plays 8th, 6th plays 7th</p>
                        </div>
                    </div>
                    <div class="bracket">
                        <div class="bracket-col semis-col">
                            <span class="round-label">Semi-Finals</span>
                            @foreach (var sf in Vm.GetSemifinals("Plate"))
                            {
                                <KnockoutMatchCard Fixture="sf" IsAdmin="Vm.IsAdmin" UserTeamId="Vm.UserTeamId" OnResultSubmit="Vm.HandleResultSubmit" />
                            }
                        </div>
                        <div class="bracket-arrows">
                            <div class="arrow-line top-arrow"></div>
                            <div class="arrow-line bot-arrow"></div>
                        </div>
                        <div class="bracket-col final-col">
                            <span class="round-label">Final</span>
                            @{ var plateFinal = Vm.GetFinal("Plate"); }
                            @if (plateFinal != null)
                            {
                                <KnockoutMatchCard Fixture="plateFinal" IsAdmin="Vm.IsAdmin" IsFinal="true" UserTeamId="Vm.UserTeamId" OnResultSubmit="Vm.HandleResultSubmit" />
                            }
                        </div>
                    </div>
                    @{ var plateWinner = Vm.GetWinner("Plate"); }
                    @if (plateWinner != null)
                    {
                        <div class="tournament-winner plate-winner">
                            <span class="winner-trophy">&#x1F947;</span>
                            <div class="winner-text">
                                <span class="winner-label">Plate Winners</span>
                                <span class="winner-name">@plateWinner</span>
                            </div>
                        </div>
                    }
                </div>

            </div>
        }
    </div>
</div>

@code {
    // The bracket and its admin actions are in KnockoutViewModel.

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();
}
