@page "/change-password"
@using Ballers.Client.Auth
@using Ballers.Client.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Change Password</PageTitle>

<div class="login-page">

    <div class="login-left">
        <div class="login-card">

            <h1>Change Password</h1>
            <p class="subtitle">Update your account password</p>

            @if (success)
            {
                <div class="login-error" style="background:#d4edda;color:#155724;border-color:#c3e6cb;">
                    Password changed successfully.
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Current Password</label>
                    <input type="password" @bind="currentPassword" />
                </div>

                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" @bind="newPassword" />
                </div>

                <div class="form-group">
                    <label>Confirm New Password</label>
                    <input type="password" @bind="confirmPassword" @onkeydown="OnKeyDown" />
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="login-error">@error</div>
                }

                <button class="login-btn" @onclick="HandleSubmit" disabled="@busy">
                    @(busy ? "Saving..." : "Change Password")
                </button>
            }

            <div style="margin-top:1rem;text-align:center;">
                <a href="/dashboard">Back to Dashboard</a>
            </div>

        </div>
    </div>

    <div class="login-right">
        <div class="login-right-bg"></div>
        <div class="branding">
            <div class="brand-wordmark">
                <span class="brand-the">Blackpool</span>
                <span class="brand-name">Ballers</span>
                <span class="brand-league">League</span>
            </div>
            <p class="brand-tagline">Blackpool's Premier 11-a-Side Competition</p>
        </div>
    </div>

</div>

@code {
    string? currentPassword;
    string? newPassword;
    string? confirmPassword;
    string? error;
    bool busy;
    bool success;

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSubmit();
    }

    async Task HandleSubmit()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(currentPassword) ||
            string.IsNullOrWhiteSpace(newPassword) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            error = "All fields are required.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            error = "New passwords do not match.";
            return;
        }

        busy = true;
        var (ok, err) = await Auth.ChangePassword(new ChangePasswordRequest
        {
            CurrentPassword = currentPassword,
            NewPassword = newPassword
        });
        busy = false;

        if (ok)
            success = true;
        else
            error = err;
    }
}
