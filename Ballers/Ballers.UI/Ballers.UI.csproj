
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ballers</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorCacheBootResources>false</BlazorCacheBootResources>
    <!-- Fallback when git/tags aren't available at build time -->
    <Version>1.0.1</Version>
    <InformationalVersion>1.0.1</InformationalVersion>
  </PropertyGroup>

  <!-- Derive the version from the latest git tag (e.g. v1.0.2 -> 1.0.2).
       Runs before the assembly attributes are generated; falls back to the
       hardcoded version above if git isn't present (e.g. building from a
       source archive on the server). -->
  <Target Name="SetVersionFromGitTag" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;BeforeBuild">
    <Exec Command="git describe --tags --abbrev=0"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitTag" />
    </Exec>
    <PropertyGroup Condition="'$(_GitTag)' != ''">
      <_TagVersion>$(_GitTag.Trim().TrimStart('v'))</_TagVersion>
      <!-- Empty when git failed (e.g. "fatal: No names found") so we never clobber the fallback Version. -->
      <_MatchedVersion>$([System.Text.RegularExpressions.Regex]::Match($(_TagVersion), '^[0-9]+(\.[0-9]+){0,3}').Value)</_MatchedVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_MatchedVersion)' != ''">
      <Version>$(_MatchedVersion)</Version>
      <AssemblyVersion>$(Version)</AssemblyVersion>
      <FileVersion>$(Version)</FileVersion>
      <InformationalVersion>$(_TagVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.24" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ballers.Shared\Ballers.Shared.csproj" />
  </ItemGroup>

</Project>
