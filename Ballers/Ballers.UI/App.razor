@using Microsoft.AspNetCore.Components.Authorization
<CascadingAuthenticationState>

    <Router AppAssembly="@typeof(App).Assembly">

        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData"
                                DefaultLayout="@typeof(MainLayout)">
                <Authorizing />
                <NotAuthorized>
                    @* A signed-in account that simply lacks the role — a player on
                       a manager's page, say — is told so instead of being left on
                       a blank screen. Anonymous visitors are deliberately left as
                       they were: redirecting them is a site-wide change this
                       feature has no business making. *@
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <PageTitle>No Access</PageTitle>
                        <div class="not-found-container">
                            <h2 class="not-found-title">No Access</h2>
                            <p class="not-found-text">This page isn't available to your account.</p>
                            <a href="/" class="not-found-btn">Back to Home</a>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>

        <Navigating />

        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <PageTitle>404 Not Found</PageTitle>
                <div class="not-found-container">
                    <div class="not-found-code">404</div>
                    <h2 class="not-found-title">Page Not Found</h2>
                    <p class="not-found-text">The page you're looking for doesn't exist.</p>
                    <a href="/" class="not-found-btn">Back to Home</a>
                </div>
            </LayoutView>
        </NotFound>

    </Router>

</CascadingAuthenticationState>